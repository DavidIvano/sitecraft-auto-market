---
import type { CarListingStatus } from "../lib/types";
import { DEFAULT_LOCALE, type Locale } from "../i18n/locales";
import { getDetailMessages } from "../i18n/detailMessages";

type Props = {
  status: CarListingStatus;
  locale?: Locale;
};

const { status, locale = DEFAULT_LOCALE } = Astro.props;
const messages = getDetailMessages(locale);
const statusLabels: Record<CarListingStatus, string> = {
  draft: messages.statusDraft, ai_draft: messages.statusAiDraft, ready_for_review: messages.statusReady,
  pending_review: messages.statusPending, approved: messages.statusApproved, published: messages.statusPublished,
  rejected: messages.statusRejected, needs_fix: messages.statusNeedsFix, archived: messages.statusArchived,
  blocked: messages.statusBlocked, deleted: messages.statusDeleted, sold: messages.statusSold,
};
---

<span class={`status-badge status-${status}`}>{statusLabels[status]}</span>
