---
import type { Locale } from "../i18n/locales";
import { getLocaleFromPath } from "../i18n/locale";
import { getMessages } from "../i18n/messages";
import { getLocalizedPath } from "../i18n/routes";

type Props = { locale: Locale };
const { locale } = Astro.props;
const messages = getMessages(locale);
const isLocalizedPublicRoute = Boolean(getLocaleFromPath(Astro.url.pathname));
const publicHref = (path: string) => isLocalizedPublicRoute ? getLocalizedPath(path, locale) : path;
const links = [
  { href: publicHref("/cars/"), label: messages.navCars },
  { href: publicHref("/pricing/"), label: messages.navPricing },
  { href: publicHref("/sell/"), label: messages.navSell },
  { href: publicHref("/support/"), label: messages.navSupport },
  { href: publicHref("/privacy/"), label: messages.navPrivacy },
  { href: publicHref("/impressum/"), label: "Impressum" },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <strong>SiteCraft Auto Market</strong>
      <p>{messages.footerProduct}</p>
      <p>
        {messages.footerSupport}{" "}
        <a href="mailto:support@sitecraft.agency">support@sitecraft.agency</a>
      </p>
    </div>
    <div class="footer-side">
      <nav class="footer-links" aria-label={messages.footerLinks}>
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <label class="theme-switch">
        <input class="theme-switch-input" type="checkbox" aria-label={messages.themeEnableDark} />
        <span class="theme-switch-track" aria-hidden="true">
          <span class="theme-switch-thumb"></span>
        </span>
        <span class="theme-switch-text">{messages.themeDark}</span>
      </label>
    </div>
  </div>
  <script>
    const footerThemeSwitch = document.querySelector(".site-footer .theme-switch-input");

    const syncFooterThemeSwitch = () => {
      if (footerThemeSwitch instanceof HTMLInputElement) {
        footerThemeSwitch.checked = (document.documentElement.dataset.theme || "light") === "dark";
      }
    };

    syncFooterThemeSwitch();

    footerThemeSwitch?.addEventListener("change", () => {
      if (!(footerThemeSwitch instanceof HTMLInputElement)) {
        return;
      }

      const nextTheme = footerThemeSwitch.checked ? "dark" : "light";
      document.documentElement.dataset.theme = nextTheme;
      localStorage.setItem("sitecraft-theme", nextTheme);
      syncFooterThemeSwitch();
    });
  </script>
</footer>
