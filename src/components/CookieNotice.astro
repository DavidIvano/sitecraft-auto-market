---
import { translate } from "../i18n/translate";
const { locale = "ru" } = Astro.props;
const privacyHref = "/privacy";
const cookieBody = locale === "de"
  ? translate(locale, "cookie.body")
  : "Мы используем только необходимые cookie: для входа, сохранения сессии и запоминания уведомления. Рекламных и аналитических cookie нет.";
---

<div class="cookie-notice" id="cookie-notice" hidden>
  <div>
    <strong>{translate(locale, "cookie.title")}</strong>
    <p>{cookieBody}</p>
  </div>
  <div class="cookie-actions">
    <a class="button button-light" href={privacyHref} hreflang="ru">{translate(locale, "cookie.details")}</a>
    <button class="button button-dark" type="button" id="cookie-accept">{translate(locale, "cookie.accept")}</button>
  </div>
</div>

<script>
  import { acceptCookieNotice, hasCookieNotice } from "../lib/authClient";

  const notice = document.querySelector("#cookie-notice");
  const acceptButton = document.querySelector("#cookie-accept");

  if (notice instanceof HTMLElement && !hasCookieNotice()) {
    notice.hidden = false;
  }

  acceptButton?.addEventListener("click", () => {
    acceptCookieNotice();

    if (notice instanceof HTMLElement) {
      notice.hidden = true;
    }
  });
</script>
