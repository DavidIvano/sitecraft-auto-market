---
import type { Locale } from "../i18n/locales";
import { getLocaleFromPath } from "../i18n/locale";
import { getMessages } from "../i18n/messages";
import { getLocalizedPath } from "../i18n/routes";

type Props = { locale: Locale };
const { locale } = Astro.props;
const messages = getMessages(locale);
const privacyHref = getLocaleFromPath(Astro.url.pathname) ? getLocalizedPath("/privacy/", locale) : "/privacy/";
---

<div class="cookie-notice" id="cookie-notice" hidden>
  <div>
    <strong>{messages.cookieTitle}</strong>
    <p>{messages.cookieText}</p>
  </div>
  <div class="cookie-actions">
    <a class="button button-light" href={privacyHref}>{messages.cookieMore}</a>
    <button class="button button-dark" type="button" id="cookie-accept">{messages.cookieAccept}</button>
  </div>
</div>

<script>
  import { acceptCookieNotice, hasCookieNotice } from "../lib/authClient";

  const notice = document.querySelector("#cookie-notice");
  const acceptButton = document.querySelector("#cookie-accept");

  if (notice instanceof HTMLElement && !hasCookieNotice()) {
    notice.hidden = false;
  }

  acceptButton?.addEventListener("click", () => {
    acceptCookieNotice();

    if (notice instanceof HTMLElement) {
      notice.hidden = true;
    }
  });
</script>
