---
import {
  LOCALE_COOKIE,
  LOCALE_LABELS,
  SELECTABLE_LOCALES,
  isLegacyUiLocale,
  type Locale,
} from "../i18n/locales";
import { getMessages } from "../i18n/messages";
import { getLocaleFromPath } from "../i18n/locale";
import { stripLocalePrefix } from "../i18n/routes";

type Props = {
  locale: Locale;
  alternateLocales?: Array<{ locale: string; path: string; label?: string }>;
};
const { locale, alternateLocales = [] } = Astro.props;
const messages = getMessages(locale);
const localizedPath = getLocaleFromPath(Astro.url.pathname) ? stripLocalePrefix(Astro.url.pathname) : "";
const compatibilityRoutes = localizedPath
  ? SELECTABLE_LOCALES.map((code) => ({
      locale: code,
      path: `${localizedPath}${localizedPath.includes("?") ? "&" : "?"}lang=${encodeURIComponent(code)}`,
      label: LOCALE_LABELS[code],
    }))
  : [];
const routeOptions = alternateLocales.length > 1
  ? alternateLocales
  : compatibilityRoutes.length > 0
    ? compatibilityRoutes
    : SELECTABLE_LOCALES.map((code) => ({ locale: code, path: "", label: LOCALE_LABELS[code] }));
const routeMode = alternateLocales.length > 1 || compatibilityRoutes.length > 0 ? "path" : "legacy-query";
const translatedOptions = routeOptions.filter((option) => isLegacyUiLocale(option.locale));
const fallbackOptions = routeOptions.filter((option) => !isLegacyUiLocale(option.locale));
const translatedGroupLabels: Record<string, string> = {
  ar: "اللغات المترجمة",
  de: "Übersetzte Sprachen",
  en: "Translated languages",
  fr: "Langues traduites",
  ru: "Переведённые языки",
  tr: "Çevrilmiş diller",
  uk: "Перекладені мови",
};
const fallbackGroupLabels: Record<string, string> = {
  ar: "اللغات الأوروبية · المحتوى بالإنجليزية",
  de: "Europäische Sprachen · Inhalt auf Englisch",
  en: "European languages · English content",
  fr: "Langues européennes · contenu en anglais",
  ru: "Европейские языки · контент на английском",
  tr: "Avrupa dilleri · İngilizce içerik",
  uk: "Європейські мови · контент англійською",
};
const translatedGroupLabel = translatedGroupLabels[locale] || translatedGroupLabels.en;
const fallbackGroupLabel = fallbackGroupLabels[locale] || fallbackGroupLabels.en;
---

<label class="locale-switcher">
  <span class="sr-only">{messages.language}</span>
  <select aria-label={messages.language} data-locale-switcher data-locale-cookie={LOCALE_COOKIE} data-route-mode={routeMode}>
    <optgroup label={translatedGroupLabel}>
      {translatedOptions.map((option) => <option value={option.locale} data-path={option.path} selected={option.locale === locale}>{option.label || LOCALE_LABELS[option.locale] || option.locale}</option>)}
    </optgroup>
    {fallbackOptions.length > 0 && <optgroup label={fallbackGroupLabel}>
      {fallbackOptions.map((option) => <option value={option.locale} data-path={option.path} selected={option.locale === locale}>{option.label || LOCALE_LABELS[option.locale] || option.locale}</option>)}
    </optgroup>}
  </select>
</label>

<script>
  document.querySelectorAll("[data-locale-switcher]").forEach((element) => {
    if (!(element instanceof HTMLSelectElement) || element.dataset.localeReady === "true") return;
    element.dataset.localeReady = "true";
    element.addEventListener("change", () => {
      element.disabled = true;
      element.setAttribute("aria-busy", "true");
      const cookieName = element.dataset.localeCookie || "sitecraft-locale";
      document.cookie = `${cookieName}=${encodeURIComponent(element.value)}; Path=/; Max-Age=31536000; SameSite=Lax`;
      const selected = element.selectedOptions[0];
      if (element.dataset.routeMode === "path" && selected?.dataset.path) {
        window.location.assign(selected.dataset.path);
        return;
      }
      const nextUrl = new URL(window.location.href);
      nextUrl.searchParams.set("lang", element.value);
      window.location.assign(nextUrl.toString());
    });
  });
</script>
