---
import { renderFavoriteButtonMarkup } from "../../lib/favorites";
import type { Locale } from "../../i18n/locales";
type Props = { listingId: number | string; initialSaved?: boolean; source?: string; class?: string; locale?: Locale };
const { listingId, initialSaved = false, source = "detail", class: className = "", locale } = Astro.props;
const markup = renderFavoriteButtonMarkup(listingId, initialSaved, source, locale).replace('class="car-card-favourite"', `class="car-card-favourite ${className}"`);
---
<Fragment set:html={markup} />
