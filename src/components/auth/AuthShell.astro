---
type Props = {
  infoEyebrow: string;
  infoTitle: string;
  infoText: string;
  benefits: string[];
  formEyebrow: string;
  formTitle: string;
};

const {
  infoEyebrow,
  infoTitle,
  infoText,
  benefits,
  formEyebrow,
  formTitle,
} = Astro.props;
---

<section class="auth-shell-section" aria-labelledby="auth-form-title">
  <div class="container auth-shell-grid">
    <div class="auth-shell-card auth-form-card">
      <header class="auth-form-heading">
        <p class="eyebrow">{formEyebrow}</p>
        <h1 id="auth-form-title">{formTitle}</h1>
      </header>
      <slot />
    </div>

    <aside class="auth-shell-card auth-info-card" aria-labelledby="auth-info-title">
      <div>
        <p class="eyebrow">{infoEyebrow}</p>
        <h2 id="auth-info-title">{infoTitle}</h2>
        <p class="lead">{infoText}</p>
      </div>
      <ul>
        {benefits.slice(0, 3).map((benefit) => <li><i class="auth-benefit-icon" data-lucide="check" aria-hidden="true"></i><span>{benefit}</span></li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .auth-shell-section {
    display: grid;
    place-items: center;
    padding: var(--space-12) 0;
  }

  .auth-shell-grid {
    width: min(100% - 32px, 1080px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--space-6);
  }

  .auth-shell-card {
    min-width: 0;
    min-height: 0;
    height: auto;
    padding: var(--space-8);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-panel);
    background: var(--surface-solid);
    box-shadow: var(--shadow-card);
  }

  .auth-form-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    order: 2;
  }

  .auth-form-heading {
    display: grid;
    gap: var(--space-2);
  }

  .auth-form-heading h1,
  .auth-info-card h2 {
    margin: 0;
    letter-spacing: 0;
  }

  .auth-form-heading h1 {
    font-size: clamp(2rem, 4vw, 2.5rem);
  }

  .auth-info-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    order: 1;
  }

  .auth-info-card > div {
    display: grid;
    gap: var(--space-4);
  }

  .auth-info-card h2 {
    max-width: 12ch;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .auth-info-card .lead {
    max-width: 42ch;
    margin: 0;
  }

  .auth-info-card ul {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .auth-info-card li {
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  :global(.auth-form-card .form-panel) {
    display: grid;
    gap: 16px;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  :global(.auth-form-card .auth-panel) {
    display: grid;
    gap: 16px;
    margin: 0;
  }

  :global(.auth-form-card .full-field) {
    display: grid;
    gap: 8px;
  }

  :global(.auth-form-card input) {
    min-height: 48px;
  }

  :global(.auth-form-card .button) {
    min-height: 48px;
  }

  :global(.auth-form-card .password-toggle) {
    min-width: var(--control-md);
    min-height: 44px;
  }

  :global(.auth-form-card [aria-busy="true"]) {
    cursor: wait;
  }

  @media (max-width: 820px) {
    .auth-shell-section {
      min-height: auto;
      place-items: start center;
      padding: 24px 0 max(40px, env(safe-area-inset-bottom));
    }

    .auth-shell-grid {
      width: min(100% - 24px, 620px);
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .auth-shell-card {
      min-height: auto;
      padding: var(--space-6);
    }

    .auth-form-heading h1 {
      font-size: 2.125rem;
    }

    .auth-form-card {
      order: 1;
    }

    .auth-info-card {
      order: 2;
    }
  }

  @media (max-width: 420px) {
    .auth-info-card h2 {
      font-size: 2rem;
    }
  }
</style>
