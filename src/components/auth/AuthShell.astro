---
type Props = {
  infoEyebrow: string;
  infoTitle: string;
  infoText: string;
  benefits: string[];
  formEyebrow: string;
  formTitle: string;
};

const {
  infoEyebrow,
  infoTitle,
  infoText,
  benefits,
  formEyebrow,
  formTitle,
} = Astro.props;
---

<section class="auth-shell-section" aria-labelledby="auth-form-title">
  <div class="container auth-shell-grid">
    <div class="auth-shell-card auth-form-card">
      <header class="auth-form-heading">
        <p class="eyebrow">{formEyebrow}</p>
        <h1 id="auth-form-title">{formTitle}</h1>
      </header>
      <slot />
    </div>

    <aside class="auth-shell-card auth-info-card" aria-labelledby="auth-info-title">
      <div>
        <p class="eyebrow">{infoEyebrow}</p>
        <h2 id="auth-info-title">{infoTitle}</h2>
        <p class="lead">{infoText}</p>
      </div>
      <ul>
        {benefits.slice(0, 3).map((benefit) => <li>{benefit}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .auth-shell-section {
    min-height: min(760px, calc(100dvh - 220px));
    display: grid;
    place-items: center;
    padding: clamp(32px, 6vh, 72px) 0;
  }

  .auth-shell-grid {
    width: min(100% - 32px, 1080px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: clamp(24px, 3vw, 32px);
  }

  .auth-shell-card {
    min-width: 0;
    min-height: 560px;
    height: 100%;
    padding: clamp(24px, 4vw, 40px);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-panel);
    background: var(--surface-solid);
    box-shadow: var(--shadow-card);
  }

  .auth-form-card {
    display: flex;
    flex-direction: column;
    gap: 24px;
    order: 2;
  }

  .auth-form-heading {
    display: grid;
    gap: 8px;
  }

  .auth-form-heading h1,
  .auth-info-card h2 {
    margin: 0;
    letter-spacing: 0;
  }

  .auth-form-heading h1 {
    font-size: 40px;
  }

  .auth-info-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    order: 1;
  }

  .auth-info-card > div {
    display: grid;
    gap: 16px;
  }

  .auth-info-card h2 {
    max-width: 12ch;
    font-size: 48px;
    line-height: 1.05;
  }

  .auth-info-card .lead {
    max-width: 42ch;
    margin: 0;
  }

  .auth-info-card ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .auth-info-card li {
    position: relative;
    min-height: 44px;
    display: flex;
    align-items: center;
    padding-left: 32px;
  }

  .auth-info-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 800;
  }

  :global(.auth-form-card .form-panel) {
    display: grid;
    gap: 16px;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  :global(.auth-form-card .auth-panel) {
    display: grid;
    gap: 16px;
    margin: 0;
  }

  :global(.auth-form-card .full-field) {
    display: grid;
    gap: 8px;
  }

  :global(.auth-form-card input) {
    min-height: 48px;
  }

  :global(.auth-form-card .button) {
    min-height: 48px;
  }

  :global(.auth-form-card .password-toggle) {
    min-width: 88px;
    min-height: 44px;
  }

  :global(.auth-form-card [aria-busy="true"]) {
    cursor: wait;
  }

  @media (max-width: 820px) {
    .auth-shell-section {
      min-height: auto;
      place-items: start center;
      padding: 24px 0 max(40px, env(safe-area-inset-bottom));
    }

    .auth-shell-grid {
      width: min(100% - 24px, 620px);
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .auth-shell-card {
      min-height: auto;
      padding: clamp(22px, 6vw, 32px);
    }

    .auth-form-heading h1 {
      font-size: 34px;
    }

    .auth-form-card {
      order: 1;
    }

    .auth-info-card {
      order: 2;
    }
  }

  @media (max-width: 420px) {
    .auth-info-card h2 {
      font-size: 32px;
    }
  }
</style>
