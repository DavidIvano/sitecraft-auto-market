<dialog class="image-lightbox" id="site-image-lightbox" aria-label="Просмотр фотографий автомобиля" aria-modal="true">
  <div class="image-lightbox-shell">
    <header class="image-lightbox-toolbar">
      <output class="image-lightbox-count" data-lightbox-count aria-live="polite">1 / 1</output>
      <button class="image-lightbox-close" type="button" data-lightbox-close aria-label="Закрыть просмотр"><i data-lucide="x" aria-hidden="true"></i></button>
    </header>

    <output class="sr-only" data-lightbox-zoom-value aria-live="polite">100%</output>

    <div class="image-lightbox-stage">
      <button class="image-lightbox-nav image-lightbox-prev" type="button" data-lightbox-prev aria-label="Предыдущая фотография"><i data-lucide="chevron-left" aria-hidden="true"></i></button>
      <div class="image-lightbox-viewport" data-lightbox-viewport>
        <img data-lightbox-image alt="" decoding="async" referrerpolicy="no-referrer" draggable="false" />
      </div>
      <button class="image-lightbox-nav image-lightbox-next" type="button" data-lightbox-next aria-label="Следующая фотография"><i data-lucide="chevron-right" aria-hidden="true"></i></button>
    </div>

    <footer class="image-lightbox-footer">
      <div class="image-lightbox-thumbnails" data-lightbox-thumbnails aria-label="Фотографии автомобиля"></div>
    </footer>
  </div>
</dialog>
