---
import type { CarListing } from "../lib/types";
import { renderPublicCarCardMarkup } from "../lib/publicCarCard";

type Props = {
  car: CarListing;
  matchReasons?: string[];
  priority?: boolean;
  source?: string;
};

const { car, priority = false, source = "public_car_card" } = Astro.props;
const markup = renderPublicCarCardMarkup(car, { priority, source });

---

<Fragment set:html={markup} />
