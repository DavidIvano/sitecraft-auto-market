---
import type { CarListing } from "../lib/types";
import { renderPublicCarCardMarkup } from "../lib/publicCarCard";

type Props = {
  car: CarListing;
  matchReasons?: string[];
  priority?: boolean;
};

const { car, priority = false } = Astro.props;
const markup = renderPublicCarCardMarkup(car, { priority });

---

<Fragment set:html={markup} />
