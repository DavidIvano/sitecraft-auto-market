---
import { carBrands } from "../data/carOptions";
import { getBackendValueOptions, normalizeBackendValue } from "../i18n/backendValues";
import { getCatalogMessages } from "../i18n/catalogMessages";
import type { Locale } from "../i18n/locales";

type Props = { locale: Locale };
const { locale } = Astro.props;
const messages = getCatalogMessages(locale);
const vehicleTypes = getBackendValueOptions("vehicle_type", locale);
const bodyTypes = getBackendValueOptions("body_type", locale);
const fuelTypes = getBackendValueOptions("fuel_type", locale);
const transmissions = getBackendValueOptions("transmission", locale);

const params = Astro.url.searchParams;
const selectedVehicleType = normalizeBackendValue("vehicle_type", params.get("vehicle_type"));
const selectedBodyType = normalizeBackendValue("body_type", params.get("body_type"));
const selectedBrand = params.get("brand") || "";
const selectedModel = params.get("model") || "";
const selectedCity = params.get("city") || "";
const selectedPriceMin = params.get("price_min") || "";
const selectedPriceMax = params.get("price_max") || params.get("price") || "";
const selectedFuelType = normalizeBackendValue("fuel_type", params.get("fuel_type"));
const selectedTransmission = normalizeBackendValue("transmission", params.get("transmission"));
const selectedYearMin = params.get("year_min") || "";
const selectedYearMax = params.get("year_max") || "";
const selectedMileageMax = params.get("mileage_max") || "";
---

<form class="search-bar" action="/cars" method="get">
  <fieldset class="filter-group">
    <legend>Автомобиль</legend>
    <div class="filter-group-grid">
      <label class="search-field search-field-brand">
        <span>{messages.brand}</span>
        <select name="brand">
          <option value="">{messages.anyFeminine}</option>
          {carBrands.map((brand) => <option value={brand} selected={selectedBrand === brand}>{brand}</option>)}
        </select>
      </label>
      <label class="search-field search-field-model">
        <span>{messages.model}</span>
        <input type="text" name="model" placeholder="Например, Golf" value={selectedModel} />
      </label>
      <label class="search-field search-field-city">
        <span>{messages.city}</span>
        <input type="text" name="city" placeholder={messages.cityExample} value={selectedCity} />
      </label>
    </div>
  </fieldset>

  <fieldset class="filter-group">
    <legend>Бюджет и год</legend>
    <div class="filter-group-grid filter-group-grid-pairs">
      <label class="search-field search-field-price-min"><span>{messages.priceFrom}</span><input type="number" name="price_min" placeholder="5 000" min="0" value={selectedPriceMin} /></label>
      <label class="search-field search-field-price-max"><span>{messages.priceTo}</span><input type="number" name="price_max" placeholder="20 000" min="0" value={selectedPriceMax} /></label>
      <label class="search-field search-field-year-min"><span>{messages.yearFrom}</span><input type="number" name="year_min" placeholder="2015" min="1950" max="2030" value={selectedYearMin} /></label>
      <label class="search-field search-field-year-max"><span>{messages.yearTo}</span><input type="number" name="year_max" placeholder="2026" min="1950" max="2030" value={selectedYearMax} /></label>
    </div>
  </fieldset>

  <fieldset class="filter-group">
    <legend>Характеристики</legend>
    <div class="filter-group-grid">
      <label class="search-field search-field-vehicle"><span>{messages.vehicleType}</span><select name="vehicle_type"><option value="">{messages.anyMasculine}</option>{vehicleTypes.map((type) => <option value={type.value} selected={selectedVehicleType === type.value}>{type.label}</option>)}</select></label>
      <label class="search-field search-field-body"><span>{messages.bodyType}</span><select name="body_type"><option value="">{messages.anyMasculine}</option>{bodyTypes.map((type) => <option value={type.value} selected={selectedBodyType === type.value}>{type.label}</option>)}</select></label>
      <label class="search-field search-field-fuel"><span>{messages.fuel}</span><select name="fuel_type"><option value="">{messages.anyNeutral}</option>{fuelTypes.map((type) => <option value={type.value} selected={selectedFuelType === type.value}>{type.label}</option>)}</select></label>
      <label class="search-field search-field-transmission"><span>{messages.transmission}</span><select name="transmission"><option value="">{messages.anyFeminine}</option>{transmissions.map((type) => <option value={type.value} selected={selectedTransmission === type.value}>{type.label}</option>)}</select></label>
      <label class="search-field search-field-mileage-max"><span>{messages.mileageTo}</span><input type="number" name="mileage_max" placeholder="150 000" min="0" step="1000" value={selectedMileageMax} /></label>
    </div>
  </fieldset>
  <div class="search-bar-actions">
    <button class="button button-primary search-submit" type="submit"><i data-lucide="search" aria-hidden="true"></i><span>{messages.applyFree}</span></button>
    <button class="button button-secondary" type="reset" id="catalog-filter-reset"><i data-lucide="rotate-ccw" aria-hidden="true"></i><span>{messages.reset}</span></button>
  </div>
</form>
