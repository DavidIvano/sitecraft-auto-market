---
import DealFinderImage from "./DealFinderImage.astro";
import DealFinderStatusBadge from "./DealFinderStatusBadge.astro";
import DealScoreBadge from "./DealScoreBadge.astro";
import ActionButton from "../ActionButton.astro";
import { formatDealFinderPrice, formatDealFinderDate, getSafeDealFinderSourceUrl } from "../../lib/deal-finder/formatters";
import { decodeDealFinderText } from "../../lib/deal-finder/text";
import { detailUrl } from "../../lib/deal-finder/routes";
import type { DealFinderListing } from "../../lib/deal-finder/types";
type Props = { listing: DealFinderListing };
const { listing } = Astro.props;
const analysis = listing.analysis;
const sourceUrl = getSafeDealFinderSourceUrl(listing.source_url);
const displayTitle = decodeDealFinderText(listing.title);
const listingUrl = detailUrl(listing.id);
const canAnalyze = !analysis || analysis.status === "failed";
---
<article class="deal-finder-card">
  <a href={listingUrl} aria-label={`Открыть ${displayTitle}`}><DealFinderImage src={listing.source_image_url} alt={displayTitle} /></a>
  <div class="deal-finder-card-body">
    <div class="deal-finder-card-top"><DealFinderStatusBadge sourceStatus={listing.source_status} userStatus={listing.user_status} recommendation={analysis?.recommendation} /><DealScoreBadge score={analysis?.deal_score} /></div>
    <h2><a href={listingUrl}>{displayTitle}</a></h2><strong class="deal-finder-price">{formatDealFinderPrice(listing.price, listing.currency)}</strong>
    <dl><div><dt>Год</dt><dd>{listing.year || "—"}</dd></div><div><dt>Пробег</dt><dd>{listing.mileage ? `${listing.mileage.toLocaleString("ru-RU")} км` : "—"}</dd></div><div><dt>Город</dt><dd>{listing.city || "—"}</dd></div></dl>
    <p class="deal-finder-meta">Найдено: {formatDealFinderDate(listing.first_seen_at)}</p>
    <div class="deal-finder-actions">
      {sourceUrl && <ActionButton href={sourceUrl} external icon="external-link" variant="neutral" kind="source" label="Источник" />}
      <ActionButton action={listing.is_saved ? "unsave" : "save"} icon="bookmark" variant="success" kind="save" label={listing.is_saved ? "Сохранено" : "Сохранить"} pressed={listing.is_saved} />
      <ActionButton action="view" icon={listing.is_viewed ? "badge-check" : "eye"} variant="primary" kind="viewed" label="Просмотрено" pressed={listing.is_viewed} disabled={listing.is_viewed} />
      <ActionButton action={listing.is_hidden ? "restore" : "hide"} icon={listing.is_hidden ? "rotate-ccw" : "eye-off"} variant={listing.is_hidden ? "success" : "warning"} kind={listing.is_hidden ? "restore" : "hide"} label={listing.is_hidden ? "Вернуть" : "Скрыть"} />
      {canAnalyze && <ActionButton action="analyze" icon="sparkles" variant="ai" kind="ai" label="AI-анализ" />}
      <ActionButton href={listingUrl} icon="info" variant="primary" kind="detail" label="Открыть" />
    </div>
  </div>
</article>
