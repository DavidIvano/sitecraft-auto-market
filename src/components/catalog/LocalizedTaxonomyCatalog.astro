---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CarCard from "../CarCard.astro";
import type { CarListing } from "../../lib/types";
import type { PublicPageMessages } from "../../i18n/publicRoutes";

type Props = {
  locale: string;
  title: string;
  description: string;
  canonicalPath: string;
  cars: CarListing[];
  messages: PublicPageMessages;
  noindex: boolean;
  alternateLocales: Array<{ locale: string; path: string; label?: string }>;
};

const { locale, title, description, canonicalPath, cars, messages, noindex, alternateLocales } = Astro.props;
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  inLanguage: locale,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: cars.map((car, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/cars/${car.slug}/?lang=${encodeURIComponent(locale)}`, Astro.site || Astro.url.origin).toString(),
      name: car.title,
    })),
  },
};
---

<BaseLayout
  variant="public"
  locale={locale}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  noindex={noindex}
  jsonLd={schema}
  breadcrumbs={[
    { href: `/${locale}/`, label: messages.homeTitle },
    { href: `/${locale}/cars/`, label: messages.catalogTitle },
    { label: title },
  ]}
  alternateLocales={alternateLocales}
  xDefaultPath="/"
>
  <section class="section page-hero catalog-hero">
    <div class="container">
      <p class="eyebrow">{messages.catalogTitle}</p>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
    </div>
  </section>
  <section class="section catalog-results-section">
    <div class="container">
      <div class="catalog-results-toolbar"><div><span>{messages.results}</span><strong>{cars.length} {messages.vehicles}</strong></div></div>
      {cars.length > 0 ? (
        <div class="cards-grid catalog-grid">
          {cars.map((car, index) => <CarCard car={car} priority={index < 4} source="localized_taxonomy" locale={locale} />)}
        </div>
      ) : (
        <div class="empty-state" role="status"><h2>{messages.emptyTitle}</h2><p>{messages.emptyText}</p></div>
      )}
    </div>
  </section>
</BaseLayout>
