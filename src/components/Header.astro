---
import LocaleSwitcher from "./LocaleSwitcher.astro";
import type { Locale } from "../i18n/locales";
import { getMessages } from "../i18n/messages";

type Props = { locale: Locale };
const { locale } = Astro.props;
const messages = getMessages(locale);
const navItems = [
  { href: "/", label: messages.navHome },
  { href: "/cars", label: messages.navCars },
  { href: "/sell", label: messages.navSell },
  { href: "/pricing", label: messages.navPricing },
];

const xanoApiUrl = import.meta.env.PUBLIC_XANO_API_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrentPath = (href: string) => {
  const normalizedHref = href.replace(/\/$/, "") || "/";
  return normalizedHref === "/"
    ? currentPath === "/"
    : currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};
---

<header
  class="site-header"
  data-api-url={xanoApiUrl}
  data-label-menu-open={messages.menuOpen}
  data-label-menu-close={messages.menuClose}
  data-label-theme-dark={messages.themeEnableDark}
  data-label-theme-light={messages.themeEnableLight}
  data-label-login={messages.navLogin}
  data-label-dashboard={messages.navDashboard}
>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="SiteCraft Auto Market">
      <img class="brand-logo" src="/sitecraft-logo.png" alt="" width="44" height="44" decoding="async" />
      <span>SiteCraft Auto Market</span>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-label={messages.menuOpen}
      aria-controls="site-header-menu"
      aria-expanded="false"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
    <div class="header-menu" id="site-header-menu">
      <nav class="main-nav" aria-label={messages.mainNavigation}>
        {navItems.map((item) => <a href={item.href} aria-current={isCurrentPath(item.href) ? "page" : undefined}>{item.label}</a>)}
      </nav>
      <div class="header-actions">
        <LocaleSwitcher locale={locale} />
        <button class="button button-light theme-toggle" type="button" aria-label={messages.themeToggle} aria-pressed="false">
          <span aria-hidden="true">◐</span>
        </button>
        <a class="button button-light deal-finder-link" href="/dashboard/deal-finder/" data-deal-finder-only="true" hidden>Deal Finder</a>
        <a class="button button-light admin-link" href="/admin/moderation" data-admin-only="true" hidden>{messages.navModeration}</a>
        <a class="button button-light auth-register" href="/register">{messages.navRegister}</a>
        <a class="button button-light auth-link" href="/login">{messages.navLogin}</a>
        <button class="button button-light auth-logout" type="button" hidden>{messages.navLogout}</button>
        <a class="button button-dark header-action" href="/dashboard/new">{messages.navAddListing}</a>
      </div>
    </div>
  </div>
  <script>
    import { clearAuth, fetchCurrentUser, getAuthToken, getAuthUser, isAdminUser, isDealFinderUser } from "../lib/authClient";

    const authLink = document.querySelector(".auth-link");
    const authRegister = document.querySelector(".auth-register");
    const authLogout = document.querySelector(".auth-logout");
    const adminOnlyLinks = document.querySelectorAll("[data-admin-only]");
    const dealFinderOnlyLinks = document.querySelectorAll("[data-deal-finder-only]");
    const menu = document.querySelector(".header-menu");
    const menuToggle = document.querySelector(".menu-toggle");
    const header = document.querySelector(".site-header");
    const themeToggles = document.querySelectorAll(".theme-toggle");
    const token = getAuthToken();
    const apiUrl = header instanceof HTMLElement ? header.dataset.apiUrl : "";
    const labels = {
      menuOpen: header instanceof HTMLElement ? header.dataset.labelMenuOpen || "Open menu" : "Open menu",
      menuClose: header instanceof HTMLElement ? header.dataset.labelMenuClose || "Close menu" : "Close menu",
      themeDark: header instanceof HTMLElement ? header.dataset.labelThemeDark || "Enable dark theme" : "Enable dark theme",
      themeLight: header instanceof HTMLElement ? header.dataset.labelThemeLight || "Enable light theme" : "Enable light theme",
      login: header instanceof HTMLElement ? header.dataset.labelLogin || "Sign in" : "Sign in",
      dashboard: header instanceof HTMLElement ? header.dataset.labelDashboard || "Dashboard" : "Dashboard",
    };
    let lastScrollY = window.scrollY;

    const setMenuOpen = (isOpen: boolean) => {
      if (!(menu instanceof HTMLElement) || !(menuToggle instanceof HTMLButtonElement)) {
        return;
      }

      menu.classList.toggle("is-open", isOpen);
      menuToggle.classList.toggle("is-open", isOpen);
      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.setAttribute("aria-label", isOpen ? labels.menuClose : labels.menuOpen);
    };

    menuToggle?.addEventListener("click", () => {
      setMenuOpen(!(menu instanceof HTMLElement && menu.classList.contains("is-open")));
    });

    menu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });

    const syncThemeToggle = () => {
      const isDark = document.documentElement.dataset.theme === "dark";
      themeToggles.forEach((toggle) => {
        if (toggle instanceof HTMLButtonElement) {
          toggle.setAttribute("aria-pressed", String(isDark));
          toggle.setAttribute("aria-label", isDark ? labels.themeLight : labels.themeDark);
        }
      });
    };

    syncThemeToggle();
    themeToggles.forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = nextTheme;
        localStorage.setItem("sitecraft-theme", nextTheme);
        syncThemeToggle();
      });
    });

    const showGuestHeader = () => {
      if (authLink instanceof HTMLAnchorElement) {
        authLink.href = "/login";
        authLink.textContent = labels.login;
        authLink.hidden = false;
      }

      if (authRegister instanceof HTMLAnchorElement) {
        authRegister.hidden = false;
      }

      if (authLogout instanceof HTMLButtonElement) {
        authLogout.hidden = true;
      }

      adminOnlyLinks.forEach((link) => {
        if (link instanceof HTMLElement) {
          link.hidden = true;
        }
      });
      dealFinderOnlyLinks.forEach((link) => {
        if (link instanceof HTMLElement) link.hidden = true;
      });
    };

    const showUserHeader = (user: { email?: unknown; role?: unknown } | null) => {
      if (authLink instanceof HTMLAnchorElement) {
        authLink.href = "/dashboard";
        authLink.textContent = labels.dashboard;
        authLink.hidden = false;
      }

      if (authRegister instanceof HTMLAnchorElement) {
        authRegister.hidden = true;
      }

      if (authLogout instanceof HTMLButtonElement) {
        authLogout.hidden = false;
      }

      adminOnlyLinks.forEach((link) => {
        if (link instanceof HTMLElement) {
          link.hidden = !isAdminUser(user);
        }
      });
      dealFinderOnlyLinks.forEach((link) => {
        if (link instanceof HTMLElement) link.hidden = !isDealFinderUser(user);
      });
    };

    if (token && authLink instanceof HTMLAnchorElement && authLogout instanceof HTMLButtonElement) {
      const cachedUser = getAuthUser();
      showUserHeader(cachedUser);

      fetchCurrentUser(apiUrl, token)
        .then((user) => {
          if (user) showUserHeader(user);
          else if (!getAuthToken()) showGuestHeader();
        })
        .catch(() => {});
    } else {
      showGuestHeader();
    }

    authLogout?.addEventListener("click", () => {
      clearAuth();
      window.location.href = "/";
    });

    window.addEventListener(
      "scroll",
      () => {
        if (!(header instanceof HTMLElement)) {
          return;
        }

        const currentScrollY = window.scrollY;
        const isMenuOpen = menu instanceof HTMLElement && menu.classList.contains("is-open");
        const isScrollingDown = currentScrollY > lastScrollY;

        header.classList.toggle("is-hidden", isScrollingDown && currentScrollY > 120 && !isMenuOpen);
        lastScrollY = currentScrollY;
      },
      { passive: true },
    );
  </script>
</header>
