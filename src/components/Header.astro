---
import { translate } from "../i18n/translate";

type Props = {
  variant?: "public" | "workspace";
  locale?: string;
  alternateLocales?: Array<{ locale: string; path: string; label?: string }>;
};

const { variant = "public", locale = "ru", alternateLocales = [] } = Astro.props;
const isGerman = locale === "de";
const homeHref = isGerman ? "/de/" : "/";
const navItems = isGerman
  ? [{ href: "/de/cars/", label: translate(locale, "nav.cars") }]
  : [
      { href: "/cars", label: translate(locale, "nav.cars") },
      { href: "/pricing", label: translate(locale, "nav.pricing") },
      { href: "/support", label: translate(locale, "nav.support") },
    ];

const xanoApiUrl = import.meta.env.PUBLIC_XANO_API_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrentPath = (href: string) => {
  const normalizedHref = href.replace(/\/$/, "") || "/";
  return normalizedHref === "/"
    ? currentPath === "/"
    : currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};
---

<header
  class:list={["site-header", `site-header-${variant}`]}
  data-api-url={xanoApiUrl}
  data-header-variant={variant}
  data-home-path={homeHref}
  data-label-open-menu={translate(locale, "nav.openMenu")}
  data-label-close-menu={translate(locale, "nav.closeMenu")}
  data-label-dark-theme={translate(locale, "theme.dark")}
  data-label-light-theme={translate(locale, "theme.light")}
  data-label-login={translate(locale, "nav.login")}
  data-label-dashboard={translate(locale, "nav.dashboard")}
>
  <div class="container header-inner">
    <a class="brand" href={homeHref} aria-label="SiteCraft Auto Market">
      <img class="brand-logo" src="/sitecraft-logo.png" alt="" width="44" height="44" decoding="async" />
      <span>{variant === "workspace" ? "Кабинет Auto Market" : "SiteCraft Auto Market"}</span>
    </a>
    {variant === "public" && <button class="button button-light theme-toggle mobile-theme-toggle" type="button" aria-label={translate(locale, "theme.toggle")} aria-pressed="false">
      <span class="theme-toggle-icon" aria-hidden="true"><i data-lucide="moon"></i></span>
    </button>}
    <button
      class="menu-toggle"
      type="button"
      aria-label={translate(locale, "nav.openMenu")}
      aria-controls="site-header-menu"
      aria-expanded="false"
    >
      <span class="menu-toggle-icon" data-menu-open-icon aria-hidden="true"><i data-lucide="menu"></i></span>
      <span class="menu-toggle-icon" data-menu-close-icon aria-hidden="true" hidden><i data-lucide="x"></i></span>
    </button>
    <div class="header-menu" id="site-header-menu">
      {variant === "public" && <nav class="main-nav" aria-label={translate(locale, "nav.mainNavigation")}>
          {navItems.map((item) => <a href={item.href} aria-current={isCurrentPath(item.href) ? "page" : undefined}>{item.label}</a>)}
          {alternateLocales.filter((item) => item.locale !== locale).map((item) => (
            <a href={item.path} hreflang={item.locale}>{item.label || (item.locale === "ru" ? translate(locale, "nav.russianVersion") : item.locale.toUpperCase())}</a>
          ))}
        </nav>}
      <div class="header-actions">
        <button class="button button-light theme-toggle desktop-theme-toggle" type="button" aria-label={translate(locale, "theme.toggle")} aria-pressed="false">
          <span class="theme-toggle-icon" aria-hidden="true"><i data-lucide="moon"></i></span>
        </button>
        {variant === "workspace" && <a class="button button-light workspace-home-link" href="/"><i data-lucide="arrow-left" aria-hidden="true"></i><span>На сайт</span></a>}
        <a class="button button-light auth-register" href="/register" hreflang="ru" hidden={variant === "workspace"}>{translate(locale, "nav.register")}</a>
        <a class="button button-light auth-link" href="/login" hreflang="ru">{translate(locale, "nav.login")}</a>
        <button class="button button-light auth-logout" type="button" hidden>{translate(locale, "nav.logout")}</button>
        {variant === "public" && (isGerman
          ? <a class="button button-dark header-action" href="/dashboard/new" hreflang="ru"><i data-lucide="plus" aria-hidden="true"></i><span>{translate(locale, "nav.sell")}</span></a>
          : <a class="button button-dark header-action" href="/dashboard/new"><i data-lucide="plus" aria-hidden="true"></i><span>Продать авто</span></a>)}
      </div>
    </div>
  </div>
  {variant === "public" && <button class="header-backdrop" type="button" aria-label={translate(locale, "nav.closeMenu")} tabindex="-1"></button>}
  <script>
    import { clearAuth, fetchCurrentUser, getAuthToken, getAuthUser, isAdminUser, isDealFinderUser } from "../lib/authClient";
    import { refreshAppIcons } from "../lib/appIcons";

    const authLink = document.querySelector(".auth-link");
    const authRegister = document.querySelector(".auth-register");
    const authLogout = document.querySelector(".auth-logout");
    const adminOnlyLinks = document.querySelectorAll("[data-admin-only]");
    const dealFinderOnlyLinks = document.querySelectorAll("[data-deal-finder-only]");
    const menu = document.querySelector(".header-menu");
    const menuToggle = document.querySelector(".menu-toggle");
    const menuBackdrop = document.querySelector(".header-backdrop");
    const header = document.querySelector(".site-header");
    const themeToggles = document.querySelectorAll(".theme-toggle");
    const menuOpenIcon = menuToggle?.querySelector<HTMLElement>("[data-menu-open-icon]");
    const menuCloseIcon = menuToggle?.querySelector<HTMLElement>("[data-menu-close-icon]");
    const token = getAuthToken();
    const apiUrl = header instanceof HTMLElement ? header.dataset.apiUrl : "";
    const headerVariant = header instanceof HTMLElement ? header.dataset.headerVariant : "public";
    const homePath = header instanceof HTMLElement ? header.dataset.homePath || "/" : "/";
    const labels = header instanceof HTMLElement ? {
      openMenu: header.dataset.labelOpenMenu || "Открыть меню",
      closeMenu: header.dataset.labelCloseMenu || "Закрыть меню",
      darkTheme: header.dataset.labelDarkTheme || "Включить тёмную тему",
      lightTheme: header.dataset.labelLightTheme || "Включить светлую тему",
      login: header.dataset.labelLogin || "Войти",
      dashboard: header.dataset.labelDashboard || "Кабинет",
    } : null;
    let lastScrollY = window.scrollY;

    const setMenuOpen = (isOpen: boolean) => {
      if (!(menu instanceof HTMLElement) || !(menuToggle instanceof HTMLButtonElement)) {
        return;
      }

      menu.classList.toggle("is-open", isOpen);
      menuToggle.classList.toggle("is-open", isOpen);
      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.setAttribute("aria-label", isOpen ? labels?.closeMenu || "Закрыть меню" : labels?.openMenu || "Открыть меню");
      menuBackdrop?.classList.toggle("is-open", isOpen);
      document.body.classList.toggle("is-drawer-open", isOpen);
      if (menuOpenIcon) menuOpenIcon.hidden = isOpen;
      if (menuCloseIcon) menuCloseIcon.hidden = !isOpen;
    };

    menuToggle?.addEventListener("click", () => {
      setMenuOpen(!(menu instanceof HTMLElement && menu.classList.contains("is-open")));
    });

    menu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });

    menuBackdrop?.addEventListener("click", () => {
      setMenuOpen(false);
      if (menuToggle instanceof HTMLButtonElement) menuToggle.focus();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu instanceof HTMLElement && menu.classList.contains("is-open")) {
        setMenuOpen(false);
        if (menuToggle instanceof HTMLButtonElement) menuToggle.focus();
      }
    });

    document.addEventListener("pointerdown", (event) => {
      const target = event.target;
      if (!(target instanceof Node) || !(header instanceof HTMLElement)) return;
      if (!header.contains(target)) {
        setMenuOpen(false);
        if (menuToggle instanceof HTMLButtonElement) menuToggle.focus();
      }
    });

    const syncThemeToggle = () => {
      const isDark = document.documentElement.dataset.theme === "dark";
      themeToggles.forEach((toggle) => {
        if (toggle instanceof HTMLButtonElement) {
          toggle.setAttribute("aria-pressed", String(isDark));
          toggle.setAttribute("aria-label", isDark ? labels?.lightTheme || "Включить светлую тему" : labels?.darkTheme || "Включить тёмную тему");
          const icon = toggle.querySelector(".theme-toggle-icon");
          if (icon instanceof HTMLElement) {
            icon.innerHTML = `<i data-lucide="${isDark ? "sun" : "moon"}" aria-hidden="true"></i>`;
            refreshAppIcons(icon);
          }
        }
      });
    };

    syncThemeToggle();
    themeToggles.forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = nextTheme;
        localStorage.setItem("sitecraft-theme", nextTheme);
        syncThemeToggle();
      });
    });

    const showGuestHeader = () => {
      if (authLink instanceof HTMLAnchorElement) {
        authLink.href = "/login";
        authLink.textContent = labels?.login || "Войти";
        authLink.hidden = false;
      }

      if (authRegister instanceof HTMLAnchorElement) {
        authRegister.hidden = headerVariant === "workspace";
      }

      if (authLogout instanceof HTMLButtonElement) {
        authLogout.hidden = true;
      }

      adminOnlyLinks.forEach((link) => {
        if (link instanceof HTMLElement) {
          link.hidden = true;
        }
      });
      dealFinderOnlyLinks.forEach((link) => {
        if (link instanceof HTMLElement) link.hidden = true;
      });
    };

    const showUserHeader = (user: { email?: unknown; role?: unknown } | null) => {
      if (authLink instanceof HTMLAnchorElement) {
        authLink.href = "/dashboard";
        authLink.textContent = labels?.dashboard || "Кабинет";
        authLink.hidden = false;
      }

      if (authRegister instanceof HTMLAnchorElement) {
        authRegister.hidden = true;
      }

      if (authLogout instanceof HTMLButtonElement) {
        authLogout.hidden = false;
      }

      adminOnlyLinks.forEach((link) => {
        if (link instanceof HTMLElement) link.hidden = !isAdminUser(user);
      });
      dealFinderOnlyLinks.forEach((link) => {
        if (link instanceof HTMLElement) link.hidden = !isDealFinderUser(user);
      });
    };

    if (token && authLink instanceof HTMLAnchorElement && authLogout instanceof HTMLButtonElement) {
      const cachedUser = getAuthUser();
      showUserHeader(cachedUser);

      fetchCurrentUser(apiUrl, token)
        .then((user) => {
          if (user) showUserHeader(user);
          else if (!getAuthToken()) showGuestHeader();
        })
        .catch(() => {});
    } else {
      showGuestHeader();
    }

    authLogout?.addEventListener("click", () => {
      clearAuth();
      window.location.href = homePath;
    });

    window.addEventListener(
      "scroll",
      () => {
        if (!(header instanceof HTMLElement)) {
          return;
        }

        const currentScrollY = window.scrollY;
        const isMenuOpen = menu instanceof HTMLElement && menu.classList.contains("is-open");
        const isScrollingDown = currentScrollY > lastScrollY;

        header.classList.toggle("is-hidden", isScrollingDown && currentScrollY > 120 && !isMenuOpen);
        lastScrollY = currentScrollY;
      },
      { passive: true },
    );
  </script>
</header>
