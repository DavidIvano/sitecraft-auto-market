---
const xanoApiUrl = import.meta.env.PUBLIC_XANO_API_URL;
---
<section class="contact-profile-panel" data-contact-profile data-api-url={xanoApiUrl} aria-labelledby="contact-profile-title">
  <header><p class="eyebrow">Публичные контакты</p><h2 id="contact-profile-title">Как покупатели свяжутся с вами</h2><p>Данные входа не публикуются автоматически. Показываются только включённые здесь контакты.</p></header>
  <form class="contact-profile-form">
    <label>Имя<input name="first_name" type="text" autocomplete="given-name" maxlength="80" /></label>
    <label>Фамилия<input name="last_name" type="text" autocomplete="family-name" maxlength="80" /></label>
    <label>Публичное имя<input name="display_name" type="text" maxlength="120" /></label>
    <label>Телефон в формате E.164<input name="contact_phone" type="tel" inputmode="tel" placeholder="+491234567890" /></label>
    <label>Email для покупателей<input name="contact_email" type="email" autocomplete="email" /></label>
    <label class="contact-profile-check"><input name="show_phone" type="checkbox" />Показывать телефон</label>
    <label class="contact-profile-check"><input name="show_email" type="checkbox" />Показывать email</label>
    <label>Предпочтительный способ<select name="preferred_contact_method"><option value="">Не выбран</option><option value="phone">Телефон</option><option value="email">Email</option></select></label>
    <button class="button button-primary" type="submit">Сохранить контакты</button>
    <p class="form-message" data-contact-profile-status role="status" aria-live="polite"></p>
  </form>
</section>
<script>
  import { API_ROUTES } from "../../lib/apiRoutes";
  import { getAuthToken, redirectToLogin } from "../../lib/authClient";
  import { showToast } from "../../lib/toast";
  import type { SellerContactProfile } from "../../lib/types";
  const root = document.querySelector<HTMLElement>("[data-contact-profile]");
  const form = root?.querySelector<HTMLFormElement>("form");
  const status = root?.querySelector<HTMLElement>("[data-contact-profile-status]");
  const apiUrl = String(root?.dataset.apiUrl || "").replace(/\/+$/, "");
  const token = getAuthToken();
  const fill = (profile: Partial<SellerContactProfile>) => {
    if (!form) return;
    for (const [key, value] of Object.entries(profile)) {
      const field = form.elements.namedItem(key);
      if (field instanceof HTMLInputElement && field.type === "checkbox") field.checked = value === true;
      else if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) field.value = String(value ?? "");
    }
  };
  if (token && form) {
    fetch(`${apiUrl}${API_ROUTES.contactProfile}`, { headers: { Authorization: `Bearer ${token}` } })
      .then(async (response) => { if (response.status === 401) return redirectToLogin("/dashboard/"); if (!response.ok) throw new Error(); fill(await response.json()); })
      .catch(() => { if (status) status.textContent = "Настройки контактов временно недоступны."; });
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const phone = String(data.get("contact_phone") || "").trim();
      if (phone && !/^\+[1-9]\d{7,14}$/.test(phone)) { if (status) status.textContent = "Телефон должен быть в формате +491234567890."; return; }
      const payload = { first_name: String(data.get("first_name") || "").trim(), last_name: String(data.get("last_name") || "").trim(), display_name: String(data.get("display_name") || "").trim(), contact_phone: phone, contact_email: String(data.get("contact_email") || "").trim(), show_phone: data.has("show_phone"), show_email: data.has("show_email"), preferred_contact_method: String(data.get("preferred_contact_method") || "") };
      try {
        const response = await fetch(`${apiUrl}${API_ROUTES.contactProfile}`, { method: "PATCH", headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` }, body: JSON.stringify(payload) });
        if (response.status === 401) return redirectToLogin("/dashboard/");
        if (!response.ok) throw new Error();
        fill(await response.json());
        if (status) status.textContent = "Контакты сохранены.";
        showToast("Контакты сохранены");
      } catch { if (status) status.textContent = "Не удалось сохранить контакты."; showToast("Не удалось сохранить контакты", "error"); }
    });
  }
</script>
