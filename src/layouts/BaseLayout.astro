---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ImageLightbox from "../components/media/ImageLightbox.astro";
import CookieNotice from "../components/CookieNotice.astro";
import { LEGACY_PUBLIC_LOCALE } from "../i18n/config";
import { getLocaleDefinition, normalizeLocale } from "../i18n/locale";
import { translate } from "../i18n/translate";
import { DEAL_FINDER_ENABLED, SITE_DESCRIPTION, SITE_NAME, SITE_URL } from "../lib/config";
import "../styles/global.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/components/buttons.css";
import "../styles/components/forms.css";
import "../styles/components/header.css";
import "../styles/components/car-card.css";
import "../styles/components/catalog.css";
import "../styles/components/public-pages.css";
import "../styles/components/dialogs.css";
import "../styles/components/states.css";
import "../styles/components/dashboard.css";
import "../styles/promotions.css";

type LayoutVariant = "public" | "workspace" | "legal" | "auth";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: Array<{ href?: string; label: string }>;
  noindex?: boolean;
  ogType?: "website" | "product";
  variant?: LayoutVariant;
  locale?: string;
  alternateLocales?: Array<{ locale: string; path: string; label?: string }>;
};

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  canonicalPath,
  image = "/sitecraft-logo.png",
  jsonLd,
  breadcrumbs,
  noindex = false,
  ogType = "website",
  variant: requestedVariant,
  locale: requestedLocale = LEGACY_PUBLIC_LOCALE,
  alternateLocales = [],
} = Astro.props;
const pageLocale = normalizeLocale(requestedLocale, { activeOnly: true }) || LEGACY_PUBLIC_LOCALE;
const localeDefinition = getLocaleDefinition(pageLocale);
const pageTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const siteUrl = SITE_URL || "https://automarket.sitecraft.agency";
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const pageAlternates = alternateLocales.flatMap((alternate) => {
  const locale = normalizeLocale(alternate.locale, { activeOnly: true });
  if (!locale || !alternate.path.startsWith("/")) return [];
  return [{ ...alternate, locale, href: new URL(alternate.path, siteUrl).toString() }];
});
const buildSha = import.meta.env.PUBLIC_BUILD_SHA || import.meta.env.CF_PAGES_COMMIT_SHA || "local";
const buildTimestamp = import.meta.env.PUBLIC_BUILD_TIMESTAMP || new Date().toISOString();
const buildEnvironment =
  import.meta.env.PUBLIC_BUILD_ENVIRONMENT
  || import.meta.env.ENVIRONMENT
  || (import.meta.env.CF_PAGES_BRANCH ? "cloudflare-pages" : "local");
const labelBySegment: Record<string, string> = {
  admin: "Админ",
  auth: "Авторизация",
  cars: "Авто",
  dashboard: "Кабинет",
  detail: "Автомобиль",
  edit: "Редактирование",
  google: "Google",
  listings: "Мои объявления",
  login: "Вход",
  moderation: "Модерация",
  "deal-finder": "Deal Finder",
  new: "Новое объявление",
  privacy: "Конфиденциальность",
  register: "Регистрация",
  sell: "Продать авто",
  support: "Поддержка",
};
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isWorkspacePath = pathname === "/dashboard"
  || pathname.startsWith("/dashboard/")
  || pathname === "/admin"
  || pathname.startsWith("/admin/");
const layoutVariant: LayoutVariant = requestedVariant
  ?? (isWorkspacePath
    ? "workspace"
    : pathname === "/login" || pathname === "/register" || pathname.startsWith("/auth/")
      ? "auth"
      : ["/privacy", "/impressum", "/support"].includes(pathname)
        ? "legal"
        : "public");
const shellNavItems = [
  { href: "/dashboard", label: "Обзор", short: "О", icon: "layout-dashboard" },
  { href: "/dashboard/listings", label: "Мои объявления", short: "МО", icon: "car-front" },
  { href: "/dashboard/new", label: "Добавить объявление", short: "+", icon: "plus" },
  { href: "/dashboard/favorites", label: "Сохранённые", short: "С", icon: "heart" },
  ...(DEAL_FINDER_ENABLED
    ? [{ href: "/dashboard/deal-finder", label: "Deal Finder", short: "DF", icon: "radar", dealFinderOnly: true }]
    : []),
  { href: "/dashboard/billing", label: "Баланс", short: "Б", icon: "coins" },
  { href: "/dashboard/dealer", label: "Дилер", short: "Д", icon: "users" },
  { href: "/admin/moderation", label: "Модерация", short: "М", icon: "shield-check", adminOnly: true },
  { href: "/dashboard/#contact-profile", label: "Настройки", short: "Н", icon: "settings" },
];
const getShellNavClass = (href: string) => {
  const normalizedHref = href.replace(/\/$/, "") || "/";

  if (normalizedHref === "/") {
    return pathname === "/" ? "mac-sidebar-link is-active" : "mac-sidebar-link";
  }

  return pathname === normalizedHref || pathname.startsWith(`${normalizedHref}/`)
    ? "mac-sidebar-link is-active"
    : "mac-sidebar-link";
};
const generatedBreadcrumbs =
  pathname === "/"
    ? []
    : [
        { href: "/", label: "Главная" },
        ...pathname
          .split("/")
          .filter(Boolean)
          .map((segment, index, segments) => {
            const href = `/${segments.slice(0, index + 1).join("/")}`;
            const isLast = index === segments.length - 1;
            const label =
              isLast && title && title !== SITE_NAME
                ? title
                : labelBySegment[segment] || decodeURIComponent(segment).replaceAll("-", " ");

            return {
              href: isLast ? undefined : href,
              label,
            };
          }),
      ];
const pageBreadcrumbs = breadcrumbs ?? generatedBreadcrumbs;
const defaultSchemaItems = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "SiteCraft Agency",
    url: "https://sitecraft.agency",
    logo: new URL("/sitecraft-logo.png", siteUrl).toString(),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_NAME,
    url: siteUrl,
    potentialAction: {
      "@type": "SearchAction",
      target: `${new URL(pageLocale === "de" ? "/de/cars/" : "/cars", siteUrl).toString()}?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
];
const schemaItems = [
  ...defaultSchemaItems,
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
---

<!doctype html>
<html lang={pageLocale} dir={localeDefinition.direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="hl6ai62kYZBVuSHXumUNoaL4SJ5f0Shbdeda_Mf_s1I" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="sitecraft-build-sha" content={buildSha} />
    <meta name="sitecraft-build-timestamp" content={buildTimestamp} />
    <meta name="sitecraft-build-environment" content={buildEnvironment} />
    <meta name="description" content={description} />
    <meta http-equiv="Content-Language" content={pageLocale} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalUrl} />
    {pageAlternates.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />)}
    {pageAlternates.some((alternate) => alternate.locale === "ru") && (
      <link rel="alternate" hreflang="x-default" href={pageAlternates.find((alternate) => alternate.locale === "ru")?.href} />
    )}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{pageTitle}</title>
    {
      schemaItems.map((item) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("sitecraft-theme");
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = savedTheme || systemTheme;
      })();
    </script>
  </head>
  <body>
    <div class:list={["app-shell", `app-shell-${layoutVariant}`, layoutVariant === "workspace" && "mac-app-shell is-workspace-shell"]}>
      {layoutVariant === "workspace" && <aside class="mac-sidebar" aria-label="Навигация кабинета SiteCraft Auto Market">
        <div class="mac-sidebar-top">
          <a class="mac-sidebar-brand" href="/dashboard/" aria-label="SiteCraft Auto Market: кабинет">
            <img src="/sitecraft-logo.png" alt="" width="38" height="38" decoding="async" />
            <strong>Auto Market</strong>
          </a>
          <button class="mac-sidebar-toggle" type="button" aria-label="Скрыть боковое меню" aria-expanded="true"><i data-lucide="panel-left-close" aria-hidden="true"></i></button>
        </div>
        <nav class="mac-sidebar-nav" aria-label="Разделы кабинета">
          {
            shellNavItems.map((item) => (
              <a
                class={getShellNavClass(item.href)}
                href={item.href}
                aria-current={getShellNavClass(item.href).includes("is-active") ? "page" : undefined}
                data-short={item.short}
                data-admin-only={item.adminOnly ? "true" : undefined}
                data-deal-finder-only={item.dealFinderOnly ? "true" : undefined}
                hidden={item.adminOnly || item.dealFinderOnly}
              >
                <i data-lucide={item.icon} aria-hidden="true"></i><span>{item.label}</span>
              </a>
            ))
          }
        </nav>
        <div class="mac-sidebar-footer">
          <button class="button button-light mac-sidebar-theme theme-toggle" type="button" aria-label="Переключить тему" aria-pressed="false">
            <span class="theme-toggle-icon" aria-hidden="true"><i data-lucide="moon"></i></span>
            <strong>Тема</strong>
          </button>
          <a class="mac-sidebar-return" href="/"><i data-lucide="arrow-left" aria-hidden="true"></i><span>Вернуться на сайт</span></a>
        </div>
      </aside>}
      <div class="mac-workspace">
        <Header
          variant={layoutVariant === "workspace" ? "workspace" : "public"}
          locale={pageLocale}
          alternateLocales={pageAlternates.map(({ locale, path, label }) => ({ locale, path, label }))}
        />
        <main class="mac-main">
          {
            pageBreadcrumbs.length > 0 && (
              <nav class="breadcrumbs" aria-label={translate(pageLocale, "common.breadcrumbs")}>
                <div class="container breadcrumbs-inner">
                  {pageBreadcrumbs.map((item, index) => (
                    <>
                      {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
                      {index < pageBreadcrumbs.length - 1 && <span class="breadcrumb-separator" aria-hidden="true">/</span>}
                    </>
                  ))}
                </div>
              </nav>
            )
          }
          <slot />
        </main>
        {layoutVariant !== "workspace" && <Footer locale={pageLocale} />}
      </div>
    </div>
  <ImageLightbox />
  <CookieNotice locale={pageLocale} />
  <script>
    import { installImageLightbox } from "../lib/media/lightbox";
    import { installAppIcons } from "../lib/appIcons";
    installImageLightbox();
    installAppIcons(document);
    window.dispatchEvent(new CustomEvent("sitecraft-shell-ready", { detail: { stage: 8 } }));
  </script>
    <script is:inline>
      (() => {
        const shell = document.querySelector(".mac-app-shell");
        const toggle = document.querySelector(".mac-sidebar-toggle");
        if (!(shell instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;

        const setCollapsed = (collapsed) => {
          shell.classList.toggle("is-sidebar-collapsed", collapsed);
          toggle.innerHTML = collapsed
            ? '<i data-lucide="panel-left-open" aria-hidden="true"></i>'
            : '<i data-lucide="panel-left-close" aria-hidden="true"></i>';
          window.dispatchEvent(new CustomEvent("app-icons-refresh"));
          toggle.setAttribute("aria-label", collapsed ? "Открыть боковое меню" : "Скрыть боковое меню");
          toggle.setAttribute("aria-expanded", String(!collapsed));
          localStorage.setItem("sitecraft-sidebar-collapsed", collapsed ? "true" : "false");
        };

        setCollapsed(localStorage.getItem("sitecraft-sidebar-collapsed") === "true");
        toggle.addEventListener("click", () => setCollapsed(!shell.classList.contains("is-sidebar-collapsed")));
      })();
    </script>
  </body>
</html>
