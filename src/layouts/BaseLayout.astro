---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ImageLightbox from "../components/media/ImageLightbox.astro";
import CookieNotice from "../components/CookieNotice.astro";
import { DEAL_FINDER_ENABLED, SITE_DESCRIPTION, SITE_NAME, SITE_URL } from "../lib/config";
import { DEFAULT_LOCALE, LOCALE_COOKIE, LOCALE_TAGS, SUPPORTED_LOCALES, resolveRequestLocale, type Locale } from "../i18n/locales";
import { getMessages } from "../i18n/messages";
import { getUiPhraseMap, translateUiData } from "../i18n/uiTranslator";
import "../styles/global.css";
import "../styles/promotions.css";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: Array<{ href?: string; label: string }>;
  noindex?: boolean;
  locale?: Locale;
};

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  canonicalPath,
  image = "/sitecraft-logo.png",
  jsonLd,
  breadcrumbs,
  noindex = false,
  locale: localeProp,
} = Astro.props;
const locale = localeProp ?? resolveRequestLocale(Astro.url, Astro.cookies.get(LOCALE_COOKIE)?.value);
const messages = getMessages(locale);
const uiPhraseMap = getUiPhraseMap(locale);
const pageTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const siteUrl = SITE_URL || "https://automarket.sitecraft.agency";
const canonicalPathname = canonicalPath ?? Astro.url.pathname;
const localeUrl = (targetLocale: Locale) => {
  const url = new URL(canonicalPathname, siteUrl);
  if (targetLocale !== DEFAULT_LOCALE) url.searchParams.set("lang", targetLocale);
  return url.toString();
};
const canonicalUrl = localeUrl(locale);
const imageUrl = new URL(image, siteUrl).toString();
const buildSha = import.meta.env.PUBLIC_BUILD_SHA || import.meta.env.CF_PAGES_COMMIT_SHA || "local";
const buildTimestamp = import.meta.env.PUBLIC_BUILD_TIMESTAMP || new Date().toISOString();
const buildEnvironment =
  import.meta.env.PUBLIC_BUILD_ENVIRONMENT
  || import.meta.env.ENVIRONMENT
  || (import.meta.env.CF_PAGES_BRANCH ? "cloudflare-pages" : "local");
const labelBySegment: Record<string, string> = {
  admin: messages.navModeration,
  auth: messages.navLogin,
  cars: messages.navCars,
  dashboard: messages.navDashboard,
  detail: "Автомобиль",
  edit: "Редактирование",
  google: "Google",
  listings: "Мои объявления",
  login: messages.navLogin,
  moderation: messages.navModeration,
  "deal-finder": "Deal Finder",
  new: "Новое объявление",
  privacy: messages.navPrivacy,
  register: messages.navRegister,
  sell: messages.navSell,
  support: messages.navSupport,
};
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isWorkspacePath = pathname === "/dashboard"
  || pathname.startsWith("/dashboard/")
  || pathname === "/admin"
  || pathname.startsWith("/admin/");
const shellNavItems = [
  { href: "/", label: messages.navHome, short: "H" },
  { href: "/cars", label: messages.navCars, short: "A" },
  { href: "/dashboard", label: messages.navDashboard, short: "D" },
  ...(DEAL_FINDER_ENABLED
    ? [{ href: "/dashboard/deal-finder", label: "Deal Finder", short: "DF", dealFinderOnly: true }]
    : []),
  { href: "/sell", label: messages.navSell, short: "+" },
  { href: "/pricing", label: messages.navPricing, short: "€" },
  { href: "/admin/moderation", label: messages.navModeration, short: "✓", adminOnly: true },
];
const getShellNavClass = (href: string) => {
  const normalizedHref = href.replace(/\/$/, "") || "/";

  if (normalizedHref === "/") {
    return pathname === "/" ? "mac-sidebar-link is-active" : "mac-sidebar-link";
  }

  return pathname === normalizedHref || pathname.startsWith(`${normalizedHref}/`)
    ? "mac-sidebar-link is-active"
    : "mac-sidebar-link";
};
const generatedBreadcrumbs =
  pathname === "/"
    ? []
    : [
        { href: "/", label: messages.navHome },
        ...pathname
          .split("/")
          .filter(Boolean)
          .map((segment, index, segments) => {
            const href = `/${segments.slice(0, index + 1).join("/")}`;
            const isLast = index === segments.length - 1;
            const label =
              isLast && title && title !== SITE_NAME
                ? title
                : labelBySegment[segment] || decodeURIComponent(segment).replaceAll("-", " ");

            return {
              href: isLast ? undefined : href,
              label,
            };
          }),
      ];
const pageBreadcrumbs = breadcrumbs ?? generatedBreadcrumbs;
const defaultSchemaItems = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "SiteCraft Agency",
    url: "https://sitecraft.agency",
    logo: new URL("/sitecraft-logo.png", siteUrl).toString(),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_NAME,
    url: siteUrl,
    potentialAction: {
      "@type": "SearchAction",
      target: `${new URL("/cars", siteUrl).toString()}?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
];
const schemaItems = [
  ...defaultSchemaItems,
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
const localizedSchemaItems = translateUiData(schemaItems, locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="hl6ai62kYZBVuSHXumUNoaL4SJ5f0Shbdeda_Mf_s1I" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="sitecraft-build-sha" content={buildSha} />
    <meta name="sitecraft-build-timestamp" content={buildTimestamp} />
    <meta name="sitecraft-build-environment" content={buildEnvironment} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalUrl} />
    {SUPPORTED_LOCALES.map((code) => <link rel="alternate" hreflang={LOCALE_TAGS[code]} href={localeUrl(code)} />)}
    <link rel="alternate" hreflang="x-default" href={localeUrl(DEFAULT_LOCALE)} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{pageTitle}</title>
    {
      localizedSchemaItems.map((item) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("sitecraft-theme");
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = savedTheme || systemTheme;
      })();
    </script>
    <script is:inline define:vars={{ uiPhraseMap }}>
      (() => {
        const initializeI18n = () => {
        const translations = uiPhraseMap || {};
        const activeLocale = document.documentElement.lang;
        const ignored = new Set(["SCRIPT", "STYLE", "CODE", "PRE", "TEXTAREA"]);
        const attributes = ["alt", "aria-label", "data-close-label", "data-open-label", "placeholder", "title"];
        const translate = (value) => {
          if (!value || !/[А-Яа-яЁё]/u.test(value)) return value;
          const normalized = value.replace(/\s+/gu, " ").trim();
          const dynamicPatterns = [
            [/^(\d+) (?:день|дня|дней)$/u, { de: (n) => `${n} Tage`, en: (n) => `${n} days`, uk: (n) => `${n} днів` }],
            [/^(\d+) кредит(?:ов|а)?$/u, { de: (n) => `${n} Credits`, en: (n) => `${n} credits`, uk: (n) => `${n} кредитів` }],
            [/^До (\d+) активных объявлений$/u, { de: (n) => `Bis zu ${n} aktive Anzeigen`, en: (n) => `Up to ${n} active listings`, uk: (n) => `До ${n} активних оголошень` }],
            [/^(\d+) AI-кредитов каждый месяц$/u, { de: (n) => `${n} AI-Credits pro Monat`, en: (n) => `${n} AI credits every month`, uk: (n) => `${n} AI-кредитів щомісяця` }],
            [/^Приоритет дилера: (\d+)$/u, { de: (n) => `Händlerpriorität: ${n}`, en: (n) => `Dealer priority: ${n}`, uk: (n) => `Пріоритет дилера: ${n}` }],
            [/^(\d+(?:[.,]\d+)? €) \/ мес\.$/u, { de: (n) => `${n} / Monat`, en: (n) => `${n} / month`, uk: (n) => `${n} / міс.` }],
          ];
          for (const [pattern, handlers] of dynamicPatterns) {
            const match = normalized.match(pattern);
            const handler = handlers[activeLocale];
            if (match && handler) return `${value.match(/^\s*/u)?.[0] || ""}${handler(...match.slice(1))}${value.match(/\s*$/u)?.[0] || ""}`;
          }
          const suffix = " | SiteCraft Auto Market";
          const source = normalized.endsWith(suffix) ? normalized.slice(0, -suffix.length) : normalized;
          const phrase = translations[source];
          const translated = phrase ? `${phrase}${normalized.endsWith(suffix) ? suffix : ""}` : undefined;
          if (!translated) return value;
          return `${value.match(/^\s*/u)?.[0] || ""}${translated}${value.match(/\s*$/u)?.[0] || ""}`;
        };
        const shouldSkip = (element) => Boolean(element?.closest?.("[data-i18n-skip]"));
        const translateElement = (element) => {
          if (!(element instanceof Element) || shouldSkip(element)) return;
          for (const name of attributes) {
            if (!element.hasAttribute(name)) continue;
            const value = element.getAttribute(name) || "";
            const translated = translate(value);
            if (translated !== value) element.setAttribute(name, translated);
          }
        };
        const translateTree = (root) => {
          if (root instanceof Element) translateElement(root);
          const walker = document.createTreeWalker(root, NodeFilter.SHOW_ELEMENT | NodeFilter.SHOW_TEXT);
          let node;
          while ((node = walker.nextNode())) {
            if (node instanceof Element) {
              translateElement(node);
              continue;
            }
            const parent = node.parentElement;
            if (!parent || ignored.has(parent.tagName) || shouldSkip(parent)) continue;
            const translated = translate(node.nodeValue || "");
            if (translated !== node.nodeValue) node.nodeValue = translated;
          }
        };
        translateTree(document.body);
        new MutationObserver((mutations) => {
          for (const mutation of mutations) {
            if (mutation.type === "characterData") {
              const node = mutation.target;
              const parent = node.parentElement;
              if (!parent || ignored.has(parent.tagName) || shouldSkip(parent)) continue;
              const translated = translate(node.nodeValue || "");
              if (translated !== node.nodeValue) node.nodeValue = translated;
              continue;
            }
            mutation.addedNodes.forEach((node) => translateTree(node));
          }
        }).observe(document.body, { childList: true, subtree: true, characterData: true });

        const localizeLinks = (root) => {
          const links = root instanceof HTMLAnchorElement ? [root] : root.querySelectorAll?.("a[href]") || [];
          for (const link of links) {
            if (!(link instanceof HTMLAnchorElement)) continue;
            const rawHref = link.getAttribute("href") || "";
            if (!rawHref || rawHref.startsWith("#") || /^(?:mailto:|tel:|javascript:)/iu.test(rawHref)) continue;
            const url = new URL(link.href, window.location.href);
            if (url.origin !== window.location.origin || url.pathname.startsWith("/api/")) continue;
            url.searchParams.set("lang", activeLocale);
            link.href = `${url.pathname}${url.search}${url.hash}`;
          }
        };
        localizeLinks(document);
        new MutationObserver((mutations) => {
          for (const mutation of mutations) mutation.addedNodes.forEach((node) => {
            if (node instanceof Element) localizeLinks(node);
          });
        }).observe(document.body, { childList: true, subtree: true });
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initializeI18n, { once: true });
        } else {
          initializeI18n();
        }
      })();
    </script>
  </head>
  <body>
    <div class:list={["mac-app-shell", isWorkspacePath ? "is-workspace-shell" : "is-public-shell"]}>
      <aside class="mac-sidebar" aria-label={messages.navigation}>
        <div class="mac-sidebar-top">
          <a class="mac-sidebar-brand" href="/" aria-label="SiteCraft Auto Market">
            <img src="/sitecraft-logo.png" alt="" width="38" height="38" decoding="async" />
            <strong>Auto Market</strong>
          </a>
          <button class="mac-sidebar-toggle" type="button" aria-label={messages.sidebarClose} aria-expanded="true" data-open-label={messages.sidebarOpen} data-close-label={messages.sidebarClose}>‹</button>
        </div>
        <nav class="mac-sidebar-nav" aria-label={messages.siteSections}>
          {
            shellNavItems.map((item) => (
              <a
                class={getShellNavClass(item.href)}
                href={item.href}
                aria-current={getShellNavClass(item.href).includes("is-active") ? "page" : undefined}
                data-short={item.short}
                data-admin-only={item.adminOnly ? "true" : undefined}
                data-deal-finder-only={item.dealFinderOnly ? "true" : undefined}
                hidden={item.adminOnly || item.dealFinderOnly}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <button class="button button-light mac-sidebar-theme theme-toggle" type="button" aria-label={messages.themeToggle} aria-pressed="false">
          <span aria-hidden="true">◐</span>
          <strong>{messages.theme}</strong>
        </button>
        <a class="mac-sidebar-cta" href="/dashboard/new">{messages.navAddListing}</a>
      </aside>
      <div class="mac-workspace">
        <Header locale={locale} />
        <main class="mac-main">
          {
            pageBreadcrumbs.length > 0 && (
              <nav class="breadcrumbs" aria-label={messages.breadcrumbs}>
                <div class="container breadcrumbs-inner">
                  {pageBreadcrumbs.map((item, index) => (
                    <>
                      {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
                      {index < pageBreadcrumbs.length - 1 && <span class="breadcrumb-separator" aria-hidden="true">/</span>}
                    </>
                  ))}
                </div>
              </nav>
            )
          }
          <slot />
        </main>
        <Footer locale={locale} />
      </div>
    </div>
  <ImageLightbox />
  <CookieNotice locale={locale} />
  <script>
    import { installImageLightbox } from "../lib/media/lightbox";
    installImageLightbox();
  </script>
    <script is:inline>
      (() => {
        const shell = document.querySelector(".mac-app-shell");
        const toggle = document.querySelector(".mac-sidebar-toggle");
        if (!(shell instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;

        const setCollapsed = (collapsed) => {
          shell.classList.toggle("is-sidebar-collapsed", collapsed);
          toggle.textContent = collapsed ? "›" : "‹";
          toggle.setAttribute("aria-label", collapsed ? toggle.dataset.openLabel || "Open sidebar" : toggle.dataset.closeLabel || "Close sidebar");
          toggle.setAttribute("aria-expanded", String(!collapsed));
          localStorage.setItem("sitecraft-sidebar-collapsed", collapsed ? "true" : "false");
        };

        setCollapsed(localStorage.getItem("sitecraft-sidebar-collapsed") === "true");
        toggle.addEventListener("click", () => setCollapsed(!shell.classList.contains("is-sidebar-collapsed")));
      })();
    </script>
  </body>
</html>
