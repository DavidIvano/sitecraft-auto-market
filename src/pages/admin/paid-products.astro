---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPaidPrice, paidProducts } from "../../lib/monetization";
---

<BaseLayout title="Платные продукты — прототип" description="Локальный каталог будущих платных продуктов" variant="workspace" noindex>
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">Admin · UI-прототип</p>
      <h1>Платные продукты</h1>
      <p class="lead">Это read-only макет из frontend-конфигурации. Xano CRUD и платёжный backend ещё не выпущены.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="admin-table">
        {paidProducts.map((product) => (
          <div class="admin-table-row">
            <strong>{product.name}</strong>
            <span>{product.slug}</span>
            <span>{formatPaidPrice(product)}</span>
            <span>Прототип</span>
          </div>
        ))}
      </div>
      <p class="form-message">Редактирование продуктов скрыто до появления защищённого Xano-контракта.</p>
    </div>
  </section>
</BaseLayout>
