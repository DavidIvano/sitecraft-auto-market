---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmptyState from "../components/states/EmptyState.astro";

export const prerender = false;

Astro.response.status = 404;
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---

<BaseLayout
  variant="public"
  title="Объявление не найдено"
  description="Запрошенное объявление не найдено или больше не опубликовано."
  noindex
>
  <section class="section system-state-section">
    <div class="container system-state-container">
      <EmptyState title="Объявление не найдено" text="Возможно, объявление снято с публикации, продано или адрес указан неверно." href="/cars" action="Перейти к автомобилям" icon="search" />
    </div>
  </section>
</BaseLayout>
