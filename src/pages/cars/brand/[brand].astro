---
import { isPublicListing } from "../../../lib/listingStatus";
import type { CarListing } from "../../../lib/types";
import { getApprovedCars } from "../../../lib/xano";
import { DEFAULT_LOCALE, getLocaleDefinition } from "../../../i18n/config.ts";
import { normalizeLocale } from "../../../i18n/locale.ts";
import {
  buildVehicleTaxonomy,
  findVehicleBrandFacet,
  isValidVehicleFacetSlug,
  normalizeVehicleFacetSlug,
} from "../../../lib/seo/vehicleTaxonomy";

export const prerender = false;

let rawBrand = String(Astro.params.brand ?? "").trim();
try {
  rawBrand = decodeURIComponent(rawBrand).trim();
} catch {
  rawBrand = "";
}
const brandSlug = normalizeVehicleFacetSlug(rawBrand);
if (!rawBrand || rawBrand.length > 100 || !isValidVehicleFacetSlug(brandSlug)) {
  Astro.response.status = 404;
  Astro.response.headers.set("Cache-Control", "no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
  return Astro.rewrite("/404");
}

let cars: CarListing[] = [];
try {
  cars = (await getApprovedCars({ requireConfigured: true })).filter(isPublicListing);
} catch {
  Astro.response.status = 503;
  Astro.response.headers.set("Cache-Control", "no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
  Astro.response.headers.set("Retry-After", "300");
  return Astro.rewrite("/service-unavailable");
}

const brand = findVehicleBrandFacet(buildVehicleTaxonomy(cars), brandSlug);
if (!brand) {
  Astro.response.status = 404;
  Astro.response.headers.set("Cache-Control", "no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
  return Astro.rewrite("/404");
}

const requestedLocale = normalizeLocale(Astro.url.searchParams.get("lang") || Astro.url.searchParams.get("locale"), { activeOnly: true });
const redirectLocale = requestedLocale && getLocaleDefinition(requestedLocale)?.isPublic ? requestedLocale : DEFAULT_LOCALE;
return Astro.redirect(`/${redirectLocale}/cars/brand/${brand.slug}/`, 308);
---
