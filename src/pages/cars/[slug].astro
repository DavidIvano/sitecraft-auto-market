---
import StatusBadge from "../../components/StatusBadge.astro";
import CarCard from "../../components/CarCard.astro";
import ContactSellerModal from "../../components/ContactSellerModal.astro";
import VehicleSpecsGrid from "../../components/VehicleSpecsGrid.astro";
import FavoriteButton from "../../components/cars/FavoriteButton.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_URL } from "../../lib/config";
import { getCarDetailImageUrls } from "../../lib/imageUrls";
import { isDisplayValue, maskVin, sanitizePublicDescription } from "../../lib/listingFields";
import { getStoredAiScores, hasStoredAiAnalysis, parseAiPayload } from "../../lib/aiScores";
import { formatCount, formatFirstRegistration, formatImportantDetail, formatOwnersCount, formatSellerType, formatTuvDetail } from "../../lib/listingDisplay";
import { getCarBySlug, getRelatedListingsBySlug, getSellerListingsBySlug } from "../../lib/xano";
import { API_ROUTES } from "../../lib/apiRoutes";
import type { CarListing } from "../../lib/types";
import { isPublicListing } from "../../lib/listingStatus";
import { isValidPublicCarSlug } from "../../lib/publicCar";
import { getActiveListingPromotion, parseApiDate } from "../../lib/promotions/model";
import { buildVehicleSeo } from "../../lib/seo/vehicleSeo";
import { shouldShowPublicViewCount } from "../../lib/listingViews";
import { getDetailMessages } from "../../i18n/detailMessages";
import { LOCALE_COOKIE, LOCALE_LABELS, LOCALE_TAGS, resolveRequestLocale, type Locale } from "../../i18n/locales";
import { getMessages, interpolate } from "../../i18n/messages";
import { normalizeBackendValue, translateBackendValue, type BackendValueField } from "../../i18n/backendValues";

export const prerender = false;

const locale = resolveRequestLocale(Astro.url, Astro.cookies.get(LOCALE_COOKIE)?.value, Astro.request.headers.get("accept-language"), Astro.request.headers.get("cf-ipcountry"));
const messages = getDetailMessages(locale);
const localeTag = LOCALE_TAGS[locale];
const localizedValue = (field: BackendValueField, value: unknown) =>
  isDisplayValue(value) ? translateBackendValue(field, value, locale) : "";

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "index, follow");
const rawSlug = typeof Astro.params.slug === "string" ? Astro.params.slug.trim() : "";
let slug = rawSlug;
try {
  slug = decodeURIComponent(rawSlug).trim();
} catch {
  slug = "";
}

if (!isValidPublicCarSlug(slug)) {
  Astro.response.status = 404;
  Astro.response.headers.set("Cache-Control", "no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
  return Astro.rewrite(`/404?lang=${encodeURIComponent(locale)}`);
}

let car: CarListing | null = null;
try {
  car = await getCarBySlug(slug, locale);
} catch (error) {
  Astro.response.status = 503;
  Astro.response.headers.set("Cache-Control", "no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
  Astro.response.headers.set("Retry-After", "300");
  return Astro.rewrite(`/service-unavailable?lang=${encodeURIComponent(locale)}`);
}

if (!car || !isPublicListing(car)) {
  Astro.response.status = 404;
  Astro.response.headers.set("Cache-Control", "no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
  return Astro.rewrite(`/404?lang=${encodeURIComponent(locale)}`);
}
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=300, stale-while-revalidate=86400");
Astro.response.headers.set("X-Robots-Tag", "index, follow");
const activePromotion = getActiveListingPromotion(car);
const isPremiumDetail = activePromotion?.promotion_type === "premium";
const premiumPromotionEndsAt = isPremiumDetail ? parseApiDate(activePromotion.ends_at)?.getTime() || 0 : 0;
if (premiumPromotionEndsAt > Date.now()) {
  const premiumCacheSeconds = Math.max(1, Math.min(300, Math.floor((premiumPromotionEndsAt - Date.now()) / 1000)));
  Astro.response.headers.set("Cache-Control", `public, max-age=0, s-maxage=${premiumCacheSeconds}, must-revalidate`);
}
const translationMeta = car.translation_meta;
const sourceLocale = translationMeta?.source_locale as Locale | undefined;
const translationNotice = translationMeta && sourceLocale && sourceLocale !== locale
  ? interpolate(
      translationMeta.used_fallback ? messages.translationFallback : messages.translationApplied,
      { language: LOCALE_LABELS[sourceLocale] || sourceLocale },
    )
  : "";

const getDescriptionFieldFromListing = (listing: CarListing, label: string) => {
  const expression = new RegExp(`^${label}:\\s*(.+)$`, "im");
  const match = String(listing.original_content?.description ?? listing.description ?? "").match(expression);
  return match?.[1]?.trim() || "";
};
const getListingBodyType = (listing: CarListing) =>
  listing.body_type || getDescriptionFieldFromListing(listing, "Кузов");
const getRelatedScore = (currentCar: CarListing, candidate: CarListing) => {
  let score = 0;
  if (candidate.brand === currentCar.brand) score += 5;
  if (candidate.model === currentCar.model) score += 3;
  if (getListingBodyType(candidate) && getListingBodyType(candidate) === getListingBodyType(currentCar)) score += 3;
  if (candidate.fuel_type === currentCar.fuel_type) score += 1;
  if (candidate.city === currentCar.city) score += 1;
  return score;
};

const [sellerResult, relatedResult] = await Promise.allSettled([
  getSellerListingsBySlug(slug, locale),
  getRelatedListingsBySlug(slug, locale),
]);
const sellerCars = (sellerResult.status === "fulfilled"
  ? sellerResult.value
  : car.seller_listings || [])
  .filter((candidate) => candidate.slug !== car.slug && isPublicListing(candidate))
  .slice(0, 6);
const sellerSlugs = new Set(sellerCars.map((candidate) => candidate.slug));
const relatedCars = (relatedResult.status === "fulfilled" ? relatedResult.value : [])
  .filter((candidate) => candidate.slug !== car.slug && !sellerSlugs.has(candidate.slug) && isPublicListing(candidate))
  .map((candidate) => ({ car: candidate, score: getRelatedScore(car, candidate) }))
  .filter((item) => item.score > 0)
  .sort((left, right) => right.score - left.score)
  .slice(0, 6)
  .map((item) => item.car);

const siteUrl = SITE_URL || "https://automarket.sitecraft.agency";
const xanoApiUrl = import.meta.env.PUBLIC_XANO_API_URL;
const formatter = new Intl.NumberFormat(localeTag, {
  style: "currency",
  currency: car.currency || "EUR",
  maximumFractionDigits: 0,
});

const toDate = (value?: string | number) => {
  if (!value) {
    return null;
  }

  const date =
    typeof value === "number" || /^\d+$/.test(String(value))
      ? new Date(Number(value))
      : new Date(value);

  return Number.isNaN(date.getTime()) ? null : date;
};

const createdAt = toDate(car.created_at);
const createdAtLabel = createdAt
  ? new Intl.DateTimeFormat(localeTag, {
      dateStyle: "medium",
      timeStyle: "short",
    }).format(createdAt)
  : messages.datePending;
const publicViewCount = new Intl.NumberFormat(localeTag).format(Number(car.views_total) || 0);
const publicViewText = shouldShowPublicViewCount(car.views_total)
  ? interpolate(messages.viewsCount, { count: publicViewCount })
  : messages.newListing;

const listingGalleryImages = getCarDetailImageUrls(car).slice(0, 8);
const galleryImages = listingGalleryImages.length > 0
  ? listingGalleryImages
  : ["/deal-finder-placeholder.svg"];
const galleryImage = galleryImages[0] ?? "";
const isSold = car.status === "sold" || car.moderation_status === "sold" || Boolean(car.sold_at);
const vehicleSeo = buildVehicleSeo(car, siteUrl);
const sellerTypeLabel = formatSellerType(car.seller_type, locale) || messages.privateSeller;
const staticSeller = car.seller && typeof car.seller === "object" ? car.seller : null;
const staticSellerName = String(staticSeller?.name || "").trim() || messages.carSeller;
const staticSellerType = formatSellerType(staticSeller?.type, locale) || sellerTypeLabel;
const staticSellerCity = String(staticSeller?.city || car.city || "").trim();
const staticSellerCount = Number(staticSeller?.active_listings_count) || 0;
const staticSellerContact = staticSeller?.contact || null;
const cleanSeoText = (value: unknown) => String(value ?? "")
  .split(/\r?\n/)
  .filter((line) => !/^(телефон|email|e-mail|продавец|vin)\s*:/i.test(line.trim()))
  .join(" ")
  .replace(/\s+/g, " ")
  .trim();
const safeCarDescription = typeof car.description === "string" ? car.description.trim() : "";
const seoDescriptionText = cleanSeoText(safeCarDescription);
const fallbackSeoTitle = interpolate(messages.buyIn, { brand: car.brand, model: car.model, year: car.year, city: car.city }).replace(/\s+/g, " ").trim();
const fallbackSeoDescription = `${car.brand} ${car.model}, ${car.year}, ${localizedValue("fuel_type", car.fuel_type)}, ${localizedValue("transmission", car.transmission)}, ${interpolate(messages.seoMileage, { value: car.mileage.toLocaleString(localeTag) })}, ${messages.price.toLocaleLowerCase(localeTag)} ${formatter.format(car.price)}.${seoDescriptionText ? ` ${seoDescriptionText}` : ""}`.slice(0, 260);
const pageTitle = String(car.seo_title || "").trim() || fallbackSeoTitle || car.title;
const description = String(car.seo_description || "").trim() || fallbackSeoDescription;

const parseJsonObject = parseAiPayload;

const parseTextList = (value: unknown) => {
  if (!value) {
    return [] as string[];
  }

  if (Array.isArray(value)) {
    return value.map((item) => String(item).trim()).filter(Boolean);
  }

  if (typeof value === "string") {
    try {
      const parsed = JSON.parse(value);
      if (Array.isArray(parsed)) {
        return parsed.map((item) => String(item).trim()).filter(Boolean);
      }
    } catch {
      return value
        .split(/\n|;/)
        .map((item) => item.trim())
        .filter(Boolean);
    }
  }

  return [];
};

const aiAnalysis = parseJsonObject(car.ai_analysis);
const aiPayload = parseJsonObject(car.ai_payload);
const getDescriptionField = (labels: string | string[]) => {
  const availableLabels = Array.isArray(labels) ? labels : [labels];
  for (const label of availableLabels) {
    const escapedLabel = label.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    const match = String(car.original_content?.description || car.description || "").match(new RegExp(`^${escapedLabel}:\\s*(.+)$`, "im"));
    const value = match?.[1]?.trim() || "";
    if (value && !/^(не указан|не указана|не указано|нет)$/i.test(value)) return value;
  }
  return "";
};
const firstDetailValue = (...values: unknown[]) =>
  values.map((value) => String(value ?? "").trim()).find((value) => value && !/^(не указан|не указана|не указано|нет)$/i.test(value)) || "";
const registrationValue = firstDetailValue(
  car.first_registration_date,
  car.first_registration,
  getDescriptionField(["Дата первой регистрации", "Первая регистрация"]),
);
const ownerCountValue = firstDetailValue(
  car.owners_count,
  car.owner_count,
  getDescriptionField(["Количество владельцев", "Владельцы"]),
);
const visibleOwnerCount = formatOwnersCount(ownerCountValue, locale);
const legacyTuvHuValue = firstDetailValue(
  car.tuv_hu,
  car.tuv_until,
  car.hu_until,
  aiPayload.tuv_hu,
  aiAnalysis.tuv_hu,
  getDescriptionField(["TÜV/HU", "TÜV", "HU"]),
);
const tuvHuValue = legacyTuvHuValue || formatTuvDetail(car.has_valid_tuv, car.tuv_valid_until, locale);
const vinMasked = firstDetailValue(car.vin_masked, maskVin(car.vin));
const conditionValue = firstDetailValue(car.vehicle_condition, car.condition, getDescriptionField(["Состояние автомобиля", "Состояние"]));
const sellerTypeValue = formatSellerType(car.seller_type || staticSeller?.type, locale);
const quickSpecItems = [
  { label: messages.year, value: Number(car.year) > 0 ? String(car.year) : "", icon: "calendar" },
  { label: messages.mileage, value: Number(car.mileage) > 0 ? `${Number(car.mileage).toLocaleString(localeTag)} ${messages.kilometre}` : "", icon: "route" },
  { label: messages.fuel, value: localizedValue("fuel_type", car.fuel_type), icon: "fuel" },
  { label: messages.transmission, value: localizedValue("transmission", car.transmission), icon: "settings-2" },
  { label: messages.city, value: firstDetailValue(car.city), icon: "map-pin" },
  { label: messages.condition, value: formatImportantDetail(localizedValue("vehicle_condition", conditionValue), locale), icon: "shield-check" },
  ...(registrationValue ? [{ label: messages.firstRegistration, value: formatFirstRegistration(registrationValue), icon: "calendar-check" }] : []),
  ...(((car.has_valid_tuv !== null && car.has_valid_tuv !== undefined) || Boolean(legacyTuvHuValue)) ? [{ label: "TÜV / HU", value: tuvHuValue, icon: "shield-check" }] : []),
].filter((item) => isDisplayValue(item.value));
const detailGroups = [
  {
    title: messages.mainData,
    items: [
      { label: messages.vehicleType, value: formatImportantDetail(localizedValue("vehicle_type", firstDetailValue(car.vehicle_type, getDescriptionField("Тип транспорта"))), locale), icon: "car-front" },
      { label: messages.brand, value: firstDetailValue(car.brand), icon: "badge" },
      { label: messages.model, value: firstDetailValue(car.model), icon: "car" },
      { label: messages.productionYear, value: Number(car.year) > 0 ? String(car.year) : "", icon: "calendar" },
      { label: messages.firstRegistration, value: registrationValue ? formatFirstRegistration(registrationValue) : messages.notProvided, icon: "calendar-check" },
      { label: messages.condition, value: formatImportantDetail(localizedValue("vehicle_condition", conditionValue), locale), icon: "shield-check" },
      { label: messages.sellerType, value: formatImportantDetail(sellerTypeValue, locale), icon: "user-round" },
    ],
  },
  {
    title: messages.priceLocation,
    items: [
      { label: messages.price, value: Number(car.price) > 0 ? formatter.format(car.price) : "", icon: "euro" },
      { label: messages.currency, value: firstDetailValue(car.currency), icon: "coins" },
      { label: messages.city, value: firstDetailValue(car.city), icon: "map-pin" },
      { label: messages.country, value: formatImportantDetail(localizedValue("country", car.country), locale), icon: "globe-2" },
    ],
  },
  {
    title: messages.engineTransmission,
    items: [
      { label: messages.fuel, value: formatImportantDetail(localizedValue("fuel_type", car.fuel_type), locale), icon: "fuel" },
      { label: messages.engineVolume, value: formatImportantDetail(firstDetailValue(car.engine_volume, getDescriptionField(["Объём двигателя", "Объем двигателя"])), locale), icon: "gauge" },
      { label: messages.transmission, value: formatImportantDetail(localizedValue("transmission", car.transmission), locale), icon: "settings-2" },
      { label: messages.drivetrain, value: formatImportantDetail(localizedValue("drivetrain", firstDetailValue(car.drivetrain, getDescriptionField("Привод"))), locale), icon: "activity" },
    ],
  },
  {
    title: messages.bodyCapacity,
    items: [
      { label: messages.body, value: formatImportantDetail(localizedValue("body_type", firstDetailValue(car.body_type, getDescriptionField("Кузов"))), locale), icon: "car-front" },
      { label: messages.color, value: formatImportantDetail(localizedValue("color", firstDetailValue(car.color, getDescriptionField("Цвет"))), locale), icon: "palette" },
      { label: messages.doors, value: formatImportantDetail(formatCount(firstDetailValue(car.doors, getDescriptionField("Двери")), "door", locale), locale), icon: "door-open" },
      { label: messages.seats, value: formatImportantDetail(formatCount(firstDetailValue(car.seats, getDescriptionField("Места")), "seat", locale), locale), icon: "users" },
    ],
  },
  {
    title: messages.mileageHistory,
    items: [
      { label: messages.mileage, value: Number(car.mileage) > 0 ? `${Number(car.mileage).toLocaleString(localeTag)} ${messages.kilometre}` : "", icon: "route" },
      { label: messages.owners, value: visibleOwnerCount || messages.notProvided, icon: "user-round" },
      { label: "TÜV / HU", value: tuvHuValue, icon: "shield-check" },
      { label: "VIN", value: vinMasked, icon: "scan-line" },
      { label: messages.publishedAt, value: createdAtLabel, icon: "calendar-plus" },
      { label: messages.updatedAt, value: car.updated_at && String(car.updated_at) !== String(car.created_at) ? (toDate(car.updated_at) ? new Intl.DateTimeFormat(localeTag, { dateStyle: "medium", timeStyle: "short" }).format(toDate(car.updated_at)!) : "") : "", icon: "refresh-cw" },
    ],
  },
].map((group) => ({
  ...group,
  items: group.items.filter((item) => isDisplayValue(item.value)),
})).filter((group) => group.items.length > 0);
const embeddedDetailLabels = [
  "Тип транспорта", "Кузов", "Объём двигателя", "Объем двигателя", "Привод", "Двери", "Места", "Цвет",
  "Количество владельцев", "Владельцы", "Дата первой регистрации", "Первая регистрация", "Состояние автомобиля",
  "Состояние", "Тип продавца", "TÜV/HU", "TÜV", "HU", "VIN", "Продавец", "Телефон", "Email", "E-mail",
];
const detailDescription = sanitizePublicDescription(car.description)
  .split(/\r?\n/)
  .filter((line) => !embeddedDetailLabels.some((label) => line.trim().toLocaleLowerCase("ru-RU").startsWith(`${label.toLocaleLowerCase("ru-RU")}:`)))
  .join("\n")
  .trim();
const imageAltTexts = parseTextList(car.image_alt_texts);
const storedAiScores = getStoredAiScores(car as Record<string, unknown>);
const aiScore = storedAiScores.listingQualityScore;
const photoScore = storedAiScores.photoQualityScore;
const trustScore = storedAiScores.trustScore;
const aiRecommendations = parseTextList(car.ai_recommendations ?? aiAnalysis.recommendations);
const aiWarnings = parseTextList(car.ai_warnings ?? aiAnalysis.warnings);
const aiMissingFields = parseTextList(car.ai_missing_fields ?? aiAnalysis.missing_fields);
const hasAiAnalysis = hasStoredAiAnalysis(car as Record<string, unknown>);
const detailMileage = Number(car.mileage || 0);
const detailYear = Number(car.year || 0);
const detailAge = Number.isFinite(detailYear) && detailYear > 0 ? Math.max(1, new Date().getFullYear() - detailYear) : 0;
const explicitAiHighlights = parseTextList(car.ai_highlights ?? aiPayload.ai_highlights ?? aiPayload.highlights);
const heuristicAiHighlights = [
  car.fuel_type ? `${messages.fuel}: ${localizedValue("fuel_type", car.fuel_type)}` : "",
  car.transmission ? `${messages.transmission}: ${localizedValue("transmission", car.transmission)}` : "",
  car.body_type ? `${messages.body}: ${localizedValue("body_type", car.body_type)}` : "",
  trustScore !== null && trustScore >= 80 ? messages.goodCompleteness : "",
  trustScore !== null && trustScore < 60 ? messages.dataNeedsClarification : "",
  detailAge > 0 && detailMileage > 0 && detailMileage / detailAge < 12000 && detailMileage < 180000 ? messages.lowMileage : "",
  normalizeBackendValue("fuel_type", car.fuel_type) === "diesel" ? messages.economicalDiesel : "",
];
const aiHighlights = [...new Set([...explicitAiHighlights, ...heuristicAiHighlights].map((item) => item.trim()).filter(Boolean))].slice(0, 7);
const listingViewPayload = {
  car_id: car.id,
  slug: car.slug,
  title: car.title,
  brand: car.brand,
  model: car.model,
  body_type: car.body_type,
  fuel_type: car.fuel_type,
  price: car.price,
  city: car.city,
};
const normalizeComparable = (value: unknown) => String(value || "").trim().toLowerCase();
const getSimilarityDetails = (candidate: CarListing) => {
  const reasons: string[] = [];
  let score = 0;

  if (normalizeComparable(candidate.brand) === normalizeComparable(car.brand)) {
    score += 3;
    reasons.push(messages.sameBrand);
  }

  if (normalizeComparable(candidate.body_type) && normalizeComparable(candidate.body_type) === normalizeComparable(car.body_type)) {
    score += 2;
    reasons.push(messages.similarBody);
  }

  if (normalizeComparable(candidate.fuel_type) === normalizeComparable(car.fuel_type)) {
    score += 2;
    reasons.push(messages.sameFuel);
  }

  if (normalizeComparable(candidate.city) === normalizeComparable(car.city)) {
    score += 1;
    reasons.push(messages.sameCity);
  }

  if (Math.abs(Number(candidate.year || 0) - Number(car.year || 0)) <= 3) {
    score += 1;
    reasons.push(messages.similarYear);
  }

  if (Number(candidate.price || 0) > 0 && Number(car.price || 0) > 0) {
    const priceRatio = Math.abs(Number(candidate.price) - Number(car.price)) / Math.max(Number(car.price), 1);
    if (priceRatio <= 0.2) {
      score += 2;
      reasons.push(messages.similarBudget);
    }
  }

  return {
    car: candidate,
    score,
    reason: reasons[0] || messages.similarListing,
  };
};
const similarCars = relatedCars
  .map(getSimilarityDetails)
  .filter((item) => item.score > 0)
  .sort((left, right) => right.score - left.score)
  .slice(0, 6);

const siteMessages = getMessages(locale);
---

<BaseLayout
  variant="public"
  title={pageTitle}
  description={description}
  canonicalPath={`/cars/${car.slug}`}
  image={vehicleSeo.imageUrl}
  jsonLd={[vehicleSeo.vehicle, vehicleSeo.offer, vehicleSeo.breadcrumb]}
  ogType="product"
  breadcrumbs={[
    { href: "/", label: siteMessages.navHome },
    { href: "/cars", label: siteMessages.navCars },
    { label: car.title },
  ]}
  locale={locale}
>
  <div class:list={["vehicle-detail-page", isPremiumDetail && "vehicle-detail-page-premium"]} data-promotion={isPremiumDetail ? "premium" : undefined}>
  {
    isPremiumDetail && (
      <div class="container car-detail-premium-intro">
        <aside class="car-detail-premium-banner" aria-label={`${siteMessages.promotionPremium}: ${messages.promoted}`}>
          <span class="car-detail-premium-identity">
            <i data-lucide="crown" aria-hidden="true"></i>
            <span><strong>{siteMessages.promotionPremium}</strong><small>{messages.promoted}</small></span>
          </span>
          <i class="car-detail-premium-gem" data-lucide="gem" aria-hidden="true"></i>
        </aside>
      </div>
    )
  }
  <section class="section car-detail-section">
    <div class="container detail-container">
      <article class:list={["detail-grid", "car-detail-grid", isSold && "car-detail-sold", isPremiumDetail && "car-detail-premium"]}>
        <div class="gallery car-slider" data-gallery>
          <div class="gallery-stage">
            {
              galleryImages.length > 1 && (
                <button class="gallery-nav gallery-prev" type="button" aria-label={messages.previousPhoto}><i data-lucide="chevron-left" aria-hidden="true"></i></button>
              )
            }
            <button
              class="gallery-main-button vehicle-image-trigger"
              type="button"
              data-lightbox-trigger
              data-lightbox-src={galleryImage}
              data-lightbox-sources={JSON.stringify(galleryImages)}
              data-lightbox-alt={car.title}
              aria-label={messages.fullscreenPhoto}
            >
              {
                <img
                  src={galleryImage}
                  alt={imageAltTexts[0] || vehicleSeo.imageAlt}
                  width="1200"
                  height="800"
                  fetchpriority="high"
                  decoding="async"
                />
              }
            </button>
            {
              galleryImages.length > 1 && (
                <button class="gallery-nav gallery-next" type="button" aria-label={messages.nextPhoto}><i data-lucide="chevron-right" aria-hidden="true"></i></button>
              )
            }
            <span class="gallery-count">{`1 / ${galleryImages.length}`}</span>
          </div>
          <div class="gallery-strip">
            {
              galleryImages.map((imageUrl, index) => (
                  <button
                    class={`gallery-thumb${index === 0 ? " is-active" : ""}`}
                    type="button"
                    data-slide-index={index}
                    data-slide-src={imageUrl}
                    aria-label={interpolate(messages.photoNumber, { count: index + 1 })}
                    aria-pressed={index === 0 ? "true" : "false"}
                  >
                    <img
                      src={imageUrl}
                      alt={imageAltTexts[index] || `${car.title}, ${interpolate(messages.photoNumber, { count: index + 1 }).toLocaleLowerCase(localeTag)}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                ))
            }
          </div>
        </div>
        <div class="detail-panel compact-detail-panel">
          {isPremiumDetail && <div class="detail-promotion-disclosure"><span class="promotion-badge"><i data-lucide="crown" aria-hidden="true"></i>{siteMessages.promotionPremium}</span><span>{messages.promoted}</span></div>}
          <StatusBadge status={car.status} locale={locale} />
          {isSold && <span class="sold-detail-badge">{messages.sold}</span>}
          <h1 data-i18n-skip>{car.title}</h1>
          <p class="detail-public-meta">
            <span>{`${messages.publishedAt}: ${createdAtLabel}`}</span>
            <span class="detail-public-views" aria-label={publicViewText}>
              <i data-lucide="eye" aria-hidden="true"></i>
              <span>{publicViewText}</span>
            </span>
          </p>
          <p class="detail-price">{formatter.format(car.price)}</p>
          <FavoriteButton listingId={car.id} initialSaved={Boolean(car.is_saved)} source="car_detail" class="detail-favorite-button" locale={locale} />
          <VehicleSpecsGrid items={quickSpecItems} class="detail-spec-grid detail-quick-spec-grid" />
          <a class="button button-primary full-width detail-contact-jump" href="#seller-information">{messages.contactSeller}</a>
        </div>
      </article>
    </div>
  </section>
  {
    detailGroups.length > 0 && (
      <section class="section detail-properties-section" aria-labelledby="all-car-specs">
        <div class="container">
          <div class="detail-properties-panel">
            <div class="section-heading compact-section-heading">
              <div>
                <p class="eyebrow">{messages.characteristics}</p>
                <h2 id="all-car-specs">{messages.allSpecs}</h2>
              </div>
            </div>
            <div class="detail-properties-groups">
              {detailGroups.map((group) => (
                <section class="detail-property-group">
                  <h3>{group.title}</h3>
                  <VehicleSpecsGrid items={group.items} class="detail-property-grid" />
                </section>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }
  <section class="section detail-description-section" aria-labelledby="seller-description">
    <div class="container">
      <div class="detail-description-panel">
        <div class="section-heading compact-section-heading">
          <div>
            <p class="eyebrow">{messages.fromSeller}</p>
            <h2 id="seller-description">{messages.description}</h2>
          </div>
        </div>
        {translationNotice && <p class="translation-disclosure" role="status">{translationNotice}</p>}
        <p class="detail-description" data-i18n-skip={detailDescription ? "true" : undefined}>{detailDescription || messages.noDescription}</p>
      </div>
    </div>
  </section>
  {
    aiHighlights.length > 0 && (
      <section class="section ai-highlights-section">
        <div class="container">
          <div class="ai-highlights-panel">
            <div class="section-heading compact-section-heading">
              <div>
                <p class="eyebrow">AI Highlights</p>
                <h2>{messages.aiSaw}</h2>
              </div>
            </div>
            <div class="ai-highlight-chips">
              {aiHighlights.map((highlight) => <span class="ai-highlight-chip">{highlight}</span>)}
            </div>
            <p class="ai-microcopy">{messages.aiHighlightsDisclaimer}</p>
          </div>
        </div>
      </section>
    )
  }
  {
    hasAiAnalysis && (
      <section class="section ai-analysis-section">
        <div class="container">
          <div class="ai-analysis-panel detail-ai-analysis">
            <div class="section-heading compact-section-heading">
              <div>
                <h2>{messages.aiAnalysis}</h2>
                <p class="section-subtitle">{messages.aiAnalysisLead}</p>
              </div>
            </div>
            <div class="ai-analysis-grid">
              <article>
                <span>{messages.listingQuality}</span>
                <strong>{aiScore !== null ? `${aiScore}/100` : messages.notCalculated}</strong>
              </article>
              <article>
                <span>{messages.photoQuality}</span>
                <strong>{photoScore !== null ? `${photoScore}/100` : messages.notCalculated}</strong>
              </article>
              <article>
                <span>{messages.dataTrust}</span>
                <strong>{trustScore !== null ? `${trustScore}/100` : messages.notCalculated}</strong>
              </article>
              <article>
                <span>{messages.reviewStatus}</span>
                <strong>{aiMissingFields.length ? messages.needsClarification : messages.dataComplete}</strong>
              </article>
            </div>
            <div class="ai-analysis-notes">
              <div>
                <h3>{messages.sellerRecommendations}</h3>
                {aiRecommendations.length ? (
                  <ul>{aiRecommendations.slice(0, 5).map((item) => <li>{item}</li>)}</ul>
                ) : (
                  <p>{messages.noCriticalRecommendations}</p>
                )}
              </div>
              <div>
                <h3>{messages.warnings}</h3>
                {aiWarnings.length || aiMissingFields.length ? (
                  <ul>
                    {[...aiWarnings, ...aiMissingFields.map((field) => interpolate(messages.clarifyField, { value: field }))].slice(0, 6).map((item) => <li>{item}</li>)}
                  </ul>
                ) : (
                  <p>{messages.noSeriousWarnings}</p>
                )}
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }
  <section class="section seller-information-section" id="seller-information">
    <div class="container">
      <section
        class="seller-summary-card"
        data-seller-summary
        data-api-url={xanoApiUrl}
        data-detail-path={API_ROUTES.carBySlug(car.slug)}
        data-label-dealer={messages.dealer}
        data-label-private={messages.privateSeller}
        data-label-active-listings={messages.activeListings}
        data-label-seller={messages.seller}
        data-label-no-contact={messages.noPublicContact}
      >
        <p class="eyebrow">{messages.seller}</p>
        <h2 data-seller-name data-i18n-skip>{staticSellerName}</h2>
        <div class="seller-summary-meta">
          <span data-seller-type>{staticSellerType}</span>
          {staticSellerCity && <span data-seller-city>{staticSellerCity}</span>}
          <span data-seller-count hidden={!staticSellerCount}>{staticSellerCount ? interpolate(messages.shortListings, { count: staticSellerCount }) : ""}</span>
        </div>
        <ContactSellerModal sellerName={staticSellerName} listingTitle={car.title} contact={staticSellerContact} locale={locale} />
      </section>
    </div>
  </section>
  {
    sellerCars.length > 0 && (
      <section class="section seller-listings-section">
        <div class="container">
          <div class="section-heading compact-section-heading seller-listings-heading">
            <div>
              <p class="eyebrow">{messages.seller}</p>
              <h2>{messages.otherSellerCars}</h2>
            </div>
            <span>{interpolate(messages.availableCount, { count: sellerCars.length })}</span>
          </div>
          <div class="seller-listings-grid" aria-label={messages.otherSellerCars}>
            {sellerCars.map((sellerCar) => <CarCard car={sellerCar} source="seller_listings" locale={locale} />)}
          </div>
        </div>
      </section>
    )
  }
  {
    similarCars.length > 0 && (
      <section class="section related-cars-section">
        <div class="container">
          <div class="section-heading compact-section-heading">
            <h2>{messages.similarCars}</h2>
          </div>
          <div class="similar-cars-grid" aria-label={messages.similarCars}>
            {similarCars.map(({ car: similarCar, reason }) => (
              <div class="similar-car-card-unified" data-similar-slug={similarCar.slug}>
                <CarCard car={similarCar} source="similar_cars" locale={locale} />
                <span class="similarity-reason">{reason}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }
  </div>
  <script
    is:inline
    type="application/json"
    id="listing-view-data"
    data-api-url={xanoApiUrl}
    data-analytics-path={API_ROUTES.listingViewAnalytics}
    data-auth-analytics-path={API_ROUTES.myListingViewAnalytics}
    set:html={JSON.stringify(listingViewPayload)}
  ></script>
  <script>
    import { getOrCreateSessionId } from "../../lib/analytics/session";
    import { getAuthToken } from "../../lib/authClient";
    import { installPublicCarCardInteractions, refreshPublicCarCardIcons } from "../../lib/publicCarCardsClient";

    installPublicCarCardInteractions();

    const sellerSummary = document.querySelector("[data-seller-summary]");
    const loadSellerSummary = async () => {
      if (!(sellerSummary instanceof HTMLElement)) return;

      const apiUrl = sellerSummary.dataset.apiUrl || "";
      const detailPath = sellerSummary.dataset.detailPath || "";
      if (!apiUrl || !detailPath) return;

      try {
        const response = await fetch(`${apiUrl}${detailPath}`, { cache: "no-store" });
        if (!response.ok) return;
        const payload = await response.json();
        const seller = payload && typeof payload === "object" ? payload.seller : null;
        if (!seller || typeof seller !== "object") return;

        const name = sellerSummary.querySelector("[data-seller-name]");
        const type = sellerSummary.querySelector("[data-seller-type]");
        const city = sellerSummary.querySelector("[data-seller-city]");
        const count = sellerSummary.querySelector("[data-seller-count]");
        const note = sellerSummary.querySelector("[data-seller-contact-note]");

        if (name instanceof HTMLElement && typeof seller.name === "string" && seller.name.trim()) {
          name.textContent = seller.name.trim();
        }
        if (type instanceof HTMLElement && typeof seller.type === "string") {
          type.textContent = seller.type === "dealer" ? sellerSummary.dataset.labelDealer || "Dealer" : sellerSummary.dataset.labelPrivate || "Private seller";
        }
        if (city instanceof HTMLElement && typeof seller.city === "string" && seller.city.trim()) {
          city.textContent = seller.city.trim();
        }
        const activeCount = Number(seller.active_listings_count);
        if (count instanceof HTMLElement && Number.isInteger(activeCount) && activeCount > 0) {
          count.textContent = (sellerSummary.dataset.labelActiveListings || "{count} active listings").replace("{count}", String(activeCount));
          count.hidden = false;
        }

        const legacyHref = typeof seller.contact?.href === "string" ? seller.contact.href.trim() : "";
        const rawPhoneValue = typeof seller.contact?.phone === "string" ? seller.contact.phone.trim() : "";
        const rawEmailValue = typeof seller.contact?.email === "string" ? seller.contact.email.trim().toLowerCase() : "";
        const phoneValue = /^\+[1-9]\d{7,14}$/.test(rawPhoneValue) ? rawPhoneValue : "";
        const emailValue = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(rawEmailValue) && !/[\r\n]/.test(rawEmailValue)
          ? rawEmailValue
          : "";
        const phoneHref = phoneValue
          ? `tel:${phoneValue}`
          : /^tel:\+[1-9]\d{7,14}$/i.test(legacyHref) ? legacyHref : "";
        const emailHref = emailValue
          ? `mailto:${emailValue}`
          : /^mailto:[^\s?@]+@[^\s?@]+\.[^\s?@]+$/i.test(legacyHref) ? legacyHref : "";
        const preferredMethod = seller.contact?.preferred_method === "phone" || seller.contact?.preferred_method === "email"
          ? seller.contact.preferred_method
          : "";
        const triggers = sellerSummary.querySelectorAll<HTMLElement>("[data-seller-contact-trigger]");
        if (phoneHref || emailHref) {
          triggers.forEach((trigger) => {
            trigger.dataset.phoneHref = phoneHref;
            trigger.dataset.emailHref = emailHref;
            trigger.dataset.contactPhoneValue = phoneValue;
            trigger.dataset.contactEmailValue = emailValue;
            trigger.dataset.preferredMethod = preferredMethod;
            trigger.dataset.sellerName = typeof seller.name === "string" ? seller.name.trim() : sellerSummary.dataset.labelSeller || "Seller";
            trigger.hidden = false;
          });
          if (note instanceof HTMLElement) note.hidden = true;
        } else {
          triggers.forEach((trigger) => {
            trigger.dataset.phoneHref = "";
            trigger.dataset.emailHref = "";
            trigger.dataset.contactPhoneValue = "";
            trigger.dataset.contactEmailValue = "";
            trigger.dataset.preferredMethod = "";
            trigger.hidden = true;
          });
          if (note instanceof HTMLElement) {
            note.textContent = sellerSummary.dataset.labelNoContact || "No public contact method.";
            note.hidden = false;
          }
        }
        refreshPublicCarCardIcons(sellerSummary);
      } catch {
        // Карточка остаётся полезной даже при временной недоступности контакта.
      }
    };

    loadSellerSummary();

    const RECENT_VIEWS_KEY = "sitecraft_recent_listing_views";
    const listingViewDataNode = document.querySelector("#listing-view-data");
    const readListingViewData = () => {
      if (!(listingViewDataNode instanceof HTMLScriptElement)) {
        return null;
      }

      try {
        return JSON.parse(listingViewDataNode.textContent || "{}") as Record<string, unknown>;
      } catch {
        return null;
      }
    };
    const listingViewData = readListingViewData();

    const saveRecentListingView = () => {
      if (!listingViewData) {
        return;
      }

      try {
        const existing = JSON.parse(localStorage.getItem(RECENT_VIEWS_KEY) || "[]");
        const list = Array.isArray(existing) ? existing : [];
        const nextItem = {
          car_id: listingViewData.car_id,
          slug: listingViewData.slug,
          title: listingViewData.title,
          brand: listingViewData.brand,
          model: listingViewData.model,
          body_type: listingViewData.body_type,
          fuel_type: listingViewData.fuel_type,
          price: listingViewData.price,
          city: listingViewData.city,
          viewed_at: new Date().toISOString(),
        };
        const deduped = list.filter((item) => String(item?.slug || "") !== String(nextItem.slug || ""));
        localStorage.setItem(RECENT_VIEWS_KEY, JSON.stringify([nextItem, ...deduped].slice(0, 20)));
      } catch (error) {
        console.warn("Recent listing view was not saved", error);
      }
    };

    let listingViewPending = false;
    let listingViewCompleted = false;

    const sendListingView = async (url: string, authToken: string, payload: Record<string, unknown>, attempt = 0): Promise<void> => {
      try {
        const response = await fetch(url, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            ...(authToken ? { Authorization: `Bearer ${authToken}` } : {}),
          },
          body: JSON.stringify(payload),
          keepalive: true,
        });
        if (response.ok) {
          const viewKey = `sitecraft_listing_view_v2:${payload.car_id}:${payload.slug}`;
          sessionStorage.setItem(viewKey, String(Date.now()));
          listingViewCompleted = true;
        } else if (response.status !== 404 && import.meta.env.DEV) {
          console.debug("Listing view analytics failed", response.status);
        }
      } catch (error) {
        if (attempt === 0) {
          await sendListingView(url, authToken, payload, 1);
        } else if (import.meta.env.DEV) {
          console.debug("Listing view analytics unavailable", error);
        }
      } finally {
        listingViewPending = false;
        listingViewCompleted = true;
      }
    };

    const trackListingView = () => {
      if (!listingViewData || !(listingViewDataNode instanceof HTMLElement)) {
        return;
      }

      const apiUrl = listingViewDataNode.dataset.apiUrl || "";
      const authToken = getAuthToken() || "";
      const analyticsPath = authToken
        ? listingViewDataNode.dataset.authAnalyticsPath || "/me/analytics/listing-view"
        : listingViewDataNode.dataset.analyticsPath || "/analytics/listing-view";

      if (!apiUrl) {
        return;
      }

      const hostname = window.location.hostname;
      const isCloudflarePreview = hostname.endsWith(".sitecraft-auto-market.pages.dev")
        && hostname !== "sitecraft-auto-market.pages.dev";
      if (isCloudflarePreview) {
        return;
      }

      const viewKey = `sitecraft_listing_view_v2:${listingViewData.car_id}:${listingViewData.slug}`;
      const lastTrackedAt = Number(sessionStorage.getItem(viewKey) || 0);
      if (listingViewPending || listingViewCompleted || (lastTrackedAt && Date.now() - lastTrackedAt < 86_400_000)) return;

      const payload = {
        car_id: listingViewData.car_id,
        slug: listingViewData.slug,
        session_id: getOrCreateSessionId(),
        source: document.referrer,
        viewed_at: new Date().toISOString(),
      };

      listingViewPending = true;
      void sendListingView(`${apiUrl}${analyticsPath}`, authToken, payload);
    };

    saveRecentListingView();
    let visibleTimer = 0;
    const scheduleListingView = () => {
      window.clearTimeout(visibleTimer);
      if (document.visibilityState !== "visible") return;
      visibleTimer = window.setTimeout(() => {
        if (document.visibilityState === "visible") trackListingView();
      }, 2_000);
    };
    document.addEventListener("visibilitychange", scheduleListingView);
    scheduleListingView();

    const galleryImages = Array.from(document.querySelectorAll(".gallery-thumb"))
      .map((thumb) => thumb instanceof HTMLElement ? thumb.dataset.slideSrc || thumb.querySelector("img")?.currentSrc || "" : "")
      .filter(Boolean);
    const openButton = document.querySelector<HTMLElement>("[data-lightbox-trigger]");
    const mainImage = document.querySelector(".gallery-main-button img");
    const galleryCount = document.querySelector(".gallery-count");
    const prevButton = document.querySelector(".gallery-prev");
    const nextButton = document.querySelector(".gallery-next");
    let activeSlideIndex = 0;

    const updateSlide = (nextIndex: number) => {
      if (galleryImages.length === 0) {
        return;
      }

      activeSlideIndex = (nextIndex + galleryImages.length) % galleryImages.length;
      const imageUrl = galleryImages[activeSlideIndex];

      if (mainImage instanceof HTMLImageElement) {
        mainImage.src = imageUrl;
      }

      if (openButton) {
        openButton.dataset.lightboxSrc = imageUrl;
      }

      if (galleryCount instanceof HTMLElement) {
        galleryCount.textContent = `${activeSlideIndex + 1} / ${galleryImages.length}`;
      }

      document.querySelectorAll(".gallery-thumb").forEach((thumb) => {
        if (thumb instanceof HTMLElement) {
          const isActive = thumb.dataset.slideIndex === String(activeSlideIndex);
          thumb.classList.toggle("is-active", isActive);
          thumb.setAttribute("aria-pressed", String(isActive));
        }
      });
    };

    prevButton?.addEventListener("click", () => updateSlide(activeSlideIndex - 1));
    nextButton?.addEventListener("click", () => updateSlide(activeSlideIndex + 1));

    document.querySelectorAll(".gallery-thumb").forEach((button) => {
      button.addEventListener("click", () => {
        if (button instanceof HTMLElement) {
          updateSlide(Number(button.dataset.slideIndex || 0));
        }
      });
    });

  </script>
</BaseLayout>
