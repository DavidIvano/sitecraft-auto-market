---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isSelectableLocale } from "../../i18n/locales";
import { isValidPublicCarSlug } from "../../lib/publicCar";

export const prerender = false;

const rawSlug = Astro.url.searchParams.get("slug")?.trim() || "";
let slug = rawSlug;
try {
  slug = decodeURIComponent(rawSlug).trim();
} catch {
  slug = "";
}

if (isValidPublicCarSlug(slug)) {
  const requestedLocale = Astro.url.searchParams.get("lang") || Astro.url.searchParams.get("locale");
  return Astro.redirect(
    `/cars/${encodeURIComponent(slug)}/${isSelectableLocale(requestedLocale) ? `?lang=${encodeURIComponent(requestedLocale)}` : ""}`,
    301,
  );
}

Astro.response.status = 404;
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---

<BaseLayout title="Автомобиль не найден" variant="public" breadcrumbs={[]} noindex>
  <section class="section car-detail-section">
    <div class="container detail-container">
      <div class="empty-state">
        <h1>Автомобиль не найден</h1>
        <p>Проверьте ссылку или вернитесь в каталог.</p>
        <a class="button button-dark" href="/cars">Вернуться в каталог</a>
      </div>
    </div>
  </section>
</BaseLayout>
