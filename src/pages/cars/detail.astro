---
import BaseLayout from "../../layouts/BaseLayout.astro";

const xanoApiUrl = import.meta.env.PUBLIC_XANO_API_URL;
const placeholderApiUrl = "https://your-xano-api-url.com/api:YOUR_GROUP";
---

<BaseLayout title="Автомобиль" variant="public" breadcrumbs={[]}>
  <section class="section car-detail-section">
    <div class="container detail-container">
      <div
        id="live-car-detail"
        data-api-url={xanoApiUrl}
        data-placeholder-url={placeholderApiUrl}
      >
        <div class="detail-skeleton" aria-label="Загружаю автомобиль">
          <div class="skeleton-gallery"></div>
          <div class="skeleton-panel">
            <span></span>
            <strong></strong>
            <i></i>
            <div>
              <b></b>
              <b></b>
              <b></b>
              <b></b>
            </div>
            <em></em>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const root = document.querySelector("#live-car-detail");

    const escapeHtml = (value: unknown) =>
      String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    const formatPrice = (price: unknown, currency: string) =>
      new Intl.NumberFormat("ru-RU", {
        style: "currency",
        currency: currency || "EUR",
        maximumFractionDigits: 0,
      }).format(Number(price || 0));

    const toDate = (value: unknown) => {
      if (!value) {
        return null;
      }

      const stringValue = String(value);
      const date = typeof value === "number" || /^\d+$/.test(stringValue)
        ? new Date(Number(value))
        : new Date(stringValue);

      return Number.isNaN(date.getTime()) ? null : date;
    };

    const formatDate = (value: unknown) => {
      const date = toDate(value);

      if (!date) {
        return "дата уточняется";
      }

      return new Intl.DateTimeFormat("ru-RU", {
        dateStyle: "medium",
        timeStyle: "short",
      }).format(date);
    };

    const parseStringArray = (value: unknown): string[] => {
      if (Array.isArray(value)) {
        return value.filter((item): item is string => typeof item === "string" && item.length > 0);
      }

      if (typeof value === "string" && value.trim()) {
        try {
          return parseStringArray(JSON.parse(value));
        } catch {
          return value.startsWith("http") ? [value] : [];
        }
      }

      return [];
    };

    const normalizeSlug = (value: unknown) => {
      const rawSlug = String(value ?? "").trim();

      if (!rawSlug) {
        return "";
      }

      try {
        return decodeURIComponent(rawSlug).trim();
      } catch {
        return rawSlug;
      }
    };

    const normalizeCarsPayload = (payload: unknown): Record<string, unknown>[] => {
      if (Array.isArray(payload)) {
        return payload.filter((item): item is Record<string, unknown> => Boolean(item) && typeof item === "object");
      }

      if (!payload || typeof payload !== "object") {
        return [];
      }

      const record = payload as Record<string, unknown>;
      const candidate = [record.items, record.result, record.data, record.records].find(Array.isArray);

      return Array.isArray(candidate)
        ? candidate.filter((item): item is Record<string, unknown> => Boolean(item) && typeof item === "object")
        : [];
    };

    const fetchCarBySlug = async (apiUrl: string, slug: string) => {
      const normalizedSlug = normalizeSlug(slug);

      const directResponse = await fetch(`${apiUrl}/cars/${encodeURIComponent(normalizedSlug)}`);

      if (directResponse.ok) {
        return directResponse.json();
      }

      const listResponse = await fetch(`${apiUrl}/cars`);

      if (!listResponse.ok) {
        throw new Error("Cars list not available");
      }

      const cars = normalizeCarsPayload(await listResponse.json());
      const car = cars.find(
        (candidate) => normalizeSlug(candidate.slug).toLowerCase() === normalizedSlug.toLowerCase(),
      );

      if (!car) {
        throw new Error("Car not found");
      }

      return car;
    };

    const getMetadataImageUrl = (value: unknown) => {
      if (!value || typeof value !== "object") {
        return "";
      }

      const metadata = value as Record<string, unknown>;
      const candidate = metadata.url || metadata.public_url || metadata.image_url || metadata.src;
      return typeof candidate === "string" && candidate.startsWith("http") ? candidate : "";
    };

    const getCarImageUrls = (car: Record<string, unknown>) => {
      const images = Array.isArray(car.images) ? car.images : [];
      const candidates = [
        car.cover_image_url,
        car.main_image_url,
        ...parseStringArray(car.image_urls),
        ...images.map((image: { image_url?: string; image?: { url?: string }; image_metadata?: unknown }) =>
          image.image_url || image.image?.url || getMetadataImageUrl(image.image_metadata),
        ),
      ].filter(Boolean) as string[];

      return [...new Set(candidates)].slice(0, 8);
    };

    const isSold = (car: Record<string, unknown>) =>
      car.status === "sold" || car.moderation_status === "sold" || Boolean(car.sold_at);

    const renderStatusBadge = (car: Record<string, unknown>) => {
      if (isSold(car)) {
        return `<span class="status-badge status-sold">Продано</span><span class="sold-detail-badge">Автомобиль уже продан</span>`;
      }

      return `<span class="status-badge status-approved">Проверено</span>`;
    };

    const normalizePhoneHref = (phone: unknown) => {
      const cleanPhone = String(phone ?? "").replace(/[^\d+]/g, "");
      return cleanPhone ? `tel:${cleanPhone}` : "";
    };

    const renderEmpty = (title: string, text: string) => {
      if (!(root instanceof HTMLElement)) {
        return;
      }

      root.innerHTML = `
        <div class="empty-state">
          <h1>${escapeHtml(title)}</h1>
          <p>${escapeHtml(text)}</p>
          <a class="button button-dark" href="/cars">Вернуться в каталог</a>
        </div>
      `;
    };

    if (root instanceof HTMLElement) {
      const apiUrl = root.dataset.apiUrl;
      const placeholderUrl = root.dataset.placeholderUrl;
      const slugFromQuery = new URLSearchParams(window.location.search).get("slug");
      const slugFromPath = window.location.pathname.match(/^\/cars\/([^/]+)\/?$/)?.[1];
      const slug = slugFromQuery || (slugFromPath && slugFromPath !== "detail" ? decodeURIComponent(slugFromPath) : "");

      if (!slug) {
        renderEmpty("Автомобиль не найден", "В ссылке нет slug объявления.");
      } else if (!apiUrl || apiUrl === placeholderUrl) {
        renderEmpty("Сервис временно недоступен", "Попробуйте открыть объявление немного позже.");
      } else {
        fetchCarBySlug(apiUrl, slug)
          .then((car) => {
            const galleryImages = getCarImageUrls(car);
            const galleryImage = galleryImages[0] || "";
            const contactHref =
              normalizePhoneHref(car.seller_phone) ||
              (car.seller_email ? `mailto:${encodeURIComponent(String(car.seller_email))}` : "");
            const contactLabel = car.seller_phone
              ? `Связаться: ${escapeHtml(car.seller_phone)}`
              : car.seller_email
                ? `Написать: ${escapeHtml(car.seller_email)}`
                : "Контакты не указаны";

            root.innerHTML = `
              <nav class="breadcrumbs live-detail-breadcrumbs" aria-label="Хлебные крошки">
                <div class="breadcrumbs-inner">
                  <a href="/">Главная</a>
                  <span class="breadcrumb-separator" aria-hidden="true">/</span>
                  <a href="/cars">Авто</a>
                  <span class="breadcrumb-separator" aria-hidden="true">/</span>
                  <span aria-current="page">${escapeHtml(car.title)}</span>
                </div>
              </nav>
              <article class="detail-grid car-detail-grid${isSold(car) ? " car-detail-sold" : ""}">
                <div class="gallery car-slider" data-gallery>
                  <div class="gallery-stage">
                    ${
                      galleryImages.length > 1
                        ? `<button class="gallery-nav gallery-prev" type="button" aria-label="Предыдущее фото"><i data-lucide="chevron-left" aria-hidden="true"></i></button>`
                        : ""
                    }
                    <button class="gallery-main-button vehicle-image-trigger" type="button" data-lightbox-trigger data-lightbox-src="${escapeHtml(galleryImage)}" data-lightbox-sources="${escapeHtml(JSON.stringify(galleryImages))}" data-lightbox-alt="${escapeHtml(car.title)}" aria-label="Открыть фото на весь экран">
                      ${
                        galleryImage
                          ? `<img src="${escapeHtml(galleryImage)}" alt="${escapeHtml(car.title)}" decoding="async" />`
                          : `<div class="gallery-empty">Фото пока не добавлено</div>`
                      }
                    </button>
                    ${
                      galleryImages.length > 1
                        ? `<button class="gallery-nav gallery-next" type="button" aria-label="Следующее фото"><i data-lucide="chevron-right" aria-hidden="true"></i></button>`
                        : ""
                    }
                    <span class="gallery-count">${galleryImages.length > 0 ? `1 / ${galleryImages.length}` : "0 / 0"}</span>
                  </div>
                  <div class="gallery-strip">
                    ${
                      galleryImages.length > 0
                        ? galleryImages
                            .map((imageUrl: string, index: number) => `<button class="gallery-thumb${index === 0 ? " is-active" : ""}" type="button" data-slide-index="${index}" aria-label="Фото ${index + 1}" aria-pressed="${index === 0}"><img src="${escapeHtml(imageUrl)}" alt="${escapeHtml(`${car.title}, фото ${index + 1}`)}" loading="lazy" decoding="async"></button>`)
                            .join("")
                        : "<span></span><span></span><span></span><span></span><span></span>"
                    }
                  </div>
                </div>
                <div class="detail-panel compact-detail-panel">
                  ${renderStatusBadge(car)}
                  <h1>${escapeHtml(car.title)}</h1>
                  <p class="detail-price">${formatPrice(car.price, car.currency)}</p>
                  <dl class="spec-grid detail-spec-grid">
                    <div><dt>Год</dt><dd>${escapeHtml(car.year)}</dd></div>
                    <div><dt>Пробег</dt><dd>${Number(car.mileage || 0).toLocaleString("ru-RU")} км</dd></div>
                    <div><dt>Топливо</dt><dd>${escapeHtml(car.fuel_type)}</dd></div>
                    <div><dt>Коробка</dt><dd>${escapeHtml(car.transmission)}</dd></div>
                    <div><dt>Город</dt><dd>${escapeHtml(car.city)}, ${escapeHtml(car.country)}</dd></div>
                    <div><dt>Добавлено</dt><dd>${formatDate(car.created_at)}</dd></div>
                  </dl>
                  <p class="detail-description">${escapeHtml(car.description)}</p>
                  ${
                    contactHref
                      ? `<a class="button button-dark full-width" href="${contactHref}">${contactLabel}</a>`
                      : `<button class="button button-dark full-width" type="button" disabled>${contactLabel}</button>`
                  }
                </div>
              </article>
            `;

            let activeSlideIndex = 0;
            const mainImage = root.querySelector(".gallery-main-button img");
            const mainButton = root.querySelector(".gallery-main-button");
            const galleryCount = root.querySelector(".gallery-count");
            const prevButton = root.querySelector(".gallery-prev");
            const nextButton = root.querySelector(".gallery-next");

            const updateSlide = (nextIndex: number) => {
              if (galleryImages.length === 0) {
                return;
              }

              activeSlideIndex = (nextIndex + galleryImages.length) % galleryImages.length;
              const imageUrl = galleryImages[activeSlideIndex];

              if (mainImage instanceof HTMLImageElement) {
                mainImage.src = imageUrl;
              }

              if (mainButton instanceof HTMLElement) {
                mainButton.dataset.fullscreenImage = imageUrl;
                mainButton.dataset.lightboxSrc = imageUrl;
              }

              if (galleryCount instanceof HTMLElement) {
                galleryCount.textContent = `${activeSlideIndex + 1} / ${galleryImages.length}`;
              }

              root.querySelectorAll(".gallery-thumb").forEach((thumb) => {
                if (thumb instanceof HTMLElement) {
                  const isActive = thumb.dataset.slideIndex === String(activeSlideIndex);
                  thumb.classList.toggle("is-active", isActive);
                  thumb.setAttribute("aria-pressed", String(isActive));
                }
              });
            };

            prevButton?.addEventListener("click", () => updateSlide(activeSlideIndex - 1));
            nextButton?.addEventListener("click", () => updateSlide(activeSlideIndex + 1));

            root.querySelectorAll(".gallery-thumb").forEach((button) => {
              button.addEventListener("click", () => {
                if (button instanceof HTMLElement) {
                  updateSlide(Number(button.dataset.slideIndex || 0));
                }
              });
            });

          })
          .catch((error) => {
            console.error(error);
            renderEmpty("Автомобиль не найден", "Объявление не опубликовано или ещё не прошло модерацию.");
          });
      }
    }
  </script>
</BaseLayout>
