---
import CarCard from "../../components/CarCard.astro";
import SearchBar from "../../components/SearchBar.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getApprovedCars } from "../../lib/xano";
import { sortPromotedCars } from "../../lib/monetization";
import { SITE_URL } from "../../lib/config";
import { API_ROUTES } from "../../lib/apiRoutes";
import { getCreditActionPolicy } from "../../lib/credits/model";
import {
  getBuyerSearchCriteriaFromParams,
  getBuyerSearchMatchReasons,
} from "../../lib/buyer-search/model";
import type { CarListing } from "../../lib/types";
import { isPublicListing } from "../../lib/listingStatus";

let cars: CarListing[] = [];
const xanoApiUrl = import.meta.env.PUBLIC_XANO_API_URL;
const placeholderApiUrl = "https://your-xano-api-url.com/api:YOUR_GROUP";
const siteUrl = SITE_URL || "https://automarket.sitecraft.agency";
const searchParams = Astro.url.searchParams;
const initialCriteria = getBuyerSearchCriteriaFromParams(searchParams);
const aiSearchPolicy = getCreditActionPolicy("ai_search_intent");

try {
  const xanoCars = await getApprovedCars();
  cars = sortPromotedCars(xanoCars.filter(isPublicListing));
} catch {
  cars = [];
}

const getFieldFromDescription = (car: CarListing, label: string) => {
  const expression = new RegExp(`^${label}:\\s*(.+)$`, "im");
  const match = car.description?.match(expression);
  return match?.[1]?.trim() || "";
};

const getBodyType = (car: CarListing) => car.body_type || getFieldFromDescription(car, "Кузов");
const getVehicleType = (car: CarListing) => {
  const explicit = car.vehicle_type || getFieldFromDescription(car, "Тип транспорта");

  if (explicit && explicit !== "не указан") {
    return explicit;
  }

  if (/электро/i.test(car.fuel_type || "")) {
    return "Электромобиль";
  }

  if (/фургон|пикап/i.test(getBodyType(car))) {
    return "Коммерческий транспорт";
  }

  return "Легковой автомобиль";
};

const normalize = (value: unknown) => String(value || "").trim().toLowerCase();
const serverFilters = {
  vehicleType: normalize(searchParams.get("vehicle_type")),
  bodyType: normalize(searchParams.get("body_type")),
  brand: normalize(searchParams.get("brand")),
  model: normalize(searchParams.get("model")),
  city: normalize(searchParams.get("city")),
  fuelType: normalize(searchParams.get("fuel_type")),
  transmission: normalize(searchParams.get("transmission")),
  priceMin: Number(searchParams.get("price_min") || 0),
  priceMax: Number(searchParams.get("price_max") || searchParams.get("price") || 0),
  yearMin: Number(searchParams.get("year_min") || 0),
  yearMax: Number(searchParams.get("year_max") || 0),
  mileageMax: Number(searchParams.get("mileage_max") || 0),
};
const selectedSort = searchParams.get("sort") || "newest";

const matchesServerFilters = (car: CarListing) =>
  (!serverFilters.vehicleType || normalize(getVehicleType(car)) === serverFilters.vehicleType) &&
  (!serverFilters.bodyType || normalize(getBodyType(car)) === serverFilters.bodyType) &&
  (!serverFilters.brand || normalize(car.brand) === serverFilters.brand) &&
  (!serverFilters.model || normalize(car.model).includes(serverFilters.model)) &&
  (!serverFilters.city || normalize(car.city).includes(serverFilters.city)) &&
  (!serverFilters.fuelType || normalize(car.fuel_type) === serverFilters.fuelType) &&
  (!serverFilters.transmission || normalize(car.transmission) === serverFilters.transmission) &&
  (!serverFilters.priceMin || Number(car.price || 0) >= serverFilters.priceMin) &&
  (!serverFilters.priceMax || Number(car.price || 0) <= serverFilters.priceMax) &&
  (!serverFilters.yearMin || Number(car.year || 0) >= serverFilters.yearMin) &&
  (!serverFilters.yearMax || Number(car.year || 0) <= serverFilters.yearMax) &&
  (!serverFilters.mileageMax || Number(car.mileage || 0) <= serverFilters.mileageMax);

const sortCarsByMode = (items: CarListing[], mode: string) =>
  [...items].sort((left, right) => {
    if (mode === "price_asc") {
      return Number(left.price || 0) - Number(right.price || 0);
    }

    if (mode === "price_desc") {
      return Number(right.price || 0) - Number(left.price || 0);
    }

    if (mode === "mileage_asc") {
      return Number(left.mileage || 0) - Number(right.mileage || 0);
    }

    return Number(right.created_at || 0) - Number(left.created_at || 0);
  });

cars = sortCarsByMode(cars.filter(matchesServerFilters), selectedSort);

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Автомобили",
  description: "Каталог опубликованных автомобилей SiteCraft Auto Market",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: cars.map((car, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/cars/${car.slug}`, siteUrl).toString(),
      name: car.title,
    })),
  },
};
---

<BaseLayout
  title="Автомобили"
  description="Каталог проверенных автомобилей SiteCraft Auto Market"
  canonicalPath="/cars"
  jsonLd={collectionSchema}
>
  <section class="section page-hero catalog-hero">
    <div class="container catalog-hero-grid">
      <div>
        <p class="eyebrow">Каталог автомобилей</p>
        <h1>Автомобили</h1>
        <p class="lead">Свежие проверенные объявления с фотографиями, ценами и быстрым поиском по главным параметрам.</p>
      </div>
      <div class="catalog-view-switch" aria-label="Вид каталога">
        <button class="is-active" type="button" data-catalog-view="grid" aria-pressed="true">Плитка</button>
        <button type="button" data-catalog-view="list" aria-pressed="false">Список</button>
      </div>
      <aside
        class="catalog-filter-panel"
        aria-label="Фильтры каталога"
        data-api-url={xanoApiUrl}
        data-ai-search-intent-path={API_ROUTES.aiSearchIntent}
        data-saved-searches-path={API_ROUTES.savedSearches}
      >
        <section class="ai-buyer-search-panel" aria-labelledby="ai-buyer-search-title">
          <div class="ai-buyer-search-copy">
            <span class="mac-badge mac-badge-blue">Умный подбор</span>
            <h2 id="ai-buyer-search-title">Найдите автомобиль одним запросом</h2>
            <p>Опишите задачу своими словами или сразу настройте параметры ниже.</p>
          </div>
          <form class="ai-buyer-search-form" id="ai-buyer-search-form">
            <label class="ai-search-input">
              <span>Запрос</span>
              <textarea id="ai-car-search-query" rows="2" placeholder="Например: семейный дизель до 7000 € рядом с Braunschweig"></textarea>
            </label>
            <div class="ai-buyer-search-actions">
              <button class="button button-dark" type="submit">Подобрать с AI · {aiSearchPolicy.cost} кредит</button>
              <button class="button button-light" type="button" id="ai-car-search-reset">Сбросить всё</button>
              <button class="button button-light" type="button" id="ai-car-search-save">Сохранить поиск</button>
            </div>
          </form>
          <p class="ai-search-privacy">Изменение фильтров и просмотр каталога бесплатны. {aiSearchPolicy.cost} AI-кредит списывается только после успешного AI-разбора; при ошибке применяется бесплатный базовый разбор.</p>
          <div class="ai-search-explanation" id="ai-search-explanation" hidden></div>
          <div class="ai-search-suggestions" id="ai-search-suggestions" hidden aria-label="Быстрые уточнения"></div>
          <section class="buyer-clarifications" id="buyer-search-clarifications" hidden aria-labelledby="buyer-clarifications-title">
            <div>
              <strong id="buyer-clarifications-title">Уточните выбор</strong>
              <span>Ответы сразу станут редактируемыми параметрами.</span>
            </div>
            <div class="buyer-clarification-list"></div>
          </section>
          <div class="ai-last-search" id="ai-last-search" hidden>
            <span></span>
            <button class="button button-light compact-button" type="button">Повторить</button>
          </div>
        </section>
        <section class="buyer-applied-criteria" id="buyer-applied-criteria" hidden aria-labelledby="buyer-applied-criteria-title">
          <div class="buyer-criteria-heading">
            <strong id="buyer-applied-criteria-title">Применённые параметры</strong>
            <span>Нажмите на параметр, чтобы убрать его.</span>
          </div>
          <div class="buyer-criteria-chips"></div>
        </section>
        <details class="buyer-criteria-editor" open={Object.keys(initialCriteria).length > 0}>
          <summary>
            <span>Все параметры</span>
            <strong>Настроить подбор вручную</strong>
          </summary>
          <SearchBar />
        </details>
      </aside>
    </div>
  </section>

  <section class="section catalog-results-section">
    <div class="container catalog-results-shell">
      <div class="catalog-results-toolbar">
        <div>
          <span>Результаты</span>
          <strong id="catalog-results-count">{cars.length} авто</strong>
        </div>
        <div class="catalog-toolbar-actions">
          <label class="catalog-sort-control">
            <span>Сортировка</span>
            <select id="catalog-sort" name="sort" aria-label="Сортировка каталога">
              <option value="newest" selected={selectedSort === "newest"}>Сначала новые</option>
              <option value="price_asc" selected={selectedSort === "price_asc"}>Дешевле</option>
              <option value="price_desc" selected={selectedSort === "price_desc"}>Дороже</option>
              <option value="mileage_asc" selected={selectedSort === "mileage_asc"}>Меньше пробег</option>
            </select>
          </label>
          <a class="button button-light compact-button" href="/sell">Продать авто</a>
        </div>
      </div>
      <div
        class="cards-grid catalog-grid"
        id="live-cars-grid"
        data-api-url={xanoApiUrl}
        data-placeholder-url={placeholderApiUrl}
      >
        {cars.map((car) => <CarCard car={car} matchReasons={getBuyerSearchMatchReasons(car, initialCriteria)} />)}
      </div>
      <div class="form-message live-cars-message" id="live-cars-message" hidden>
        <span id="live-cars-message-text">{cars.length > 0 ? "" : "Загружаю каталог автомобилей..."}</span>
        <button class="button button-light compact-button" id="live-cars-retry" type="button" hidden>
          Обновить каталог
        </button>
      </div>
      <section class="ai-recommended-section" id="ai-recommended-section" hidden aria-labelledby="ai-recommended-title">
        <div class="section-heading compact-section-heading">
          <div>
            <h2 id="ai-recommended-title">Похожие на то, что вы смотрели</h2>
            <p class="section-subtitle">На основе просмотров на этом сайте.</p>
          </div>
        </div>
        <div class="ai-recommended-grid" data-ai-recommended-grid></div>
      </section>
    </div>
  </section>

  <script>
    import { getAuthToken } from "../../lib/authClient";
    import { parseCarSearchIntent } from "../../lib/ai/parseCarSearchIntent";
    import { getOrCreateSessionId } from "../../lib/analytics/session";
    import { trackProductEvent } from "../../lib/analytics/events";
    import {
      BUYER_SEARCH_FILTER_KEYS,
      applyBuyerSearchCriteriaToParams,
      getBuyerSearchClarifications,
      getBuyerSearchCriteriaFromParams,
      getBuyerSearchCriteriaList,
      getBuyerSearchMatchReasons,
      getBuyerSearchRelaxations,
      normalizeBuyerSearchCriteria,
      type BuyerSearchCriteria,
    } from "../../lib/buyer-search/model";
    import { isPublicListing } from "../../lib/listingStatus";

    const grid = document.querySelector("#live-cars-grid");
    const message = document.querySelector("#live-cars-message");
    const messageText = document.querySelector("#live-cars-message-text");
    const retryButton = document.querySelector("#live-cars-retry");
    const searchForm = document.querySelector(".search-bar");
    const sortSelect = document.querySelector("#catalog-sort");
    const resultsCount = document.querySelector("#catalog-results-count");
    const viewButtons = document.querySelectorAll("[data-catalog-view]");
    const filterPanel = document.querySelector(".catalog-filter-panel");
    const aiSearchForm = document.querySelector("#ai-buyer-search-form");
    const aiSearchQuery = document.querySelector("#ai-car-search-query");
    const aiSearchReset = document.querySelector("#ai-car-search-reset");
    const aiSearchSave = document.querySelector("#ai-car-search-save");
    const aiSearchExplanation = document.querySelector("#ai-search-explanation");
    const aiSearchSuggestions = document.querySelector("#ai-search-suggestions");
    const aiLastSearch = document.querySelector("#ai-last-search");
    const appliedCriteria = document.querySelector("#buyer-applied-criteria");
    const appliedCriteriaChips = appliedCriteria?.querySelector(".buyer-criteria-chips");
    const clarifications = document.querySelector("#buyer-search-clarifications");
    const clarificationList = clarifications?.querySelector(".buyer-clarification-list");
    const filterReset = document.querySelector("#catalog-filter-reset");
    const aiRecommendedSection = document.querySelector("#ai-recommended-section");
    const aiRecommendedGrid = document.querySelector("[data-ai-recommended-grid]");
    const LAST_AI_SEARCH_KEY = "sitecraft_last_ai_search";
    const RECENT_VIEWS_KEY = "sitecraft_recent_listing_views";
    let latestCatalogCars: Array<Record<string, unknown>> = [];
    let activeRelaxations = getBuyerSearchRelaxations(getBuyerSearchCriteriaFromParams(new URLSearchParams(window.location.search)));

    const formatPrice = (price: unknown, currency: unknown) =>
      new Intl.NumberFormat("ru-RU", {
        style: "currency",
        currency: String(currency || "EUR"),
        maximumFractionDigits: 0,
      }).format(Number(price || 0));

    const escapeHtml = (value: unknown) =>
      String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    const normalizeCityLabel = (value: unknown) => {
      const city = String(value || "").trim();

      if (!city) {
        return "Не указан";
      }

      return city
        .split(/([\s-]+)/)
        .map((part) => (/^[\p{L}]/u.test(part) ? part.charAt(0).toLocaleUpperCase("ru-RU") + part.slice(1) : part))
        .join("");
    };

    const toDate = (value: unknown) => {
      if (!value) {
        return null;
      }

      const stringValue = String(value);
      const date = typeof value === "number" || /^\d+$/.test(stringValue)
        ? new Date(Number(value))
        : new Date(stringValue);

      return Number.isNaN(date.getTime()) ? null : date;
    };

    const parseStringArray = (value: unknown): string[] => {
      if (Array.isArray(value)) {
        return value.filter((item): item is string => typeof item === "string" && item.length > 0);
      }

      if (typeof value === "string" && value.trim()) {
        try {
          return parseStringArray(JSON.parse(value));
        } catch {
          return value.startsWith("http") ? [value] : [];
        }
      }

      return [];
    };

    const getImageMetadataVariantUrl = (value: unknown, variants: string[] = []) => {
      if (!value || typeof value !== "object") {
        return "";
      }

      const metadata = value as Record<string, unknown>;
      const variantUrls = variants
        .map((variant) => {
          const variantGroup = metadata.variants;
          if (!variantGroup || typeof variantGroup !== "object") {
            return "";
          }

          const variantValue = (variantGroup as Record<string, unknown>)[variant];
          return variantValue && typeof variantValue === "object"
            ? (variantValue as Record<string, unknown>).url
            : "";
        });

      const optimized = metadata.optimized;
      const optimizedUrl = optimized && typeof optimized === "object"
        ? (optimized as Record<string, unknown>).url
        : "";
      const url = [...variantUrls, optimizedUrl, metadata.url, metadata.public_url, metadata.image_url, metadata.src, metadata.path]
        .find((candidate) => typeof candidate === "string" && candidate.length > 0);

      return typeof url === "string" && url.startsWith("http") ? url : "";
    };

    const getCarCoverImageUrl = (car: Record<string, unknown>) => {
      const images = Array.isArray(car.images) ? car.images : [];
      const imageFromRows = images
        .map((image: { image_url?: string; image?: { url?: string }; image_metadata?: unknown }) =>
          getImageMetadataVariantUrl(image.image_metadata, ["card", "thumb", "detail"]) || image.image_url || image.image?.url
        )
        .find(Boolean);

      return String(car.cover_image_url || car.main_image_url || parseStringArray(car.image_urls)[0] || imageFromRows || "");
    };

    const isFutureDate = (value: unknown) => {
      if (!value) {
        return false;
      }

      const date = toDate(value);
      return Boolean(date && date.getTime() > Date.now());
    };

    const getPromotionScore = (car: Record<string, unknown>) => {
      const dealerPlan = String(car.dealer_plan || "");

      return (
        (isFutureDate(car.homepage_until) ? 1000 : 0) +
        (isFutureDate(car.featured_until) ? 700 : 0) +
        (isFutureDate(car.boosted_until) ? 400 : 0) +
        (dealerPlan === "business" ? 25 : dealerPlan === "pro" ? 20 : dealerPlan === "basic" ? 10 : 0)
      );
    };

    const promotedFirst = (cars: Array<Record<string, unknown>>) =>
      [...cars].sort((left, right) => {
        const promotionDiff = getPromotionScore(right) - getPromotionScore(left);

        if (promotionDiff !== 0) {
          return promotionDiff;
        }

        const leftTime = toDate(left.created_at)?.getTime() ?? 0;
        const rightTime = toDate(right.created_at)?.getTime() ?? 0;
        return rightTime - leftTime;
      });

    const setCatalogView = (view: string) => {
      if (!(grid instanceof HTMLElement)) {
        return;
      }

      const isList = view === "list";
      grid.classList.toggle("catalog-grid-list", isList);
      viewButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) {
          return;
        }

        const isActive = button.dataset.catalogView === view;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
      });
      localStorage.setItem("sitecraft-catalog-view", view);
    };

    viewButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (button instanceof HTMLButtonElement) {
          setCatalogView(button.dataset.catalogView || "grid");
        }
      });
    });

    setCatalogView(localStorage.getItem("sitecraft-catalog-view") || "grid");

    const renderPaidBadges = (car: Record<string, unknown>) => {
      const badges = [
        isFutureDate(car.homepage_until) && "Премиум",
        isFutureDate(car.featured_until) && "Выделенное",
        isFutureDate(car.boosted_until) && "Вверху",
        car.is_ai_generated && "Создано с AI",
        (car.dealer_verified || car.dealer_plan === "business") && "Проверенный дилер",
        !(car.dealer_verified || car.dealer_plan === "business") &&
          (car.dealer_plan === "pro" || car.dealer_plan === "basic") &&
          "Дилер",
      ].filter(Boolean);

      if (badges.length === 0) {
        return "";
      }

      return badges
        .map((badge) => `<span class="paid-badge${badge === "Создано с AI" ? " paid-badge-ai" : ""}">${escapeHtml(badge)}</span>`)
        .join("");
    };

    const isSold = (car: Record<string, unknown>) =>
      car.status === "sold" || car.moderation_status === "sold" || Boolean(car.sold_at);

    const renderStatusBadge = (car: Record<string, unknown>) => {
      if (isSold(car)) {
        return `<span class="status-badge status-sold">Продано</span>`;
      }

      return `<span class="status-badge status-approved">Проверено</span>`;
    };

    const renderAiMini = (car: Record<string, unknown>) => {
      const candidates = [car.trust_score, car.listing_quality_score, car.ai_listing_score, car.ai_scan_score];
      const score = candidates.reduce<number | null>((result, value) => {
        if (result !== null || value === null || value === undefined || (typeof value === "string" && !value.trim())) return result;
        const numeric = typeof value === "number" ? value : Number(value);
        return Number.isFinite(numeric) ? Math.max(0, Math.min(100, Math.round(numeric))) : null;
      }, null);
      if (score === null) return "";
      const tone = score >= 85 ? "good" : score >= 65 ? "medium" : "low";

      return `
        <div class="ai-analysis-mini ai-analysis-mini-${tone} ai-trust-badge" aria-label="AI качество объявления ${score}%" title="AI-оценка показывает качество заполнения объявления, а не техническое состояние автомобиля.">
          <span>AI</span>
          <strong>${score}%</strong>
        </div>
      `;
    };

    const normalizeText = (value: unknown) => String(value || "").trim().toLocaleLowerCase("ru-RU");

    const renderSmartBadges = (car: Record<string, unknown>) => {
      const mileage = Number(car.mileage || 0);
      const year = Number(car.year || 0);
      const age = Number.isFinite(year) && year > 0 ? Math.max(1, new Date().getFullYear() - year) : 0;
      const bodyType = normalizeText(car.body_type);
      const seats = Number(car.seats || 0);
      const badges = [
        (seats >= 5 || seats === 0) && /(универсал|минивэн|внедорожник|suv|кроссовер)/i.test(bodyType) ? "Семейный авто" : "",
        normalizeText(car.fuel_type) === "дизель" ? "Экономичный дизель" : "",
        age > 0 && mileage > 0 && mileage / age < 12000 && mileage < 180000 ? "Низкий пробег" : "",
      ].filter(Boolean);

      return badges
        .map((badge) => `<span class="ai-smart-badge" title="Оценка основана на данных объявления.">${escapeHtml(badge)}</span>`)
        .join("");
    };

    const getFieldFromDescription = (car: Record<string, unknown>, label: string) => {
      const expression = new RegExp(`^${label}:\\\\s*(.+)$`, "im");
      const match = String(car.description || "").match(expression);
      return match?.[1]?.trim() || "";
    };

    const getBodyType = (car: Record<string, unknown>) =>
      String(car.body_type || getFieldFromDescription(car, "Кузов") || "");

    const getVehicleType = (car: Record<string, unknown>) => {
      const explicit = String(car.vehicle_type || getFieldFromDescription(car, "Тип транспорта") || "");

      if (explicit && explicit !== "не указан") {
        return explicit;
      }

      if (/электро/i.test(String(car.fuel_type || ""))) {
        return "Электромобиль";
      }

      if (/фургон|пикап/i.test(getBodyType(car))) {
        return "Коммерческий транспорт";
      }

      return "Легковой автомобиль";
    };

    const getActiveCriteria = () => getBuyerSearchCriteriaFromParams(new URLSearchParams(window.location.search));

    const getActiveFilters = () => {
      const criteria = getActiveCriteria();
      return {
        vehicleType: String(criteria.vehicle_type || "").toLowerCase(),
        bodyType: String(criteria.body_type || "").toLowerCase(),
        brand: String(criteria.brand || "").toLowerCase(),
        model: String(criteria.model || "").toLowerCase(),
        city: String(criteria.city || "").toLowerCase(),
        fuelType: String(criteria.fuel_type || "").toLowerCase(),
        transmission: String(criteria.transmission || "").toLowerCase(),
        priceMin: Number(criteria.price_min || 0),
        priceMax: Number(criteria.price_max || 0),
        yearMin: Number(criteria.year_min || 0),
        yearMax: Number(criteria.year_max || 0),
        mileageMax: Number(criteria.mileage_max || 0),
      };
    };

    const syncSearchFormFromUrl = () => {
      if (!(searchForm instanceof HTMLFormElement)) {
        return;
      }

      const params = new URLSearchParams(window.location.search);

      BUYER_SEARCH_FILTER_KEYS.forEach((name) => {
        const field = searchForm.elements.namedItem(name);
        const value = params.get(name) || (name === "price_max" ? params.get("price") : "") || "";

        if (
          field instanceof HTMLInputElement || field instanceof HTMLSelectElement
        ) {
          field.value = value;
        }
      });
    };

    const replaceCriteriaInUrl = (criteria: BuyerSearchCriteria) => {
      const params = applyBuyerSearchCriteriaToParams(
        new URLSearchParams(window.location.search),
        criteria,
        { replace: true },
      );
      if (sortSelect instanceof HTMLSelectElement && sortSelect.value !== "newest") {
        params.set("sort", sortSelect.value);
      }
      window.history.replaceState({}, "", params.toString() ? `${window.location.pathname}?${params.toString()}` : window.location.pathname);
      syncSearchFormFromUrl();
      renderAppliedCriteria();
    };

    const renderAppliedCriteria = () => {
      if (!(appliedCriteria instanceof HTMLElement) || !(appliedCriteriaChips instanceof HTMLElement)) return;
      const items = getBuyerSearchCriteriaList(getActiveCriteria());
      appliedCriteria.hidden = items.length === 0;
      appliedCriteriaChips.innerHTML = items.map((item) => `
        <button class="buyer-criteria-chip" type="button" data-remove-criterion="${item.key}" aria-label="Убрать параметр ${escapeHtml(item.label)}: ${escapeHtml(item.value)}">
          <span>${escapeHtml(item.label)}</span>
          <strong>${escapeHtml(item.value)}</strong>
          <span aria-hidden="true">×</span>
        </button>
      `).join("");
    };

    const renderClarifications = (query: string, criteria: BuyerSearchCriteria) => {
      if (!(clarifications instanceof HTMLElement) || !(clarificationList instanceof HTMLElement)) return;
      const items = getBuyerSearchClarifications(query, criteria);
      clarifications.hidden = items.length === 0;
      clarificationList.innerHTML = items.map((item) => `
        <fieldset class="buyer-clarification-item">
          <legend>${escapeHtml(item.question)}</legend>
          <div>
            ${item.options.map((option) => `<button class="ai-search-chip" type="button" data-clarification-id="${escapeHtml(item.id)}" data-clarification-changes="${escapeHtml(JSON.stringify(option.changes))}">${escapeHtml(option.label)}</button>`).join("")}
          </div>
        </fieldset>
      `).join("");
      if (items.length > 0) {
        trackProductEvent("buyer_search_clarification_shown", { count: items.length, criteria_count: getBuyerSearchCriteriaList(criteria).length });
      }
    };

    const matchesActiveFilters = (car: Record<string, unknown>) => {
      const filters = getActiveFilters();

      return (
        (!filters.vehicleType || getVehicleType(car).toLowerCase() === filters.vehicleType) &&
        (!filters.bodyType || getBodyType(car).toLowerCase() === filters.bodyType) &&
        (!filters.brand || String(car.brand || "").toLowerCase() === filters.brand) &&
        (!filters.model || String(car.model || "").toLowerCase().includes(filters.model)) &&
        (!filters.city || String(car.city || "").toLowerCase().includes(filters.city)) &&
        (!filters.fuelType || String(car.fuel_type || "").toLowerCase() === filters.fuelType) &&
        (!filters.transmission || String(car.transmission || "").toLowerCase() === filters.transmission) &&
        (!filters.priceMin || Number(car.price || 0) >= filters.priceMin) &&
        (!filters.priceMax || Number(car.price || 0) <= filters.priceMax) &&
        (!filters.yearMin || Number(car.year || 0) >= filters.yearMin) &&
        (!filters.yearMax || Number(car.year || 0) <= filters.yearMax) &&
        (!filters.mileageMax || Number(car.mileage || 0) <= filters.mileageMax)
      );
    };

    const sortCars = (cars: Record<string, unknown>[]) => {
      const mode = sortSelect instanceof HTMLSelectElement ? sortSelect.value : "newest";

      return [...cars].sort((left, right) => {
        if (mode === "price_asc") {
          return Number(left.price || 0) - Number(right.price || 0);
        }

        if (mode === "price_desc") {
          return Number(right.price || 0) - Number(left.price || 0);
        }

        if (mode === "mileage_asc") {
          return Number(left.mileage || 0) - Number(right.mileage || 0);
        }

        return Number(right.created_at || 0) - Number(left.created_at || 0);
      });
    };

    const renderCarImage = (car: Record<string, unknown>) => {
      const imageUrl = getCarCoverImageUrl(car);

      if (imageUrl) {
        return `
          <button class="vehicle-image-trigger car-card-image-button" type="button" data-lightbox-trigger data-lightbox-src="${escapeHtml(imageUrl)}" data-lightbox-sources="${escapeHtml(JSON.stringify([imageUrl]))}" data-lightbox-alt="${escapeHtml(car.title)}" aria-label="Увеличить фото: ${escapeHtml(car.title)}">
            <img src="${escapeHtml(imageUrl)}" alt="${escapeHtml(car.title)}" class="car-image" loading="lazy" decoding="async" width="960" height="720" referrerpolicy="no-referrer" />
            <span class="vehicle-image-zoom" aria-hidden="true">＋</span>
          </button>
        `;
      }

      return `
        <div class="car-image car-image-empty">Фото пока не добавлено</div>
        ${isSold(car) ? `<span class="sold-ribbon">Продано</span>` : ""}
      `;
    };

    const setCatalogMessage = (text: string, options: { showRetry?: boolean } = {}) => {
      if (!(message instanceof HTMLElement) || !(messageText instanceof HTMLElement)) {
        return;
      }

      messageText.textContent = text;
      message.hidden = text === "" && !options.showRetry;

      if (retryButton instanceof HTMLButtonElement) {
        retryButton.hidden = !options.showRetry;
      }
    };

    const renderMatchReasons = (car: Record<string, unknown>) => {
      const reasons = getBuyerSearchMatchReasons(car, getActiveCriteria());
      if (reasons.length === 0) return "";
      return `
        <div class="buyer-match-reasons" aria-label="Почему автомобиль подходит">
          <strong>Почему подходит</strong>
          <ul>${reasons.map((reason) => `<li>${escapeHtml(reason)}</li>`).join("")}</ul>
        </div>
      `;
    };

    const renderEmptyCatalog = () => {
      const criteria = getActiveCriteria();
      activeRelaxations = getBuyerSearchRelaxations(criteria);
      const actions = activeRelaxations.map((option) => `
        <button class="catalog-relaxation" type="button" data-relaxation-id="${escapeHtml(option.id)}">
          <strong>${escapeHtml(option.label)}</strong>
          <span>${escapeHtml(option.description)}</span>
        </button>
      `).join("");
      trackProductEvent("buyer_search_zero_results", { criteria_count: getBuyerSearchCriteriaList(criteria).length });

      return `
        <div class="catalog-empty-state">
          <strong>По этим параметрам пока нет автомобилей</strong>
          <p>Измените один критерий или сохраните поиск, чтобы вернуться к нему позже.</p>
          ${actions ? `<div class="catalog-relaxations" aria-label="Как расширить поиск">${actions}</div>` : ""}
          <div class="catalog-empty-actions">
            <button class="button button-light compact-button" type="button" data-save-empty-search>Сохранить поиск</button>
            <a class="button button-light compact-button" href="/cars">Показать весь каталог</a>
          </div>
        </div>
      `;
    };

    const renderCatalogCars = (filteredCars: Array<Record<string, unknown>>) => {
      if (!(grid instanceof HTMLElement)) {
        return;
      }

      if (resultsCount instanceof HTMLElement) {
        resultsCount.textContent = `${filteredCars.length} авто`;
      }
      renderAppliedCriteria();

      if (filteredCars.length === 0) {
        grid.innerHTML = renderEmptyCatalog();
        setCatalogMessage("");
        renderRecommendedCars();
        return;
      }

      grid.innerHTML = filteredCars
        .map((car) => {
          const rawSlug = String(car.slug || "").trim();
          const detailPath = rawSlug ? `/cars/${encodeURIComponent(rawSlug)}` : "";
          const cardContent = `
            <div class="car-card-media">
              ${renderCarImage(car)}
              ${isSold(car) ? '<span class="sold-ribbon">Продано</span>' : ""}
            </div>
            <div class="car-card-body">
              <div class="car-card-top">
                <h3>${detailPath ? `<a href="${detailPath}">${escapeHtml(car.title)}</a>` : escapeHtml(car.title)}</h3>
              </div>
              <div class="car-card-badges">
                ${renderStatusBadge(car)}
                ${renderPaidBadges(car)}
                ${renderAiMini(car)}
                ${renderSmartBadges(car)}
              </div>
              <p class="car-price">${formatPrice(car.price, car.currency)}</p>
              ${renderMatchReasons(car)}
              <dl class="car-meta">
                <div><dt>Год</dt><dd>${escapeHtml(car.year)}</dd></div>
                <div><dt>Пробег</dt><dd>${Number(car.mileage || 0).toLocaleString("ru-RU")} км</dd></div>
                <div><dt>Город</dt><dd>${escapeHtml(normalizeCityLabel(car.city))}</dd></div>
              </dl>
              ${detailPath ? `<a class="button button-light car-card-details" href="${detailPath}">Подробнее</a>` : ""}
            </div>
          `;

          return `
            <article class="car-card${isSold(car) ? " car-card-sold" : ""}">
              <div class="car-card-link car-card-composite${detailPath ? "" : " car-card-link-disabled"}"${detailPath ? "" : ' aria-disabled="true"'}>${cardContent}</div>
            </article>
          `;
        })
        .join("");

      setCatalogMessage("");
      renderRecommendedCars();
    };

    const getCurrentFiltersObject = () => {
      return getActiveCriteria();
    };

    const getRecentViews = () => {
      try {
        const parsed = JSON.parse(localStorage.getItem(RECENT_VIEWS_KEY) || "[]");
        return Array.isArray(parsed) ? parsed.filter((item) => item && typeof item === "object") as Array<Record<string, unknown>> : [];
      } catch {
        return [];
      }
    };

    const getBuyerContext = () => {
      const recentViews = getRecentViews();
      const pickTop = (field: string) => {
        const counts = new Map<string, number>();
        recentViews.forEach((item) => {
          const value = String(item[field] || "").trim();
          if (value) counts.set(value, (counts.get(value) || 0) + 1);
        });
        return [...counts.entries()].sort((left, right) => right[1] - left[1]).slice(0, 4).map(([value]) => value);
      };

      return {
        recent_views: recentViews.slice(0, 10),
        preferred_brands: pickTop("brand"),
        preferred_body_types: pickTop("body_type"),
        preferred_fuel_types: pickTop("fuel_type"),
        preferred_cities: pickTop("city"),
      };
    };

    const setAiExplanation = (text: string, isMuted = false) => {
      if (!(aiSearchExplanation instanceof HTMLElement)) {
        return;
      }

      aiSearchExplanation.textContent = text;
      aiSearchExplanation.hidden = !text;
      aiSearchExplanation.classList.toggle("is-muted", isMuted);
    };

    const renderAiSuggestions = (suggestions: unknown[]) => {
      if (!(aiSearchSuggestions instanceof HTMLElement)) {
        return;
      }

      const items = Array.isArray(suggestions) ? suggestions.map((item) => String(item).trim()).filter(Boolean) : [];
      aiSearchSuggestions.hidden = items.length === 0;
      aiSearchSuggestions.innerHTML = items
        .map((item) => `<button class="ai-search-chip" type="button" data-ai-suggestion="${escapeHtml(item)}">${escapeHtml(item)}</button>`)
        .join("");
    };

    const saveLastAiSearch = (query: string, filters: Record<string, unknown>, explanation = "") => {
      localStorage.setItem(LAST_AI_SEARCH_KEY, JSON.stringify({
        query,
        filters,
        explanation,
        created_at: new Date().toISOString(),
      }));
      renderLastAiSearch();
    };

    const renderLastAiSearch = () => {
      if (!(aiLastSearch instanceof HTMLElement)) {
        return;
      }

      try {
        const parsed = JSON.parse(localStorage.getItem(LAST_AI_SEARCH_KEY) || "null");
        const label = parsed?.query ? `Последний AI-поиск: ${parsed.query}` : "";
        const text = aiLastSearch.querySelector("span");
        if (text instanceof HTMLElement) {
          text.textContent = label;
        }
        aiLastSearch.hidden = !label;
      } catch {
        aiLastSearch.hidden = true;
      }
    };

    const applyAiFilters = (filters: Record<string, unknown>) => {
      const params = new URLSearchParams(window.location.search);
      const normalized = normalizeBuyerSearchCriteria(filters);
      applyBuyerSearchCriteriaToParams(params, normalized);

      window.history.replaceState({}, "", `${window.location.pathname}?${params.toString()}`);
      syncSearchFormFromUrl();
      renderAppliedCriteria();
    };

    const resetAiFilters = () => {
      const params = new URLSearchParams(window.location.search);
      BUYER_SEARCH_FILTER_KEYS.forEach((key) => params.delete(key));
      params.delete("price");
      window.history.replaceState({}, "", params.toString() ? `${window.location.pathname}?${params.toString()}` : window.location.pathname);
      if (aiSearchQuery instanceof HTMLTextAreaElement) {
        aiSearchQuery.value = "";
      }
      setAiExplanation("");
      renderAiSuggestions([]);
      renderClarifications("", {});
      syncSearchFormFromUrl();
      renderAppliedCriteria();
    };

    const refreshCatalogFromCurrentFilters = () => {
      if (latestCatalogCars.length > 0) {
        renderCatalogCars(sortCars(promotedFirst(latestCatalogCars.filter(matchesActiveFilters))));
        return;
      }

      if (grid instanceof HTMLElement && grid.dataset.apiUrl && grid.dataset.apiUrl !== grid.dataset.placeholderUrl) {
        return;
      }

      window.location.href = window.location.href;
    };

    const runAiSearch = async (query: string, options: { forceFallback?: boolean } = {}) => {
      const cleanQuery = query.trim();

      if (!cleanQuery) {
        setAiExplanation("Напишите, какую машину ищете.");
        return;
      }

      getOrCreateSessionId();
      setAiExplanation("Подбираю фильтры...");
      trackProductEvent("buyer_search_started", { source: "ai", criteria_count: getBuyerSearchCriteriaList(getActiveCriteria()).length });

      const apiUrl = filterPanel instanceof HTMLElement ? filterPanel.dataset.apiUrl : "";
      const aiPath = filterPanel instanceof HTMLElement ? filterPanel.dataset.aiSearchIntentPath || "/ai/search/intent" : "/ai/search/intent";
      let result = parseCarSearchIntent(cleanQuery);
      let usedFallback = true;

      if (!options.forceFallback && apiUrl) {
        try {
          const token = getAuthToken();
          const response = await fetch(`${apiUrl}${aiPath}`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              ...(token ? { Authorization: `Bearer ${token}` } : {}),
            },
            body: JSON.stringify({
              query: cleanQuery,
              current_filters: getCurrentFiltersObject(),
              user_context: getBuyerContext(),
            }),
          });

          if (response.ok) {
            const payload = await response.json();
            result = {
              filters: normalizeBuyerSearchCriteria(payload?.filters || result.filters),
              explanation: payload?.explanation || result.explanation,
              confidence: payload?.confidence ?? result.confidence,
              suggestions: Array.isArray(payload?.suggestions) ? payload.suggestions : result.suggestions,
            };
            usedFallback = false;
          } else if (response.status !== 404) {
            console.warn("AI search intent failed", response.status);
          }
        } catch (error) {
          console.warn("AI search intent unavailable", error);
        }
      }

      applyAiFilters(result.filters || {});
      renderAiSuggestions(result.suggestions || []);
      saveLastAiSearch(cleanQuery, result.filters || {}, result.explanation || "");
      setAiExplanation(usedFallback ? "AI endpoint ещё не подключён, применён базовый подбор по тексту." : result.explanation || "Фильтры применены.");
      renderClarifications(cleanQuery, getActiveCriteria());
      trackProductEvent("buyer_search_completed", {
        source: usedFallback ? "local" : "ai",
        criteria_count: getBuyerSearchCriteriaList(getActiveCriteria()).length,
        status: usedFallback ? "fallback" : "success",
      });
      refreshCatalogFromCurrentFilters();
    };

    const getRecommendedScore = (car: Record<string, unknown>, view: Record<string, unknown>) => {
      let score = 0;
      if (String(car.slug || "") === String(view.slug || "")) return 0;
      if (car.brand && car.brand === view.brand) score += 5;
      if (getBodyType(car) && getBodyType(car) === String(view.body_type || "")) score += 3;
      if (car.fuel_type && car.fuel_type === view.fuel_type) score += 2;
      const viewPrice = Number(view.price || 0);
      if (viewPrice && Math.abs(Number(car.price || 0) - viewPrice) <= Math.max(1500, viewPrice * 0.25)) score += 2;
      return score;
    };

    const renderRecommendedCars = () => {
      if (!(aiRecommendedSection instanceof HTMLElement) || !(aiRecommendedGrid instanceof HTMLElement)) {
        return;
      }

      const recentViews = getRecentViews().slice(0, 3);
      if (recentViews.length === 0 || latestCatalogCars.length === 0) {
        aiRecommendedSection.hidden = true;
        return;
      }

      const recommendations = latestCatalogCars
        .map((car) => ({
          car,
          score: Math.max(...recentViews.map((view) => getRecommendedScore(car, view))),
        }))
        .filter((item) => item.score > 0)
        .sort((left, right) => right.score - left.score)
        .slice(0, 6)
        .map((item) => item.car);

      aiRecommendedSection.hidden = recommendations.length === 0;
      aiRecommendedGrid.innerHTML = recommendations.map((car) => {
        const slug = String(car.slug || "");
        return `
          <a class="ai-recommended-card" href="/cars/${encodeURIComponent(slug)}">
            <span>${escapeHtml(car.brand || "Авто")}</span>
            <strong>${escapeHtml(car.title || "Автомобиль")}</strong>
            <small>${formatPrice(car.price, car.currency)} · ${escapeHtml(normalizeCityLabel(car.city))}</small>
          </a>
        `;
      }).join("");
    };

    if (grid instanceof HTMLElement && message instanceof HTMLElement) {
      syncSearchFormFromUrl();
      const apiUrl = grid.dataset.apiUrl;
      const placeholderUrl = grid.dataset.placeholderUrl;

      if (apiUrl && apiUrl !== placeholderUrl) {
        const loadCars = () => fetch(`${apiUrl}/cars`)
          .then((response) => {
            if (!response.ok) {
              throw new Error("cars load failed");
            }

            return response.json();
          })
          .then((cars) => {
            if (!Array.isArray(cars) || cars.length === 0) {
              latestCatalogCars = [];
              grid.innerHTML = "";
              setCatalogMessage("Пока нет опубликованных объявлений.");
              return;
            }

            latestCatalogCars = cars.filter(isPublicListing);
            const filteredCars = sortCars(promotedFirst(latestCatalogCars.filter(matchesActiveFilters)));

            renderCatalogCars(filteredCars);
          });

        const handleCatalogLoadError = () => {
          const hasStaticCars = grid.children.length > 0;
          setCatalogMessage(
            hasStaticCars
              ? "Каталог показан из сохранённой версии. Можно обновить список ещё раз."
              : "Каталог временно не загрузился. Проверьте соединение и попробуйте ещё раз.",
            { showRetry: true },
          );
        };

        retryButton?.addEventListener("click", () => {
          if (retryButton instanceof HTMLButtonElement) {
            retryButton.disabled = true;
          }
          setCatalogMessage("Обновляю каталог...");
          loadCars()
            .catch(handleCatalogLoadError)
            .finally(() => {
              if (retryButton instanceof HTMLButtonElement) {
                retryButton.disabled = false;
              }
            });
        });

        loadCars()
          .catch(() => {
            handleCatalogLoadError();
          });

        sortSelect?.addEventListener("change", () => {
          if (sortSelect instanceof HTMLSelectElement) {
            const params = new URLSearchParams(window.location.search);
            params.set("sort", sortSelect.value);
            window.history.replaceState({}, "", `${window.location.pathname}?${params.toString()}`);
            trackProductEvent("buyer_search_filter_changed", { action: "sort", sort: sortSelect.value, source: "manual" });
          }

          loadCars().catch(handleCatalogLoadError);
        });
      }
    }

    searchForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!(searchForm instanceof HTMLFormElement)) return;
      const values = Object.fromEntries(new FormData(searchForm).entries());
      const criteria = normalizeBuyerSearchCriteria(values);
      replaceCriteriaInUrl(criteria);
      renderClarifications("", criteria);
      trackProductEvent("buyer_search_filter_changed", {
        action: "apply",
        source: "manual",
        criteria_count: getBuyerSearchCriteriaList(criteria).length,
      });
      refreshCatalogFromCurrentFilters();
    });

    filterReset?.addEventListener("click", (event) => {
      event.preventDefault();
      resetAiFilters();
      trackProductEvent("buyer_search_filter_changed", { action: "reset", source: "manual", criteria_count: 0 });
      refreshCatalogFromCurrentFilters();
    });

    appliedCriteriaChips?.addEventListener("click", (event) => {
      const button = event.target instanceof HTMLElement ? event.target.closest("[data-remove-criterion]") : null;
      if (!(button instanceof HTMLButtonElement)) return;
      const key = button.dataset.removeCriterion;
      if (!BUYER_SEARCH_FILTER_KEYS.includes(key as typeof BUYER_SEARCH_FILTER_KEYS[number])) return;
      const criteria = getActiveCriteria();
      delete criteria[key as keyof BuyerSearchCriteria];
      replaceCriteriaInUrl(criteria);
      trackProductEvent("buyer_search_filter_changed", { action: "remove", source: "criteria", criteria_count: getBuyerSearchCriteriaList(criteria).length });
      refreshCatalogFromCurrentFilters();
    });

    clarificationList?.addEventListener("click", (event) => {
      const button = event.target instanceof HTMLElement ? event.target.closest("[data-clarification-changes]") : null;
      if (!(button instanceof HTMLButtonElement)) return;
      try {
        const changes = normalizeBuyerSearchCriteria(JSON.parse(button.dataset.clarificationChanges || "{}"));
        const criteria = { ...getActiveCriteria(), ...changes };
        replaceCriteriaInUrl(criteria);
        renderClarifications(aiSearchQuery instanceof HTMLTextAreaElement ? aiSearchQuery.value : "", criteria);
        trackProductEvent("buyer_search_filter_changed", { action: "clarify", source: "clarification", criteria_count: getBuyerSearchCriteriaList(criteria).length });
        refreshCatalogFromCurrentFilters();
      } catch {
        setAiExplanation("Не удалось применить уточнение. Выберите параметр вручную.", true);
      }
    });

    grid?.addEventListener("click", (event) => {
      const target = event.target instanceof HTMLElement ? event.target : null;
      const saveButton = target?.closest("[data-save-empty-search]");
      if (saveButton) {
        if (aiSearchSave instanceof HTMLButtonElement) aiSearchSave.click();
        return;
      }

      const relaxationButton = target?.closest("[data-relaxation-id]");
      if (!(relaxationButton instanceof HTMLButtonElement)) return;
      const relaxation = activeRelaxations.find((item) => item.id === relaxationButton.dataset.relaxationId);
      if (!relaxation) return;
      const criteria = getActiveCriteria();
      if (relaxation.remove) delete criteria[relaxation.remove];
      Object.assign(criteria, relaxation.changes || {});
      replaceCriteriaInUrl(criteria);
      trackProductEvent("buyer_search_relaxation_applied", { action: relaxation.id, criteria_count: getBuyerSearchCriteriaList(criteria).length });
      refreshCatalogFromCurrentFilters();
    });

    aiSearchForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (aiSearchQuery instanceof HTMLTextAreaElement) {
        void runAiSearch(aiSearchQuery.value);
      }
    });

    aiSearchReset?.addEventListener("click", () => {
      resetAiFilters();
      refreshCatalogFromCurrentFilters();
    });

    aiSearchSave?.addEventListener("click", async () => {
      const query = aiSearchQuery instanceof HTMLTextAreaElement ? aiSearchQuery.value.trim() : "";
      const token = getAuthToken();

      if (!token) {
        setAiExplanation("Войдите, чтобы сохранить поиск и позже получать похожие авто.", true);
        return;
      }

      const apiUrl = filterPanel instanceof HTMLElement ? filterPanel.dataset.apiUrl : "";
      const savedSearchesPath = filterPanel instanceof HTMLElement ? filterPanel.dataset.savedSearchesPath || "/saved-searches" : "/saved-searches";

      if (!apiUrl) {
        setAiExplanation("Сохранённые поиски скоро появятся.", true);
        return;
      }

      try {
        const lastSearch = JSON.parse(localStorage.getItem(LAST_AI_SEARCH_KEY) || "{}");
        const response = await fetch(`${apiUrl}${savedSearchesPath}`, {
          method: "POST",
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            query_text: query || lastSearch.query || "",
            filters_json: getCurrentFiltersObject(),
            ai_summary: lastSearch.explanation || "",
            notify_enabled: false,
          }),
        });

        if (response.status === 404) {
          setAiExplanation("Сохранённые поиски скоро появятся.", true);
          return;
        }

        if (!response.ok) {
          throw new Error("saved search failed");
        }

        setAiExplanation("Поиск сохранён.");
        trackProductEvent("buyer_search_saved", { criteria_count: getBuyerSearchCriteriaList(getActiveCriteria()).length, status: "success" });
      } catch (error) {
        console.warn("Saved search unavailable", error);
        setAiExplanation("Сохранённые поиски скоро появятся.", true);
      }
    });

    aiSearchSuggestions?.addEventListener("click", (event) => {
      const button = event.target instanceof HTMLElement ? event.target.closest("[data-ai-suggestion]") : null;
      if (!(button instanceof HTMLButtonElement) || !(aiSearchQuery instanceof HTMLTextAreaElement)) {
        return;
      }

      aiSearchQuery.value = button.dataset.aiSuggestion || "";
      void runAiSearch(aiSearchQuery.value);
    });

    aiLastSearch?.querySelector("button")?.addEventListener("click", () => {
      try {
        const lastSearch = JSON.parse(localStorage.getItem(LAST_AI_SEARCH_KEY) || "{}");
        if (lastSearch.query && aiSearchQuery instanceof HTMLTextAreaElement) {
          aiSearchQuery.value = lastSearch.query;
          void runAiSearch(lastSearch.query);
        }
      } catch {
        setAiExplanation("Не удалось повторить последний поиск.", true);
      }
    });

    renderLastAiSearch();
    renderAppliedCriteria();
    renderClarifications("", getActiveCriteria());
    getOrCreateSessionId();
  </script>
</BaseLayout>
