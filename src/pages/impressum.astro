---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Impressum";
const description = "Юридическая информация и контакты SiteCraft Auto Market.";
---

<BaseLayout title={title} description={description} canonicalPath="/impressum" variant="legal">
  <section class="section page-hero">
    <div class="container prose-page">
      <p class="eyebrow">Юридическая информация</p>
      <h1>Impressum</h1>
      <p class="lead">
        SiteCraft Auto Market — продукт компании SiteCraft Agency для публикации и модерации автомобильных объявлений.
      </p>

      <div class="legal-card document-card">
        <h2>Контакты</h2>
        <p>
          Вопросы по поддержке, данным, объявлениям и модерации:
          {" "}
          <a href="mailto:support@sitecraft.agency">support@sitecraft.agency</a>
        </p>
        <p>
          Сайт компании:
          {" "}
          <a href="https://sitecraft.agency" target="_blank" rel="noopener noreferrer">sitecraft.agency</a>
        </p>
      </div>

      <div class="legal-card document-card">
        <h2>Ответственность за объявления</h2>
        <p>
          Пользователи несут ответственность за достоверность данных, фотографий, цены и контактной информации в
          объявлениях. Команда SiteCraft Auto Market может отклонять, скрывать, архивировать или удалять объявления,
          нарушающие правила площадки.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
