---
import BaseLayout from "../../layouts/BaseLayout.astro";

const xanoApiUrl = import.meta.env.PUBLIC_XANO_API_URL;
---

<BaseLayout title="Сохранённые автомобили" variant="workspace" noindex>
  <section class="section favorites-page">
    <div class="container favorites-shell" data-api-url={xanoApiUrl} aria-busy="true">
      <header class="section-heading favorites-heading">
        <div>
          <p class="eyebrow">Кабинет</p>
          <h1>Сохранённые автомобили</h1>
          <p class="lead">Сохранённые объявления из общего каталога.</p>
        </div>
        <a class="button button-light" href="/cars/"><i data-lucide="car-front" aria-hidden="true"></i><span>Открыть каталог</span></a>
      </header>
      <p class="form-message" data-favorites-status role="status" aria-live="polite">Загружаю избранное...</p>
      <div class="catalog-grid favorites-grid" data-favorites-grid></div>
    </div>
  </section>

  <script>
    import { API_ROUTES, buildApiUrl } from "../../lib/apiRoutes";
    import { getAuthToken, isSessionConfirmedExpired, redirectToLogin } from "../../lib/authClient";
    import { fetchWithRetry } from "../../lib/http/fetchWithRetry";
    import { refreshAppIcons } from "../../lib/appIcons";
    import { renderPublicCarCardMarkup } from "../../lib/publicCarCard";
    import { installPublicCarCardInteractions, refreshPublicCarCardIcons } from "../../lib/publicCarCardsClient";
    import type { CarListing } from "../../lib/types";

    const shell = document.querySelector<HTMLElement>("[data-api-url]");
    const grid = document.querySelector<HTMLElement>("[data-favorites-grid]");
    const status = document.querySelector<HTMLElement>("[data-favorites-status]");
    const apiUrl = String(shell?.dataset.apiUrl || "").replace(/\/+$/, "");
    let favoriteTotal = 0;

    const renderCount = (total: number) => {
      favoriteTotal = Math.max(0, Number(total) || 0);
      if (status) {
        status.hidden = false;
        status.textContent = `${favoriteTotal} сохранённых объявлений`;
      }
    };

    const renderEmpty = () => {
      favoriteTotal = 0;
      if (grid) {
        grid.innerHTML = `<section class="favorites-empty"><strong>Вы пока не сохранили ни одного автомобиля.</strong><p>Добавляйте машины в избранное с помощью кнопки сердца.</p><a class="button button-primary" href="/cars/"><i data-lucide="car-front" aria-hidden="true"></i><span>Открыть каталог</span></a></section>`;
        refreshAppIcons(grid);
      }
      if (status) status.hidden = true;
    };

    async function loadFavorites(options: { silent?: boolean } = {}) {
      const token = getAuthToken();
      if (!token) {
        redirectToLogin("/dashboard/favorites/");
        return;
      }
      if (!options.silent && status) {
        status.hidden = false;
        status.textContent = "Загружаю избранное...";
      }
      try {
        const response = await fetchWithRetry(`${buildApiUrl(API_ROUTES.favorites, apiUrl)}?page=1&per_page=100`, {
          headers: { Accept: "application/json", Authorization: `Bearer ${token}` },
        }, { dedupeKey: "dashboard-favorites", attempts: 3, timeoutMs: 8_000, delaysMs: [300, 900] });
        if (response.status === 401) {
          if (await isSessionConfirmedExpired(apiUrl, token)) redirectToLogin("/dashboard/favorites/");
          else throw new Error("Сессию временно не удалось подтвердить.");
          return;
        }
        if (!response.ok) throw new Error("favorites unavailable");
        const payload = await response.json();
        const rawItems = (Array.isArray(payload) ? payload : payload?.items || []) as Array<CarListing & { listing?: CarListing; created_at?: string }>;
        const items = rawItems.map((item) => item.listing ? { ...item.listing, is_saved: true, saved_at: item.created_at } : item);
        if (!items.length) {
          renderEmpty();
          return;
        }
        if (grid) grid.innerHTML = items.map((car) => renderPublicCarCardMarkup({ ...car, is_saved: true }, { source: "dashboard_favorites" })).join("");
        renderCount(Number(payload?.total ?? items.length));
        refreshPublicCarCardIcons(grid || document);
      } catch {
        if (!options.silent && status) {
          status.hidden = false;
          status.innerHTML = `Не удалось загрузить избранное. <button class="button button-light" type="button" data-favorites-retry>Повторить</button>`;
          refreshAppIcons(status);
        }
      } finally {
        shell?.setAttribute("aria-busy", "false");
      }
    }

    status?.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("[data-favorites-retry]")) void loadFavorites();
    });
    window.addEventListener("car-favorite-changed", (event) => {
      const detail = (event as CustomEvent<{ listingId: string; isSaved: boolean }>).detail;
      if (detail?.isSaved === false) {
        const card = grid?.querySelector<HTMLElement>(`[data-car-id="${CSS.escape(detail.listingId)}"]`);
        card?.classList.add("is-removing");
        window.setTimeout(() => {
          card?.remove();
          renderCount(Math.max(0, favoriteTotal - 1));
          if (grid && !grid.querySelector("[data-car-id]")) renderEmpty();
          void loadFavorites({ silent: true });
        }, 180);
      }
    });
    installPublicCarCardInteractions();
    void loadFavorites();
  </script>
</BaseLayout>
