---
import BaseLayout from "../../layouts/BaseLayout.astro";
const xanoApiUrl = import.meta.env.PUBLIC_XANO_API_URL;
---

<BaseLayout title="Кредиты и операции" description="Баланс внутренних кредитов и история операций." noindex>
  <section class="section billing-page-section">
    <div class="container billing-credit-page" data-api-url={xanoApiUrl} aria-busy="true">
      <header class="dashboard-home-heading"><div><p class="eyebrow">Кабинет</p><h1>Кредиты и операции</h1><p class="lead">Единый баланс используется для AI-функций и продвижения объявлений.</p></div><a class="button button-light" href="/dashboard/listings/">Мои объявления</a></header>
      <section class="billing-credit-overview" aria-labelledby="billing-balance-title">
        <div><span id="billing-balance-title">Текущий баланс</span><strong id="billing-balance">—</strong><p>Просмотр страниц и локальные фильтры кредиты не расходуют.</p></div>
        <div class="billing-credit-rules"><strong>Как списываются кредиты</strong><p>Стоимость продвижения определяется только сервером. Запись появляется после успешной активации.</p></div>
      </section>
      <section class="billing-transactions" aria-labelledby="billing-history-title">
        <div class="section-heading"><div><p class="eyebrow">Журнал</p><h2 id="billing-history-title">История операций</h2></div></div>
        <div class="billing-history" id="billing-history" aria-live="polite"><p class="form-message">Загружаю историю...</p></div>
      </section>
    </div>
  </section>

  <script>
    import { getAuthToken, isSessionConfirmedExpired, redirectToLogin } from "../../lib/authClient";
    import { API_ROUTES } from "../../lib/apiRoutes";
    import { PROMOTION_PRODUCTS, parseApiDate, type CreditTransactionRecord, type CreditTransactionsResponse, type DashboardSummary, type PromotionProductSlug } from "../../lib/promotions/model";

    const page = document.querySelector<HTMLElement>(".billing-credit-page");
    const balance = document.querySelector<HTMLElement>("#billing-balance");
    const history = document.querySelector<HTMLElement>("#billing-history");
    const token = getAuthToken();
    const apiUrl = String(page?.dataset.apiUrl || "").replace(/\/+$/, "");
    const escapeHtml = (value: unknown) => String(value ?? "").replace(/[&<>'"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" }[character] || character));
    const formatDate = (value: unknown) => { const date = parseApiDate(value); return date ? new Intl.DateTimeFormat("ru-RU", { dateStyle: "medium", timeStyle: "short" }).format(date) : "Дата не указана"; };
    const transactionTitle = (item: CreditTransactionRecord) => PROMOTION_PRODUCTS[item.product_slug as PromotionProductSlug]?.name || item.description || item.notes || item.type || "Операция с кредитами";

    function renderTransactions(items: CreditTransactionRecord[]) {
      if (!history) return;
      history.innerHTML = items.length ? items.map((item) => `<article class="billing-history-row"><div><strong>${escapeHtml(transactionTitle(item))}</strong><span>${escapeHtml(formatDate(item.created_at))}${item.related_car_id || item.listing_id ? ` · объявление #${escapeHtml(item.related_car_id || item.listing_id)}` : ""}</span></div><div><b class="${Number(item.amount) < 0 ? "is-debit" : "is-credit"}">${Number(item.amount) > 0 ? "+" : ""}${escapeHtml(item.amount)} кредитов</b><small>Баланс: ${escapeHtml(item.balance_after)}</small></div></article>`).join("") : '<div class="mac-empty-state"><strong>Операций пока нет</strong><p>Успешные списания и начисления появятся здесь.</p></div>';
    }

    async function loadBilling() {
      if (!token || !page) return;
      page.setAttribute("aria-busy", "true");
      try {
        const headers = { Authorization: `Bearer ${token}` };
        const [summaryResponse, historyResponse] = await Promise.all([
          fetch(`${apiUrl}${API_ROUTES.dashboardSummary}`, { headers }),
          fetch(`${apiUrl}${API_ROUTES.dashboardCreditTransactions}?page=1&per_page=20`, { headers }),
        ]);
        if (summaryResponse.status === 401 || historyResponse.status === 401) {
          if (await isSessionConfirmedExpired(apiUrl, token)) { redirectToLogin("/dashboard/billing/"); return; }
        }
        if (!summaryResponse.ok || !historyResponse.ok) throw new Error("Сервис кредитов временно недоступен.");
        const summary = await summaryResponse.json() as DashboardSummary;
        const transactions = await historyResponse.json() as CreditTransactionsResponse;
        if (balance) balance.textContent = `${summary.credits.balance} кредитов`;
        renderTransactions(Array.isArray(transactions.items) ? transactions.items : []);
      } catch (error) {
        if (history) history.innerHTML = `<div class="mac-empty-state" role="alert"><strong>Не удалось загрузить операции</strong><p>${escapeHtml(error instanceof Error ? error.message : "Проверьте соединение.")}</p><button class="button button-light" type="button" data-billing-retry>Повторить</button></div>`;
      } finally {
        page.setAttribute("aria-busy", "false");
      }
    }

    history?.addEventListener("click", (event) => { if (event.target instanceof Element && event.target.closest("[data-billing-retry]")) void loadBilling(); });
    if (!token) redirectToLogin("/dashboard/billing/"); else void loadBilling();
  </script>
</BaseLayout>
