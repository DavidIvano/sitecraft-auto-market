---
import BaseLayout from "../../layouts/BaseLayout.astro";

const xanoApiUrl = import.meta.env.PUBLIC_XANO_API_URL;
---

<BaseLayout title="Личный кабинет" noindex>
  <section class="section page-hero dashboard-hero">
    <div class="container dashboard-overview">
      <div class="dashboard-copy">
        <p class="eyebrow">Кабинет</p>
        <h1>Личный кабинет продавца</h1>
        <p class="lead">Здесь собраны ваши объявления, статусы модерации и быстрые действия.</p>
        <div class="hero-actions">
          <a class="button button-light" href="/dashboard/listings">Мои объявления</a>
          <a class="button button-light" href="/dashboard/deal-finder/" data-deal-finder-only="true" hidden>Deal Finder</a>
          <a class="button button-dark" href="/dashboard/new">Добавить объявление</a>
        </div>
        <p class="form-message" id="dashboard-auth-message" data-api-url={xanoApiUrl}>Проверяю вход...</p>
      </div>
      <div class="dashboard-stat-grid" aria-label="Обзор кабинета">
        <article class="dashboard-stat-card">
          <span>Активные объявления</span>
          <strong data-dashboard-stat="active">0</strong>
        </article>
        <article class="dashboard-stat-card">
          <span>На модерации</span>
          <strong data-dashboard-stat="pending">0</strong>
        </article>
        <article class="dashboard-stat-card">
          <span>AI-кредиты</span>
          <strong data-dashboard-stat="credits">10</strong>
        </article>
        <article class="dashboard-stat-card">
          <span>Просмотры</span>
          <strong data-dashboard-stat="views">—</strong>
        </article>
      </div>
    </div>
  </section>
  <script>
    import { fetchCurrentUser, getAuthToken, getAuthUser } from "../../lib/authClient";

    const token = getAuthToken();
    const userRaw = getAuthUser();
    const message = document.querySelector("#dashboard-auth-message");
    const apiUrl = message instanceof HTMLElement ? message.dataset.apiUrl : "";
    const activeStat = document.querySelector("[data-dashboard-stat='active']");
    const pendingStat = document.querySelector("[data-dashboard-stat='pending']");

    const goToLogin = () => {
      window.location.href = `/login?next=${encodeURIComponent("/dashboard")}`;
    };

    const loadDashboardListings = () => {
      fetch(`${apiUrl}/dashboard/listings`, {
        headers: { Authorization: `Bearer ${token}` },
      })
        .then((listingsResponse) => listingsResponse.ok ? listingsResponse.json() : [])
        .then((cars) => {
          if (!Array.isArray(cars)) return;
          const active = cars.filter((car) => String(car.status || "") === "approved").length;
          const pending = cars.filter((car) => String(car.status || "") === "pending_review").length;
          if (activeStat instanceof HTMLElement) activeStat.textContent = String(active);
          if (pendingStat instanceof HTMLElement) pendingStat.textContent = String(pending);
        })
        .catch(() => {});
    };

    if (!token) {
      window.location.href = `/login?next=${encodeURIComponent("/dashboard")}`;
    } else if (message instanceof HTMLElement) {
      fetchCurrentUser(apiUrl, token)
        .then((currentUser) => {
          if (!currentUser && !getAuthToken()) {
            goToLogin();
            return;
          }
          const user = currentUser ?? userRaw;
          message.textContent = user?.email
            ? `Вы вошли как ${user.email}.`
            : "Вы вошли в личный кабинет.";
          loadDashboardListings();
        })
        .catch(() => {
          message.textContent = userRaw?.email
            ? `Вы вошли как ${userRaw.email}. Данные обновятся после восстановления связи.`
            : "Вход сохранён. Данные обновятся после восстановления связи.";
          loadDashboardListings();
        });
    }
  </script>
</BaseLayout>
