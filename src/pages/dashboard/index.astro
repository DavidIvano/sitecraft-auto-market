---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactProfileForm from "../../components/dashboard/ContactProfileForm.astro";

const xanoApiUrl = import.meta.env.PUBLIC_XANO_API_URL;
---

<BaseLayout title="Личный кабинет" noindex>
  <section class="section dashboard-home">
    <div class="container dashboard-home-shell" data-api-url={xanoApiUrl} aria-busy="true">
      <header class="dashboard-home-heading">
        <div>
          <p class="eyebrow">Кабинет</p>
          <h1>Обзор продавца</h1>
          <p class="lead">Баланс, объявления и активные продвижения в одном месте.</p>
        </div>
        <div class="dashboard-home-actions">
          <a class="button button-light" href="/dashboard/favorites/">Избранное</a>
          <a class="button button-light" href="/dashboard/deal-finder/" data-deal-finder-only="true" hidden>Deal Finder</a>
          <a class="button button-dark" href="/dashboard/new">Добавить объявление</a>
        </div>
      </header>

      <p class="form-message" id="dashboard-auth-message" role="status" aria-live="polite">Проверяю вход...</p>

      <div class="dashboard-summary-grid" id="dashboard-summary" aria-live="polite">
        {[0, 1, 2].map(() => <span class="dashboard-summary-skeleton" aria-hidden="true"></span>)}
      </div>
    </div>
  </section>
  <section class="section dashboard-contact-section"><div class="container"><ContactProfileForm /></div></section>

  <script>
    import { fetchCurrentUser, getAuthToken, getAuthUser, isSessionConfirmedExpired, redirectToLogin } from "../../lib/authClient";
    import { API_ROUTES } from "../../lib/apiRoutes";
    import type { DashboardSummary } from "../../lib/promotions/model";

    const shell = document.querySelector<HTMLElement>(".dashboard-home-shell");
    const summaryRoot = document.querySelector<HTMLElement>("#dashboard-summary");
    const authMessage = document.querySelector<HTMLElement>("#dashboard-auth-message");
    const token = getAuthToken();
    const apiUrl = String(shell?.dataset.apiUrl || "").replace(/\/+$/, "");
    const userRaw = getAuthUser();

    const escapeHtml = (value: unknown) => String(value ?? "").replace(/[&<>'"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" }[character] || character));

    const renderSummary = (summary: DashboardSummary, favoriteCount: number | null = null) => {
      if (!summaryRoot) return;
      summaryRoot.innerHTML = `
        <a class="dashboard-summary-card" href="/dashboard/billing/">
          <span class="dashboard-summary-label">Баланс</span>
          <strong>${escapeHtml(summary.credits.balance)} кредитов</strong>
          <span>Доступно для AI и продвижения</span>
          <b>История операций</b>
        </a>
        <a class="dashboard-summary-card" href="/dashboard/listings/">
          <span class="dashboard-summary-label">Мои объявления</span>
          <strong>${escapeHtml(summary.listings.total)} объявлений</strong>
          <span>${escapeHtml(summary.listings.published)} опубликовано · ${escapeHtml(summary.listings.pending_review)} на модерации · ${escapeHtml(summary.listings.draft)} черновиков</span>
          <b>Открыть объявления</b>
        </a>
        <a class="dashboard-summary-card" href="/dashboard/listings/?filter=promoted">
          <span class="dashboard-summary-label">Сейчас продвигается</span>
          <strong>${escapeHtml(summary.listings.promoted)} объявлений</strong>
          <span>${escapeHtml(summary.active_promotions.homepage)} премиум · ${escapeHtml(summary.active_promotions.featured)} выделено · ${escapeHtml(summary.active_promotions.boosted)} поднято</span>
          <b>Управлять продвижением</b>
        </a>
        <a class="dashboard-summary-card" href="/dashboard/favorites/">
          <span class="dashboard-summary-label">Сохранённые авто</span>
          <strong>${favoriteCount === null ? "—" : escapeHtml(favoriteCount)} объявлений</strong>
          <span>Сохранённые автомобили из общего каталога</span>
          <b>Открыть избранное</b>
        </a>`;
    };

    const renderError = (message: string) => {
      if (!summaryRoot) return;
      summaryRoot.innerHTML = `<div class="dashboard-summary-error" role="alert"><strong>Не удалось загрузить обзор</strong><p>${escapeHtml(message)}</p><button class="button button-light" type="button" data-summary-retry>Повторить</button></div>`;
    };

    async function loadSummary() {
      if (!token || !shell) return;
      shell.setAttribute("aria-busy", "true");
      try {
        const response = await fetch(`${apiUrl}${API_ROUTES.dashboardSummary}`, { headers: { Authorization: `Bearer ${token}` } });
        if (response.status === 401) {
          if (await isSessionConfirmedExpired(apiUrl, token)) {
            redirectToLogin("/dashboard/");
            return;
          }
          throw new Error("Вход сохранён, но сервер не подтвердил сессию. Повторите запрос.");
        }
        if (!response.ok) throw new Error("Сервис кабинета временно недоступен.");
        const summary = await response.json() as DashboardSummary;
        let favoriteCount: number | null = null;
        try {
          const favoriteResponse = await fetch(`${apiUrl}${API_ROUTES.favorites}?page=1&per_page=1`, { headers: { Authorization: `Bearer ${token}` } });
          if (favoriteResponse.ok) {
            const favoritePayload = await favoriteResponse.json();
            favoriteCount = Number(favoritePayload?.total ?? favoritePayload?.items?.length ?? 0);
          }
        } catch {
          favoriteCount = null;
        }
        renderSummary(summary, favoriteCount);
      } catch (error) {
        renderError(error instanceof Error ? error.message : "Проверьте соединение и повторите запрос.");
      } finally {
        shell.setAttribute("aria-busy", "false");
      }
    }

    summaryRoot?.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("[data-summary-retry]")) void loadSummary();
    });

    if (!token) {
      redirectToLogin("/dashboard/");
    } else {
      fetchCurrentUser(apiUrl, token).then((currentUser) => {
        const user = currentUser ?? userRaw;
        if (authMessage) authMessage.textContent = user?.email ? `Вы вошли как ${user.email}.` : "Вход выполнен.";
      }).catch(() => {
        if (authMessage) authMessage.textContent = userRaw?.email ? `Вход сохранён для ${userRaw.email}.` : "Вход сохранён.";
      });
      void loadSummary();
    }
  </script>
</BaseLayout>
