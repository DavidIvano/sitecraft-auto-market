          return aiDraftForm instanceof HTMLFormElement && aiDraftForm.dataset.allowLegacyAiGenerate === "true";
        }

        function apiRoute(name: string, fallback: string) {
          const route = apiRoutes[name];
          return typeof route === "string" && route.startsWith("/") ? route : fallback;
        }

        function isPublicImageUrl(value: unknown) {
          const url = String(value || "").trim();

          return /^https?:\/\//i.test(url) && !/^(blob|data|file):/i.test(url);
        }

        function toAiR2Images(images: typeof currentAiUploadedImages) {
          return images.map((image) => {
            const url = String(image.url || "").trim();

            if (!isPublicImageUrl(url)) {
              throw new Error("Фото не загружено в хранилище. Нужна публичная ссылка изображения.");
            }

            return {
              url,
              key: String(image.key || ""),
              contentType: String(image.contentType || "image/webp"),
              size: Number(image.size || 0),
            };
          });
        }

        function getXanoErrorMessage(data: Record<string, any>, responseText: string) {
          const candidates = [
            data?.message,
            data?.error,
            data?.error_description,
            data?.payload?.message,
            data?.payload?.error,
            data?.response?.message,
          ];
          const message = candidates.find((value) => typeof value === "string" && value.trim());
          const errorType = String(data?.error_type || data?.type || data?.code || "").trim();

          if (message) {
            return String(message);
          }

          if (/inputerror|accessdenied/i.test(errorType) && responseText.trim()) {
            return responseText;
          }

          return responseText.trim();
        }

