        async function validateAuthToken() {
          const apiUrl = form instanceof HTMLFormElement ? form.dataset.apiUrl : undefined;

          const authToken = getActiveAuthToken();
          if (!authToken || !apiUrl) {
            recoverAuthOrRelogin();
            return;
          }

          try {
            const user = await fetchCurrentUser(apiUrl, authToken);
            if (!user && !getAuthToken()) {
              recoverAuthOrRelogin();
            }
          } catch {
            // Keep the saved session during temporary network or API failures.
          }
        }

        validateAuthToken();

        async function restoreAiDraftFromUrl() {
          const draftId = Number(new URLSearchParams(window.location.search).get("draft_id") || 0);
          const apiUrl = form instanceof HTMLFormElement ? form.dataset.apiUrl : undefined;
          const authToken = getActiveAuthToken();
          if (!Number.isInteger(draftId) || draftId <= 0 || !apiUrl || !authToken) return;

          try {
            setAiMessage("Восстанавливаю сохранённый AI-черновик...");
            const response = await fetch(`${apiUrl}/dashboard/drafts/${draftId}`, {
              headers: { Accept: "application/json", Authorization: `Bearer ${authToken}` },
            });
            if (response.status === 401) {
              recoverAuthOrRelogin();
              return;
            }
            if (!response.ok) throw new Error("DRAFT_RESTORE_FAILED");
            const payload = await response.json() as Record<string, any>;
            const images = Array.isArray(payload.images) ? payload.images : Array.isArray(payload.draft?.images) ? payload.draft.images : [];
            currentAiUploadedImages = images
              .map((image: Record<string, any>) => ({
                url: String(image.url || image.image_url || ""),
                key: String(image.key || image.original_filename || ""),
                contentType: String(image.contentType || image.mime_type || "image/webp"),
                size: Number(image.size || image.size_bytes || 0),
              }))
              .filter((image: { url: string }) => isPublicImageUrl(image.url));
            renderAiDraftPreview(payload);
            markAiDraftSaved();
            setAiMessage("AI-черновик восстановлен. Проверьте данные перед отправкой.");
          } catch {
            setAiMessage("Не удалось восстановить AI-черновик. Откройте его из кабинета или создайте новый.");
          }
        }

        void restoreAiDraftFromUrl();

        function getCreditsFromPayload(payload: Record<string, any> | null | undefined) {
          const value = payload?.ai_credits ?? payload?.credits ?? payload?.ai_credits_total ?? payload?.balance_after;
          const numericValue = Number(value);

          return Number.isFinite(numericValue) ? numericValue : null;
        }

