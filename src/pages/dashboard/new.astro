          const name = String(field || "").trim();
          return fieldLabels[name] || fieldLabels[normalizeFieldName(name)] || name;
        }

        function isValidVin(value: unknown) {
          const vin = String(value || "").trim().toUpperCase();
          return /^[A-HJ-NPR-Z0-9]{17}$/.test(vin);
        }

        function normalizeOptionalVin(value: unknown) {
          const vin = String(value || "").trim().toUpperCase();
          return isValidVin(vin) ? vin : "";
        }

