                fields: data,
                analysis: currentAiAnalysis,
                photo_count: currentAiUploadedImages.length || selectedAiPhotos.length,
                images: currentAiUploadedImages,
              }),
            });

            if (response.status === 401) {
              recoverAuthOrRelogin();
