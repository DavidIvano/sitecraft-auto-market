                photo_quality_score: local.photo_score,
                trust_score: local.trust_score,
                next_best_actions: local.next_best_actions,
              };
              setAiMessage("Качество проверено локально. Для полной AI-проверки нужен endpoint quality-score.");
              return;
            }

            const responseText = await response.text();
            const result = readJsonResponse(responseText);

            if (!response.ok) {
              throw new Error(getXanoErrorMessage(result, responseText) || "Не удалось выполнить AI-действие. Попробуйте позже.");
            }

            const listingScore = parseOptionalAiScore(result.listing_quality_score, result.listing_score, result.score, local.score);
            const photoScore = parseOptionalAiScore(result.photo_quality_score, result.photo_score, local.photo_score);
            const trustScore = parseOptionalAiScore(result.trust_score, local.trust_score);

            setScoreCard(aiListingScore, listingScore);
            setScoreCard(aiPhotoScore, photoScore);
            setTrustScore(trustScore);
            renderList(aiWarnings, result.warnings || [], "Критичных предупреждений нет.");
            renderList(aiRecommendations, result.recommendations || [], "Черновик выглядит хорошо.");
            renderNextBestActions(result.next_best_actions || local.next_best_actions);
            currentAiScores = {
              listing_quality_score: listingScore,
              photo_quality_score: photoScore,
              trust_score: trustScore,
              next_best_actions: result.next_best_actions || local.next_best_actions,
            };
            setAiMessage("Качество объявления проверено.");
          } catch (error) {
            console.error(error);
            setAiMessage(getFriendlyErrorMessage(error, "Не удалось выполнить AI-действие. Попробуйте позже."));
          }
        });

        aiSubmitModerationButton?.addEventListener("click", async () => {
          if (isAiSubmitRunning) return;
          const apiUrl = aiDraftForm instanceof HTMLFormElement ? aiDraftForm.dataset.apiUrl : undefined;

          const authToken = getActiveAuthToken();
          if (!authToken || !apiUrl) {
            recoverAuthOrRelogin();
            return;
          }

          try {
            const currentData = getAiReviewData();
            const validation = validateListingData(currentData);
            if (!validation.ok) {
              showAiFieldErrors(validation.issues);
              throw new Error(validation.errors.join("\n"));
            }

            setAiSubmitBusy(true, "Сохраняю актуальные данные…");
            setAiMessage(isAiDraftDirty ? "Сохраняю актуальные данные…" : "Проверяю сохранённый черновик…");
            await saveConfirmedAiDraft(apiUrl, currentData);

            setAiSubmitBusy(true, "Проверяю объявление…");
            setAiMessage("Проверяю объявление…");
            setAiSubmitBusy(true, "Отправляю на модерацию…");
            setAiMessage("Отправляю объявление на модерацию…");
            const response = shouldUseNewAiEndpoints()
              ? await fetch(`${apiUrl}${apiRoute("listingsSubmitModeration", "/listings/submit-moderation")}`, {
                  method: "POST",
                  headers: {
                    Authorization: `Bearer ${authToken}`,
                    "Content-Type": "application/json",
                  },
                  body: JSON.stringify({
                    draft_id: currentAiDraftId,
                    listing_id: currentAiListingId,
                  }),
                })
              : currentAiListingId
                ? await fetch(`${apiUrl}${carSubmitRoute(currentAiListingId)}`, {
                    method: "PATCH",
                    headers: { Authorization: `Bearer ${authToken}` },
                  })
                : null;

            if (!response) {
              throw new Error("Сервер не вернул номер объявления для отправки на модерацию.");
            }

            const responseText = await response.text();
            const result = readJsonResponse(responseText);

            if (!response.ok) {
              if (response.status === 404 && shouldUseNewAiEndpoints()) {
                throw new Error("Endpoint /listings/submit-moderation не найден в Xano или сайт использует неправильный API URL.");
              }

              const fieldIssues = extractListingFieldIssues(result);
              if (fieldIssues.length) {
                showAiFieldErrors(fieldIssues);
                setAiMessage(`Объявление пока не готово к модерации. Исправьте отмеченные поля: ${fieldIssues.map((issue) => issue.message).join(" ")}`);
              }
              throw new Error(fieldIssues.map((issue) => issue.message).join("\n") || result?.message || responseText || "Не удалось отправить объявление на модерацию.");
            }

            setAiMessage("Объявление отправлено на модерацию.");
            window.location.href = `/dashboard/listings?submitted=1`;
          } catch (error) {
            console.error(error);
            if (!(aiReviewForm?.querySelector(".is-invalid"))) {
              setAiMessage(getFriendlyErrorMessage(error, "Проверьте отмеченные поля и попробуйте отправить ещё раз."));
            }
          } finally {
            setAiSubmitBusy(false);
          }
        });

        photoClear?.addEventListener("click", clearPhotos);

        photoDropzone?.addEventListener("click", (event) => {
          event.preventDefault();
          openFilePicker(photoInput);
        });

        photoDropzone?.addEventListener("dragover", (event) => {
          event.preventDefault();
          if (photoDropzone instanceof HTMLElement) {
            photoDropzone.classList.add("is-dragging");
          }
        });

        photoDropzone?.addEventListener("dragleave", () => {
          if (photoDropzone instanceof HTMLElement) {
            photoDropzone.classList.remove("is-dragging");
          }
        });

        photoDropzone?.addEventListener("drop", (event) => {
          event.preventDefault();
          const dragEvent = event as DragEvent;
          if (photoDropzone instanceof HTMLElement) {
            photoDropzone.classList.remove("is-dragging");
          }

          setPhotoFiles(Array.from(dragEvent.dataTransfer?.files || []));
        });

        photoPreviewGrid?.addEventListener("dragstart", (event) => {
          const dragEvent = event as DragEvent;
          const card = event.target instanceof HTMLElement ? event.target.closest("[data-photo-index]") : null;

          if (card instanceof HTMLElement && dragEvent.dataTransfer) {
            dragEvent.dataTransfer.setData("text/plain", card.dataset.photoIndex || "0");
          }
        });

        photoPreviewGrid?.addEventListener("dragover", (event) => {
          event.preventDefault();
        });

        photoPreviewGrid?.addEventListener("drop", (event) => {
          event.preventDefault();
          const dragEvent = event as DragEvent;
          const target = event.target instanceof HTMLElement ? event.target.closest("[data-photo-index]") : null;
          const fromIndex = Number(dragEvent.dataTransfer?.getData("text/plain") || -1);
          const toIndex = target instanceof HTMLElement ? Number(target.dataset.photoIndex || -1) : -1;
          movePhoto(fromIndex, toIndex);
        });

        photoPreviewGrid?.addEventListener("click", (event) => {
          const button = event.target instanceof HTMLElement ? event.target.closest("[data-remove-photo]") : null;
          const makeMainButton = event.target instanceof HTMLElement ? event.target.closest("[data-make-main-photo]") : null;

          if (makeMainButton instanceof HTMLElement) {
            movePhoto(Number(makeMainButton.dataset.makeMainPhoto || -1), 0);
            return;
          }

          if (button instanceof HTMLElement) {
            removePhoto(Number(button.dataset.removePhoto || -1));
          }
        });

        async function submitListing(payload: FormData) {
          const apiUrl = form instanceof HTMLFormElement ? form.dataset.apiUrl : undefined;
          const authToken = getActiveAuthToken();

          if (!authToken) {
            recoverAuthOrRelogin();
            throw new Error("Сессия истекла. Войдите снова.");
          }
          if (!apiUrl) {
            throw new Error("api url missing");
          }

          const createResponse = await fetch(`${apiUrl}${apiRoute("cars", "/cars")}`, {
            method: "POST",
            headers: {
              Authorization: `Bearer ${authToken}`,
            },
            body: payload,
          });

          if (!createResponse.ok) {
            const errorText = await createResponse.text();
            if (isWrongTokenError(errorText)) {
              throw new Error(getAuthObjectError());
            }
            throw new Error(errorText || "listing create failed");
          }

          const createdCar = await createResponse.json();
          const id = createdCar?.id;

          if (!id) {
            throw new Error("Объявление сохранено, но сервер не вернул номер объявления.");
          }

          const submitResponse = await fetch(`${apiUrl}${carSubmitRoute(id)}`, {
            method: "PATCH",
            headers: {
              Authorization: `Bearer ${authToken}`,
            },
          });

          if (!submitResponse.ok) {
            const errorText = await submitResponse.text();
            if (isWrongTokenError(errorText)) {
              throw new Error(getAuthObjectError());
            }
            throw new Error(getXanoListingError(errorText) || "Объявление сохранено, но не отправлено на модерацию.");
          }

          return submitResponse.json();
        }

        form?.addEventListener("submit", async (event) => {
          event.preventDefault();

          if (!(form instanceof HTMLFormElement) || !(message instanceof HTMLElement)) {
            return;
          }

          for (let index = 0; index < quizSteps.length; index += 1) {
            if (!validateQuizStep(index)) {
              updateQuizStep(index);
              return;
            }
          }

          syncPhotoInput();
          const formData = new FormData(form);
          const sellerPhone = String(formData.get("sellerPhone") || "").trim();
          const sellerEmail = String(formData.get("sellerEmail") || "").trim();

          if (!sellerPhone && !sellerEmail) {
            setMessage("Укажите телефон или email продавца.");
            return;
          }

          const listingValidation = validateListingData({
            title: `${String(formData.get("brand") || "")} ${String(formData.get("model") || "")} ${String(formData.get("year") || "")}`.trim(),
            brand: String(formData.get("brand") || ""),
            model: String(formData.get("model") || ""),
            price: String(formData.get("price") || ""),
            year: String(formData.get("year") || ""),
            mileage: String(formData.get("mileage") || ""),
            city: String(formData.get("location") || ""),
            country: String(formData.get("country") || ""),
            currency: String(formData.get("currency") || ""),
            fuel_type: String(formData.get("fuelType") || ""),
            vehicle_type: String(formData.get("vehicleType") || ""),
            body_type: String(formData.get("bodyType") || ""),
            transmission: String(formData.get("transmission") || ""),
            drivetrain: String(formData.get("drivetrain") || ""),
            doors: String(formData.get("doors") || ""),
            seats: String(formData.get("seats") || ""),
            color: String(formData.get("color") || ""),
            owners_count: String(formData.get("ownerCount") || ""),
            first_registration: String(formData.get("firstRegistrationDate") || ""),
            vehicle_condition: String(formData.get("condition") || ""),
            seller_type: String(formData.get("sellerType") || ""),
            seller_name: String(formData.get("sellerName") || ""),
            seller_phone: sellerPhone,
            seller_email: sellerEmail,
            vin: String(formData.get("vin") || ""),
            has_valid_tuv: String(formData.get("hasValidTuv") || ""),
            tuv_valid_until: String(formData.get("tuvValidUntil") || ""),
          });

          if (!listingValidation.ok) {
            setMessage(listingValidation.errors.join(" "));
            return;
          }

          const brand = String(formData.get("brand") || "");
          const model = String(formData.get("model") || "");
          const year = Number(formData.get("year"));
          const city = String(formData.get("location") || "");

          const payload = new FormData();
          payload.set("title", `${brand} ${model} ${year}`.trim());
          payload.set("vehicle_type", String(formData.get("vehicleType") || ""));
          payload.set("brand", brand);
          payload.set("model", model);
          payload.set("body_type", String(formData.get("bodyType") || ""));
          payload.set("engine_volume", String(formData.get("engineVolume") || ""));
          payload.set("drivetrain", String(formData.get("drivetrain") || ""));
          payload.set("year", String(year));
          payload.set("price", String(Number(formData.get("price"))));
          payload.set("mileage", String(Number(formData.get("mileage"))));
          payload.set("fuel_type", String(formData.get("fuelType") || ""));
          payload.set("transmission", String(formData.get("transmission") || ""));
          payload.set("doors", String(formData.get("doors") || ""));
          payload.set("seats", String(formData.get("seats") || ""));
          payload.set("color", String(formData.get("color") || ""));
          payload.set("currency", String(formData.get("currency") || "EUR"));
          payload.set("city", city);
          payload.set("country", String(formData.get("country") || "Германия"));
          payload.set("seller_type", String(formData.get("sellerType") || ""));
          payload.set("seller_name", String(formData.get("sellerName") || "").trim());
          payload.set("seller_phone", sellerPhone);
          payload.set("seller_email", sellerEmail);
          payload.set("owners_count", String(formData.get("ownerCount") || ""));
          payload.set("owner_count", String(formData.get("ownerCount") || ""));
          payload.set("first_registration", String(formData.get("firstRegistrationDate") || ""));
          payload.set("first_registration_date", String(formData.get("firstRegistrationDate") || ""));
          payload.set("vehicle_condition", String(formData.get("condition") || ""));
          payload.set("condition", String(formData.get("condition") || ""));
          payload.set("vin", String(formData.get("vin") || "").trim().toUpperCase());
          payload.set("has_valid_tuv", String(formData.get("hasValidTuv") || ""));
          payload.set(
            "tuv_valid_until",
            String(formData.get("hasValidTuv")) === "true" ? String(formData.get("tuvValidUntil") || "") : "",
          );
          payload.set("description", String(formData.get("description") || "").trim());

          const photoFiles = [...selectedPhotos];

          if (photoFiles.length > 8) {
            setMessage("Можно загрузить максимум 8 фото.");
            return;
          }

          try {
            let uploadedImages: Array<{ url: string; key: string; contentType: string; size: number }> = [];

            if (photoFiles.length > 0) {
              setMessage("Сжимаю и загружаю фото в хранилище...");
              uploadedImages = await uploadListingImages(photoFiles, {
                onProgress: (progressMessage) => setMessage(progressMessage),
              });

              const imageUrls = uploadedImages.map((image) => image.url);
              const imageKeys = uploadedImages.map((image) => image.key);
              payload.set("main_image_url", imageUrls[0] || "");
              payload.set("cover_image_url", imageUrls[0] || "");
              payload.set("image_urls", JSON.stringify(imageUrls));
              payload.set("image_keys", JSON.stringify(imageKeys));
              payload.set("r2_images", JSON.stringify(uploadedImages));
            }

            setMessage("Сохраняю объявление и отправляю на модерацию...");
            await submitListing(payload);

            setMessage("Объявление отправлено на модерацию. Оно появится в админ-панели.");
            form.reset();
            clearPhotos();
            updateModelsForBrand();
            updateEngineVolumesForFuel();
          } catch (error) {
            console.error(error);
            setMessage(getFriendlyErrorMessage(error, "Не удалось сохранить объявление. Проверьте данные и попробуйте ещё раз."));
          }
        });
      </script>
    </div>
  </section>
</BaseLayout>
