        // Empty values are not a 0% AI result. Number(\"\") and Number(null)
        // would otherwise create an invented score in the published listing.
        function parseOptionalAiScore(...values: unknown[]) {
          for (const value of values) {
            if (value === null || value === undefined || (typeof value === "string" && !value.trim())) continue;
            const numeric = typeof value === "number" ? value : Number(value);
            if (Number.isFinite(numeric)) return Math.max(0, Math.min(100, Math.round(numeric)));
          }
          return null;
        }

        function recoverAuthOrRelogin() {
          const token = getActiveAuthToken();
          const apiUrl = form instanceof HTMLFormElement ? form.dataset.apiUrl : undefined;
          if (!token) {
            redirectToLogin("/dashboard/new/");
            return;
          }

          void isSessionConfirmedExpired(apiUrl, token).then((expired) => {
            if (expired) {
              redirectToLogin("/dashboard/new/");
              return;
            }
            setAiMessage("Вход сохранён, но сервис временно отклонил запрос. Попробуйте ещё раз.");
          });
        }

