        function getStepTitle(index: number) {
          return ["Автомобиль", "Характеристики", "Продавец", "Фото и описание"][index] || "Шаг";
        }

        function updateQuizStep(nextStep: number) {
          const maxStep = Math.max(quizSteps.length - 1, 0);
          activeQuizStep = Math.min(Math.max(nextStep, 0), maxStep);

          quizSteps.forEach((step, index) => {
            if (step instanceof HTMLElement) {
              step.hidden = index !== activeQuizStep;
              step.classList.toggle("is-current", index === activeQuizStep);
            }
          });

          quizProgressSteps.forEach((step, index) => {
            if (step instanceof HTMLElement) {
              step.classList.toggle("is-active", index === activeQuizStep);
              step.classList.toggle("is-complete", index < activeQuizStep);
              step.setAttribute("aria-current", index === activeQuizStep ? "step" : "false");
            }
          });

          if (quizPrevButton instanceof HTMLButtonElement) {
            quizPrevButton.hidden = activeQuizStep === 0;
          }

          if (quizNextButton instanceof HTMLButtonElement) {
            quizNextButton.hidden = activeQuizStep === maxStep;
          }

          if (quizSubmitButton instanceof HTMLButtonElement) {
            quizSubmitButton.hidden = activeQuizStep !== maxStep;
          }

          if (sideSubmitButton instanceof HTMLButtonElement) {
            sideSubmitButton.hidden = activeQuizStep !== maxStep;
          }

          setMessage(`Шаг ${activeQuizStep + 1} из ${quizSteps.length}: ${getStepTitle(activeQuizStep)}.`);
        }

        function validateQuizStep(index: number) {
          const step = quizSteps[index];

          if (!(step instanceof HTMLElement)) {
            return true;
          }

          const controls = Array.from(step.querySelectorAll("input, select, textarea"));
          const invalidControl = controls.find((control) => {
            if (
              !(control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement) ||
              control.disabled ||
              !control.required
            ) {
              return false;
            }

            return !String(control.value || "").trim();
          });

          controls.forEach((control) => {
            if (control instanceof HTMLElement) {
              control.classList.remove("is-invalid");
            }
          });

          if (invalidControl instanceof HTMLElement) {
            invalidControl.classList.add("is-invalid");
            invalidControl.focus();
            setMessage("Заполните обязательные поля этого шага, чтобы продолжить.");
            return false;
          }

          return true;
        }

        function goToQuizStep(targetStep: number) {
          if (targetStep > activeQuizStep) {
            for (let index = activeQuizStep; index < targetStep; index += 1) {
              if (!validateQuizStep(index)) {
                updateQuizStep(index);
                return;
              }
            }
          }

          updateQuizStep(targetStep);
        }

        function escapeHtml(value: string) {
          return value
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
        }

