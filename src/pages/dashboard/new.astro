          const validFiles = imageFiles.filter((file) => file.size <= maxSize);
          const remainingSlots = Math.max(maxFiles - selectedAiPhotos.length, 0);

          selectedAiPhotos.push(...validFiles.slice(0, remainingSlots));
          aiPhotoRequestIdempotencyKey = "";
          if (validFiles.length > 0) markAiDraftDirty();

          if (imageFiles.length !== validFiles.length) {
            setAiMessage("Некоторые фото больше 8 МБ и не добавлены.");
          } else if (validFiles.length > remainingSlots) {
            setAiMessage(`Можно загрузить максимум ${maxFiles} фото для AI-черновика.`);
          } else {
            setAiMessage("Фото готовы. Можно создать AI-черновик.");
          }

          syncAiPhotoInput();
          renderAiPhotoPreview();
          markAiDraftDirty();
