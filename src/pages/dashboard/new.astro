        aiSuggestionList?.addEventListener("click", async (event) => {
          const target = event.target instanceof HTMLElement ? event.target : null;
          const card = target?.closest(".ai-suggestion-card");

          if (!(card instanceof HTMLElement)) {
            return;
          }

          const status = card.querySelector(".ai-suggestion-status");
          const suggestionLabel = card.querySelector("h3")?.textContent?.trim() || "AI suggestion";
          const text = getSuggestionText(card);
          const suggestionTarget = card.dataset.suggestionTarget || "description";
          const insertButton = target?.closest("[data-suggestion-insert]");
          const copyButton = target?.closest("[data-suggestion-copy]");
          const hideButton = target?.closest("[data-suggestion-hide]");

          if (hideButton instanceof HTMLElement) {
            card.remove();
            return;
          }

          if (copyButton instanceof HTMLElement) {
            await navigator.clipboard?.writeText(text);
            if (status instanceof HTMLElement) {
              status.textContent = "Скопировано";
            }
            return;
          }

          if (!(insertButton instanceof HTMLElement)) {
            return;
          }

          if (suggestionTarget === "description") {
            appendToDescription(text);
            recordAcceptedAiSuggestion("insert_suggestion", suggestionLabel, "description", text);
            if (status instanceof HTMLElement) {
              status.textContent = "Добавлено в описание";
            }
            return;
          }

          if (suggestionTarget === "title") {
            const titleControl = getAiReviewControl("title");
            const hasTitle = titleControl ? String(titleControl.value || "").trim().length > 0 : false;

            if (hasTitle && !window.confirm("Название уже заполнено. Заменить его AI-подсказкой?")) {
              return;
            }

            setAiReviewField("title", text);
            recordAcceptedAiSuggestion("insert_suggestion", suggestionLabel, "title", text);
            if (status instanceof HTMLElement) {
              status.textContent = "Название обновлено";
            }
            return;
          }

          await navigator.clipboard?.writeText(text);
          if (status instanceof HTMLElement) {
            status.textContent = "Скопировано";
          }
        });

        aiNextActionsGrid?.addEventListener("click", (event) => {
          const button = event.target instanceof HTMLElement ? event.target.closest("[data-run-next-action]") : null;
          const card = button instanceof HTMLElement ? button.closest(".ai-next-action-card") : null;

          if (!(card instanceof HTMLElement)) {
            return;
          }

          const action = card.dataset.nextAction || "";
          const field = card.dataset.nextField || "";

          if (action === "upload_more_photos") {
            aiDropzone?.scrollIntoView({ behavior: "smooth", block: "center" });
            return;
          }
          if (action === "translate_description") {
            if (aiDescriptionMode instanceof HTMLSelectElement) aiDescriptionMode.value = "de";
            void generateAiDescription("de");
            return;
          }
          if (action === "shorten_description") {
            if (aiDescriptionMode instanceof HTMLSelectElement) aiDescriptionMode.value = "short";
            void generateAiDescription("short");
            return;
          }
          if (field) {
            focusAiField(field);
            return;
          }
          if (action === "fill_mileage") focusAiField("mileage");
          if (action === "fill_price") focusAiField("price");
          if (action === "fill_city") focusAiField("city");
          if (action === "fill_description") focusAiField("description");
        });

        aiDraftForm?.addEventListener("submit", async (event) => {
          event.preventDefault();

          if (!(aiDraftForm instanceof HTMLFormElement)) {
            return;
          }

          const apiUrl = aiDraftForm.dataset.apiUrl;

          const authToken = getActiveAuthToken();
          if (!authToken || !apiUrl) {
            recoverAuthOrRelogin();
            return;
          }

          if (selectedAiPhotos.length < 1) {
            setAiMessage("Добавьте хотя бы одно фото автомобиля.");
            return;
          }

          if (selectedAiPhotos.length > 8) {
            setAiMessage("Для AI-черновика можно загрузить максимум 8 фото.");
            return;
          }

          try {
            setAiMessage("Сжимаю и загружаю фото в Cloudflare R2...");
            currentAiUploadedImages = await uploadListingImages(selectedAiPhotos, {
              onProgress: (progressMessage) => setAiMessage(progressMessage),
            });

            if (currentAiUploadedImages.length === 0) {
              throw new Error("Фото не загружено в хранилище. Нужна публичная ссылка изображения.");
            }

            const r2Images = toAiR2Images(currentAiUploadedImages);
            const r2ImagesJson = JSON.stringify(r2Images);
            const payload = new FormData();
            aiPhotoRequestIdempotencyKey ||= createAiIdempotencyKey("ai-listing-draft");
            payload.set("r2_images", r2ImagesJson);
            payload.set("mode", "analyze_only");
            payload.set("expected_status", "ai_draft");
            payload.set("idempotency_key", aiPhotoRequestIdempotencyKey);

            setAiMessage("AI анализирует фото и готовит черновик...");
            const analyzeRoute = shouldUseNewAiEndpoints()
              ? apiRoute("aiAnalyzePhotos", "/ai/listing/analyze-photos")
              : "";

            if (!analyzeRoute) {
              throw new Error("Функция AI-черновика пока не подключена в Xano. Нужен endpoint POST /ai/listing/analyze-photos.");
            }

            const endpoint = `${apiUrl}${analyzeRoute}`;
            const bodyPreview = {
              r2_images: r2ImagesJson,
              mode: "analyze_only",
              expected_status: "ai_draft",
            };

            if (isDevelopment) {
              console.log("AI analyze payload", {
                endpoint,
                r2Images,
                bodyPreview,
              });
            }

            const response = await fetch(endpoint, {
              method: "POST",
              headers: {
                Authorization: `Bearer ${authToken}`,
              },
              body: payload,
            });

            if (response.status === 401) {
              recoverAuthOrRelogin();
              return;
            }

            const responseText = await response.text();
            const data = readJsonResponse(responseText);

            if (!response.ok) {
              if (response.status === 404) {
                throw new Error("Endpoint /ai/listing/analyze-photos не найден в Xano или сайт использует неправильный API URL.");
              }

              throw new Error(getXanoErrorMessage(data, responseText) || "AI analyze failed");
            }

            renderAiDraftPreview(data);
            aiPhotoRequestIdempotencyKey = "";
            await syncAiCreditsAfterUsage(data);
            setAiMessage("AI-черновик готов. Проверьте поля и подтвердите данные перед модерацией.");
          } catch (error) {
            console.error(error);

            if (error instanceof Error && /401|unauthorized|войдите/i.test(error.message)) {
              recoverAuthOrRelogin();
              return;
            }

            setAiMessage(getFriendlyErrorMessage(error, "Не удалось создать AI-черновик. Попробуйте другое фото."));
          }
        });

        function buildAiDraftPayload(data: Record<string, string>) {
          const payload = new FormData();
          const title = data.title || [data.brand, data.model, data.year].filter(Boolean).join(" ");

          payload.set("title", title);
          payload.set("brand", data.brand || "");
          payload.set("make", data.brand || "");
          payload.set("model", data.model || "");
          payload.set("year", data.year || "");
          payload.set("price", data.price || "");
          payload.set("mileage", data.mileage || "");
          payload.set("city", data.city || "");
          payload.set("country", data.country || "Германия");
          payload.set("vehicle_type", data.vehicle_type || "");
          payload.set("body_type", data.body_type || "");
          payload.set("color", data.color || "");
          payload.set("fuel_type", data.fuel_type || "");
          payload.set("transmission", data.transmission || "");
          payload.set("drivetrain", data.drivetrain || "");
          payload.set("doors", data.doors || "");
          payload.set("seats", data.seats || "");
          payload.set("engine_volume", data.engine_volume || "");
          payload.set("owners_count", data.owners_count || "");
          payload.set("owner_count", data.owners_count || "");
          payload.set("first_registration", data.first_registration || "");
          payload.set("first_registration_date", data.first_registration || "");
          payload.set("vehicle_condition", data.vehicle_condition || "");
          payload.set("condition", data.vehicle_condition || "");
          const hasValidTuv = normalizeTuvSubmissionValue(data.has_valid_tuv);
          payload.set("has_valid_tuv", hasValidTuv);
          payload.set("tuv_valid_until", hasValidTuv === "true" ? data.tuv_valid_until || "" : "");
          payload.set("vin", data.vin || "");
          payload.set("currency", data.currency || "EUR");
          payload.set("seller_type", data.seller_type || "");
          payload.set("seller_name", data.seller_name || "");
          payload.set("seller_email", data.seller_email || "");
          payload.set("seller_phone", data.seller_phone || "");
          payload.set("status", "ai_draft");
          payload.set("moderation_status", "draft");
          payload.set("is_ai_generated", "true");
          payload.set("description", data.description || "");
          const r2Images = toAiR2Images(currentAiUploadedImages);
          payload.set("r2_images", JSON.stringify(r2Images));
          payload.set("image_urls", JSON.stringify(r2Images.map((image) => image.url)));
          payload.set("image_keys", JSON.stringify(r2Images.map((image) => image.key)));
          payload.set("main_image_url", r2Images[0]?.url || "");
          payload.set("cover_image_url", r2Images[0]?.url || "");
          const aiAnalysisPayload = {
            ...(currentAiAnalysis || {}),
            ...currentAiScores,
            accepted_ai_suggestions: acceptedAiSuggestions,
          };
          payload.set("accepted_ai_suggestions", JSON.stringify(acceptedAiSuggestions));
          payload.set("ai_analysis", JSON.stringify(aiAnalysisPayload));
          const listingScore = parseOptionalAiScore(currentAiScores.listing_quality_score);
          const photoScore = parseOptionalAiScore(currentAiScores.photo_quality_score);
          const trustScore = parseOptionalAiScore(currentAiScores.trust_score);
          if (listingScore !== null) {
            payload.set("listing_quality_score", String(listingScore));
            // Legacy alias remains only for old Xano endpoint compatibility.
            payload.set("ai_listing_score", String(listingScore));
          }
          if (photoScore !== null) payload.set("photo_quality_score", String(photoScore));
          if (trustScore !== null) payload.set("trust_score", String(trustScore));

          if (currentAiDraftId) {
            payload.set("draft_id", String(currentAiDraftId));
          }
          if (currentAiListingId) {
            payload.set("listing_id", String(currentAiListingId));
          }

          return payload;
        }

        async function saveConfirmedAiDraft(apiUrl: string, data = getAiReviewData()) {
          const authToken = getActiveAuthToken();
          if (!authToken) {
            recoverAuthOrRelogin();
            throw new Error("Сессия истекла. Войдите снова.");
          }

          const validation = validateListingData(data);

          if (!validation.ok) {
            showAiFieldErrors(validation.issues);
            throw new Error(validation.errors.join("\n"));
          }
          clearAiFieldErrors();

          const payload = buildAiDraftPayload(data);
          const draftRoute = shouldUseNewAiEndpoints()
            ? apiRoute("listingsCreateDraft", "/listings/create-draft")
            : allowLegacyAiEndpoint()
              ? apiRoute("cars", "/cars")
              : "";

          if (!draftRoute) {
            throw new Error("Endpoint /listings/create-draft не подключен. AI-черновик нельзя сохранить через старый поток.");
          }

          const response = await fetch(
            `${apiUrl}${draftRoute}`,
            {
            method: "POST",
            headers: { Authorization: `Bearer ${authToken}` },
            body: payload,
            },
          );

          const responseText = await response.text();
          const result = readJsonResponse(responseText);

          if (!response.ok) {
            if (response.status === 404 && shouldUseNewAiEndpoints()) {
              throw new Error("Endpoint /listings/create-draft не найден в Xano или сайт использует неправильный API URL.");
            }

            const fieldIssues = extractListingFieldIssues(result);
            if (fieldIssues.length) showAiFieldErrors(fieldIssues);
            throw new Error(fieldIssues.map((issue) => issue.message).join("\n") || result?.message || responseText || "Не удалось сохранить AI-черновик.");
          }

          const identity = extractAiDraftIdentity(result);
          currentAiDraftId = identity.draftId || currentAiDraftId;
          currentAiListingId = identity.listingId || currentAiListingId;

          if (!currentAiDraftId && !currentAiListingId) {
            throw new Error("Черновик сохранён, но сервер не вернул его номер.");
          }

          markAiDraftSaved();

          return result;
        }

        function buildLocalDescription(data: Record<string, string>, mode = "sales") {
          const title = data.title || [data.brand, data.model, data.year].filter(Boolean).join(" ");
          const details = [
            data.year ? `${data.year} год` : "",
            data.mileage ? `пробег ${data.mileage} км` : "",
            data.fuel_type ? `топливо ${data.fuel_type}` : "",
            data.transmission ? `коробка ${data.transmission}` : "",
            data.body_type ? `кузов ${data.body_type}` : "",
            data.color ? `цвет ${data.color}` : "",
          ].filter(Boolean);
          const factLine = details.length ? details.join(", ") : "данные нужно уточнить у продавца";
          const name = title || "Автомобиль";

          if (mode === "short") {
            return `${name} в продаже. ${factLine}. Проверьте состояние и документы при осмотре.`.replace(/\s+/g, " ").trim();
          }

          if (mode === "technical") {
            return `${name}. ${factLine}. Описание носит информационный характер: пробег, комплектацию, TÜV/HU, сервисную историю и техническое состояние нужно проверить по документам и при осмотре.`.replace(/\s+/g, " ").trim();
          }

          if (mode === "de") {
            return `${[data.brand, data.model].filter(Boolean).join(" ") || "Fahrzeug"}, Baujahr ${data.year || "nicht angegeben"}, Kraftstoff: ${data.fuel_type || "nicht angegeben"}, Getriebe: ${data.transmission || "nicht angegeben"}, Kilometerstand: ${data.mileage || "nicht angegeben"} km. Bitte Zustand, Ausstattung und Servicehistorie vor Ort prüfen.`.replace(/\s+/g, " ").trim();
          }

          if (mode === "kleinanzeigen") {
            return `${name} zu verkaufen. ${factLine}. Besichtigung nach Absprache möglich. Bei Interesse gerne melden.`.replace(/\s+/g, " ").trim();
          }

          if (mode === "whatsapp") {
            return `Здравствуйте! Актуально объявление: ${name}. ${factLine}. Можно договориться о просмотре и уточнить детали по состоянию автомобиля.`.replace(/\s+/g, " ").trim();
          }

          return `${name} в продаже. ${factLine}. Автомобиль подготовлен к просмотру, данные объявления подтверждаются продавцом перед модерацией. Рекомендуем уточнить сервисную историю, комплектацию и состояние при контакте.`.replace(/\s+/g, " ").trim();
        }

        function applyDescriptionPreview(action: "insert" | "replace") {
          if (!currentAiDescriptionPreview) {
            return;
          }

          if (action === "replace") {
            replaceDescription(currentAiDescriptionPreview);
          } else {
            appendToDescription(currentAiDescriptionPreview);
          }

          recordAcceptedAiSuggestion("generated_description", getDescriptionModeLabel(getDescriptionMode()), "description", currentAiDescriptionPreview);
          if (aiDescriptionPreviewStatus instanceof HTMLElement) {
            aiDescriptionPreviewStatus.textContent = action === "replace" ? "Описание заменено." : "Описание вставлено.";
          }
          setAiMessage("Описание вставлено.");
        }

        async function generateAiDescription(mode = getDescriptionMode()) {
          const apiUrl = aiDraftForm instanceof HTMLFormElement ? aiDraftForm.dataset.apiUrl : undefined;
          const data = getAiReviewData();

          const authToken = getActiveAuthToken();
          if (!authToken || !apiUrl) {
            recoverAuthOrRelogin();
            return;
          }

          try {
            setAiMessage("Генерирую описание...");

            if (!shouldUseNewAiEndpoints()) {
              const fallback = buildLocalDescription(data, mode);
              showDescriptionPreview(fallback, mode);
              if (!getDescriptionControlValue()) {
                replaceDescription(fallback);
                recordAcceptedAiSuggestion("generated_description", getDescriptionModeLabel(mode), "description", fallback);
                setAiMessage("Описание добавлено. Проверьте перед отправкой.");
              } else {
                setAiMessage("AI предложил описание. Проверьте текст перед вставкой.");
              }
              return;
            }

            const response = await fetch(`${apiUrl}${apiRoute("aiGenerateDescription", "/ai/listing/generate-description")}`, {
              method: "POST",
              headers: {
                Authorization: `Bearer ${authToken}`,
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                fields: data,
                analysis: currentAiAnalysis,
                r2_images: currentAiUploadedImages,
                mode,
              }),
            });

            if (response.status === 401) {
              recoverAuthOrRelogin();
              return;
            }

            let result: Record<string, any> = {};
            let description = "";
            let usedFallback = false;

            if (response.status === 404) {
              description = buildLocalDescription(data, mode);
              usedFallback = true;
            } else {
              const responseText = await response.text();
              result = readJsonResponse(responseText);

              if (!response.ok) {
                throw new Error(getXanoErrorMessage(result, responseText) || "Не удалось выполнить AI-действие. Попробуйте позже.");
              }

              description = firstValue(result.description, result.suggested_description, buildLocalDescription(data, mode));
            }

            showDescriptionPreview(description, String(result.mode || mode));
            renderList(aiWarnings, [...(currentAiAnalysis?.warnings || []), ...(result.warnings || [])], "Критичных предупреждений нет.");
            renderList(aiRecommendations, [...(currentAiAnalysis?.recommendations || []), ...(result.recommendations || [])], "Черновик выглядит хорошо.");

            if (!getDescriptionControlValue()) {
              replaceDescription(description);
              recordAcceptedAiSuggestion("generated_description", getDescriptionModeLabel(mode), "description", description);
              setAiMessage(usedFallback ? "Описание создано локально. Для полной AI-версии нужен endpoint generate-description." : "Описание добавлено. Проверьте перед отправкой.");
            } else {
              setAiMessage(usedFallback ? "Описание создано локально. Для полной AI-версии нужен endpoint generate-description." : "AI предложил описание. Проверьте текст перед вставкой.");
            }
          } catch (error) {
            console.error(error);
            if (error instanceof Error && /401|unauthorized|войдите/i.test(error.message)) {
              recoverAuthOrRelogin();
              return;
            }
            setAiMessage(getFriendlyErrorMessage(error, "Не удалось выполнить AI-действие. Попробуйте позже."));
          }
        }

        aiConfirmButton?.addEventListener("click", async () => {
          const apiUrl = aiDraftForm instanceof HTMLFormElement ? aiDraftForm.dataset.apiUrl : undefined;

