        }

        function renderList(container: Element | null, values: unknown[], emptyText: string) {
          if (!(container instanceof HTMLElement)) {
            return;
          }

          const items = values
            .map((value) => String(value || "").trim())
            .filter(Boolean);

          container.innerHTML = items.length
            ? items.map((value) => `<li>${escapeHtml(value)}</li>`).join("")
            : `<li>${escapeHtml(emptyText)}</li>`;
        }

        function renderFieldList(container: Element | null, values: unknown[], emptyText: string) {
          const labels = values
            .map((value) => getFieldLabel(value))
            .filter(Boolean);

          renderList(container, Array.from(new Set(labels)), emptyText);
        }

        function getAiReviewControl(name: string) {
          if (!(aiReviewForm instanceof HTMLFormElement)) {
            return null;
          }

          const control = aiReviewForm.elements.namedItem(name);
          if (control instanceof RadioNodeList) {
            return Array.from(control).find((item) => item instanceof HTMLInputElement && item.checked)
              || Array.from(control).find((item) => item instanceof HTMLInputElement)
              || null;
          }

          return control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement ? control : null;
        }

        function setFormField(name: string, value: unknown) {
          if (aiReviewForm instanceof HTMLFormElement) {
            const namedControl = aiReviewForm.elements.namedItem(name);
            if (namedControl instanceof RadioNodeList) {
              const stringValue = String(value ?? "").trim();
              const radio = Array.from(namedControl).find(
                (item) => item instanceof HTMLInputElement && item.value === stringValue,
              );
              if (radio instanceof HTMLInputElement) {
                radio.checked = true;
                radio.dispatchEvent(new Event("change", { bubbles: true }));
              }
              return radio ? null : `AI вернул поле "${getFieldLabel(name)}" со значением "${stringValue}", которое нужно подтвердить вручную.`;
            }
          }

          const control = getAiReviewControl(name);
          const stringValue = String(value ?? "").trim();

          if (!control || value === undefined || value === null || stringValue === "") {
            return null;
          }

          if (control instanceof HTMLSelectElement) {
            const hasOption = Array.from(control.options).some((option) => option.value === stringValue);

            if (!hasOption) {
              control.value = "";
              return `AI вернул поле "${getFieldLabel(name)}" со значением "${stringValue}", но такого варианта нет в форме.`;
            }

            control.value = stringValue;
            control.dispatchEvent(new Event("change", { bubbles: true }));
            return null;
          }

          control.value = stringValue;
          control.dispatchEvent(new Event("input", { bubbles: true }));
          return null;
        }

        function setAiReviewField(name: string, value: unknown) {
          return setFormField(name, value);
        }

