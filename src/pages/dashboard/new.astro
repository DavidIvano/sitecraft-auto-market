          const container = scope.querySelector(fieldSelector);
          const input = container?.querySelector('input[type="month"]');
          const hasValidTuv = selected instanceof HTMLInputElement ? selected.value : "";

          if (container instanceof HTMLElement) container.hidden = hasValidTuv !== "true";
          if (input instanceof HTMLInputElement) {
            input.required = hasValidTuv === "true";
            input.disabled = hasValidTuv === "false";
            if (hasValidTuv === "false") input.value = "";
          }
        }

