        function clearAiFieldErrors() {
          if (!(aiReviewForm instanceof HTMLFormElement)) return;

          aiReviewForm.querySelectorAll(".is-invalid").forEach((control) => {
            control.classList.remove("is-invalid");
            control.removeAttribute("aria-invalid");
            control.removeAttribute("aria-describedby");
          });
          aiReviewForm.querySelectorAll("[data-field-error]").forEach((node) => node.remove());
          aiDropzone?.classList.remove("is-invalid");
          aiDropzone?.removeAttribute("aria-invalid");
        }

        function showAiFieldErrors(issues: ListingFieldIssue[]) {
          clearAiFieldErrors();
          let firstControl: HTMLElement | null = null;

          issues.forEach((issue, index) => {
            const controlName = BACKEND_FIELD_TO_CONTROL[issue.field] || issue.field;
            if (controlName === "photos") {
              if (aiDropzone instanceof HTMLElement) {
                aiDropzone.classList.add("is-invalid");
                aiDropzone.setAttribute("aria-invalid", "true");
                firstControl ||= aiDropzone;
              }
              return;
            }

            const control = getAiReviewControl(controlName);
            if (!control) return;

            control.classList.add("is-invalid");
            control.setAttribute("aria-invalid", "true");
            const fieldContainer = control.closest("label, fieldset, [data-ai-field]");
            if (!(fieldContainer instanceof HTMLElement)) return;

            const errorId = `ai-field-error-${controlName}-${index}`;
            const errorNode = document.createElement("small");
            errorNode.id = errorId;
            errorNode.className = "field-error";
            errorNode.dataset.fieldError = controlName;
            errorNode.textContent = issue.message;
            fieldContainer.append(errorNode);
            control.setAttribute("aria-describedby", errorId);
            firstControl ||= control;
          });

          setAiActionStep("review");
          if (aiReviewStatus instanceof HTMLElement) aiReviewStatus.textContent = "Нужно исправить";
          const targetControl = firstControl as HTMLElement | null;
          if (targetControl) {
            targetControl.scrollIntoView({ behavior: "smooth", block: "center" });
            targetControl.focus();
          }
