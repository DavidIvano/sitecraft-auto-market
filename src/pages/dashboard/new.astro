        async function loadAiCredits() {
          const apiUrl = form instanceof HTMLFormElement ? form.dataset.apiUrl : undefined;

          const authToken = getActiveAuthToken();
          if (!authToken || !apiUrl || !(aiCreditBalance instanceof HTMLElement)) {
            return;
          }

          try {
            const response = await fetch(`${apiUrl}${apiRoute("credits", "/me/credits")}`, {
              headers: { Authorization: `Bearer ${authToken}` },
            });

            if (!response.ok) {
              aiCreditBalance.textContent = "0";
              return;
            }

            const credits = await response.json();
            setAiCreditsBalance(Number(credits.ai_credits_total ?? credits.ai_credits ?? credits.credits ?? 0));
          } catch {
            aiCreditBalance.textContent = "0";
          }
        }

        async function syncAiCreditsAfterUsage(payload: Record<string, any> | null | undefined) {
          const directBalance = getCreditsFromPayload(payload);

          if (directBalance !== null) {
            setAiCreditsBalance(directBalance);
            return;
          }

          await loadAiCredits();
        }

