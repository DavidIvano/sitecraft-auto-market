            const response = await fetch(`${apiUrl}${apiRoute("aiQualityScore", "/ai/listing/quality-score")}`, {
              method: "POST",
              headers: {
                Authorization: `Bearer ${authToken}`,
                "Content-Type": "application/json",
              },
