---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { API_ROUTES } from "../../lib/apiRoutes";
import {
  bodyTypes,
  carBrands,
  carConditions,
  colors,
  doorCounts,
  drivetrains,
  engineVolumeOptionsByFuel,
  fuelTypes,
  carModelsByBrand,
  vehicleTypes,
  seatCounts,
  sellerTypes,
  transmissions,
} from "../../data/carOptions";

const currentYear = new Date().getFullYear();
const years = Array.from({ length: currentYear - 1980 + 1 }, (_, index) => currentYear - index);

const xanoApiUrl = import.meta.env.PUBLIC_XANO_API_URL;
const useAiListingEndpoints = import.meta.env.PUBLIC_USE_AI_LISTING_ENDPOINTS !== "false";
const allowLegacyAiGenerate = import.meta.env.PUBLIC_ALLOW_LEGACY_AI_GENERATE === "true";
---

<BaseLayout title="Добавить объявление" noindex>
  <section class="section page-hero new-listing-hero">
    <div class="container">
      <p class="eyebrow">Новое объявление</p>
      <h1>Новое объявление</h1>
      <p class="lead">
        Создайте объявление по фото через AI или заполните данные вручную. Можно загрузить 1–8 фото и расставить их в нужном порядке.
        Первое фото станет главным в карточке и на странице автомобиля.
      </p>

      <div class="listing-mode-switch" aria-label="Выберите способ создания объявления">
        <button class="is-active" type="button" data-listing-mode="ai">Создать через AI</button>
        <button type="button" data-listing-mode="manual">Заполнить вручную</button>
      </div>

      <section class="ai-draft-panel" aria-labelledby="ai-draft-title" data-mode-panel="ai">
        <div>
          <p class="eyebrow">AI-помощник</p>
          <h2 id="ai-draft-title">Создать умный черновик по фото</h2>
          <p>
            Загрузите от 1 до 8 фотографий. Мы предложим основные данные, а вы сможете всё проверить и изменить.
          </p>
          <div class="ai-model-pills" aria-label="Помощь с объявлением">
            <span>Фото анализируются автоматически</span>
          </div>
          <div class="ai-credit-pill">
            <span>AI-кредиты:</span>
            <strong id="ai-credit-balance">проверяю...</strong>
            <a href="/dashboard/billing?product=ai_credits_10">Купить 10</a>
          </div>
          <ol class="ai-flow-steps" aria-label="Шаги AI создания объявления">
            <li class="is-active"><span>1</span><strong>Фото</strong><small>1–8 изображений</small></li>
            <li><span>2</span><strong>Анализ</strong><small>AI заполнит уверенные поля</small></li>
            <li><span>3</span><strong>Подтверждение</strong><small>Проверка только нужных данных</small></li>
            <li><span>4</span><strong>Модерация</strong><small>Отправка после подтверждения</small></li>
          </ol>
        </div>
        <form
          class="ai-draft-form"
          id="ai-draft-form"
          data-api-url={xanoApiUrl}
          data-use-ai-listing-endpoints={String(useAiListingEndpoints)}
          data-allow-legacy-ai-generate={String(allowLegacyAiGenerate)}
        >
          <input
            class="photo-input"
            id="ai-photo-input"
            type="file"
            name="photos"
            accept="image/avif,image/webp,image/jpeg,image/png"
            multiple
            data-max-files="8"
            data-max-size="8388608"
          />
          <label class="ai-draft-dropzone" for="ai-photo-input" data-ai-dropzone>
            <span class="photo-dropzone-icon">+</span>
            <strong>Выберите фотографии автомобиля</strong>
            <small>1–8 изображений, до 8 МБ каждое. После анализа проверьте предложенные данные.</small>
          </label>
          <div class="photo-preview-toolbar">
            <span id="ai-photo-count">0 / 8 фото</span>
            <button class="button button-light button-small" type="button" id="ai-photo-clear" hidden>Очистить</button>
          </div>
          <div class="ai-photo-preview-grid" id="ai-photo-preview-grid" aria-live="polite">
            <div class="photo-empty-state">Фото для AI пока не выбраны.</div>
          </div>
          <button class="button button-dark full-width" type="submit">Создать черновик по фото</button>
          <p class="form-message" id="ai-draft-message">Объявление не будет опубликовано без вашей проверки.</p>
        </form>
      </section>

      <section class="ai-draft-preview" id="ai-draft-preview" hidden aria-labelledby="ai-review-title">
        <div class="section-heading ai-review-heading">
          <span class="section-step">AI</span>
          <div>
            <p class="eyebrow">Проверка черновика</p>
            <h2 id="ai-review-title">Подтвердите данные перед модерацией</h2>
            <p>AI не публикует объявление сам. Проверьте поля, исправьте неточности и только потом отправьте объявление модератору.</p>
          </div>
        </div>

        <div class="ai-review-summary">
          <article>
            <span>Качество объявления</span>
            <strong id="ai-listing-score">—</strong>
          </article>
          <article>
            <span>Качество фото</span>
            <strong id="ai-photo-score">—</strong>
          </article>
          <article>
            <span>Статус проверки</span>
            <strong id="ai-review-status">Нужно подтвердить</strong>
          </article>
          <article class="ai-trust-score">
            <span>Доверие к объявлению</span>
            <strong id="ai-trust-score">—</strong>
            <small class="ai-score-label" id="ai-trust-label">AI проверяет полноту данных, а не техническое состояние автомобиля.</small>
          </article>
        </div>

        <div class="ai-fill-overview" id="ai-fill-overview" hidden>
          <article>
            <h3>AI заполнил</h3>
            <ul id="ai-autofilled-fields"><li>После анализа появятся поля.</li></ul>
          </article>
          <article>
            <h3>Нужно подтвердить</h3>
            <ul id="ai-confirm-fields"><li>Пока нечего подтверждать.</li></ul>
          </article>
          <article>
            <h3>Заполните вручную</h3>
            <ul id="ai-manual-fields"><li>После анализа появятся пропущенные поля.</li></ul>
          </article>
        </div>

        <div class="ai-review-notes">
          <div>
            <h3>Нужно подтвердить</h3>
            <ul id="ai-missing-fields"><li>После анализа здесь появятся поля для проверки.</li></ul>
          </div>
          <div>
            <h3>Предупреждения</h3>
            <ul id="ai-warnings"><li>Пока предупреждений нет.</li></ul>
          </div>
          <div>
            <h3>Рекомендации</h3>
            <ul id="ai-recommendations"><li>AI подскажет, как улучшить объявление.</li></ul>
          </div>
        </div>

        <form class="ai-review-form" id="ai-review-form">
          <div class="section-heading">
            <span class="section-step">AI</span>
            <div>
              <h2>Поля объявления</h2>
              <p>Значок уверенности показывает, насколько AI доверяет распознанному значению.</p>
            </div>
          </div>
          <div class="form-grid ai-review-grid">
            <label class="full-field">
              <span>Название объявления <b data-confidence-for="title">нужно подтвердить</b></span>
              <input type="text" name="title" placeholder="Например, Ford Galaxy 2018" required />
            </label>
            <label>
              <span>Марка <b data-confidence-for="make">нужно подтвердить</b></span>
              <input type="text" name="brand" placeholder="Ford" required />
            </label>
            <label>
              <span>Модель <b data-confidence-for="model">нужно подтвердить</b></span>
              <input type="text" name="model" placeholder="Galaxy" required />
            </label>
            <label>
              <span>Год <b data-confidence-for="year">нужно подтвердить</b></span>
              <input type="number" name="year" min="1950" max={currentYear} placeholder="2018" required />
            </label>
            <label>
              <span>Пробег, км <b data-confidence-for="mileage">вручную</b></span>
              <input type="number" name="mileage" min="0" step="1" placeholder="85000" required />
            </label>
            <label>
              <span>Цена, € <b data-confidence-for="price">вручную</b></span>
              <input type="number" name="price" min="100" max="500000" step="1" placeholder="25000" required />
            </label>
            <label>
              <span>Город <b data-confidence-for="city">вручную</b></span>
              <input type="text" name="city" placeholder="Берлин" required />
            </label>
            <label>
              <span>Страна</span>
              <input type="text" name="country" value="Германия" required />
            </label>
            <label>
              <span>Валюта</span>
              <select name="currency" required>
                <option value="EUR">EUR</option>
              </select>
            </label>
            <label>
              <span>Тип транспорта <b data-confidence-for="vehicle_type">нужно подтвердить</b></span>
              <select name="vehicle_type">
                <option value="">Выберите тип транспорта</option>
                {vehicleTypes.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>
            <label>
              <span>Кузов <b data-confidence-for="body_type">нужно подтвердить</b></span>
              <select name="body_type">
                <option value="">Выберите кузов</option>
                {bodyTypes.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>
            <label>
              <span>Цвет <b data-confidence-for="color">нужно подтвердить</b></span>
              <select name="color">
                <option value="">Выберите цвет</option>
                {colors.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>
            <label>
              <span>Топливо <b data-confidence-for="fuel_type">нужно подтвердить</b></span>
              <select name="fuel_type" required>
                <option value="">Выберите топливо</option>
                {fuelTypes.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>
            <label>
              <span>Объем двигателя <b data-confidence-for="engine_volume">нужно подтвердить</b></span>
              <input type="text" name="engine_volume" placeholder="Например, 2.0 л" />
            </label>
            <label>
              <span>Коробка передач <b data-confidence-for="transmission">нужно подтвердить</b></span>
              <select name="transmission" required>
                <option value="">Выберите коробку</option>
                {transmissions.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>
            <label>
              <span>Привод <b data-confidence-for="drivetrain">нужно подтвердить</b></span>
              <select name="drivetrain" required>
                <option value="">Выберите привод</option>
                {drivetrains.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>
            <label>
              <span>Двери <b data-confidence-for="doors">нужно подтвердить</b></span>
              <select name="doors">
                <option value="">Выберите двери</option>
                {doorCounts.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>
            <label>
              <span>Места <b data-confidence-for="seats">нужно подтвердить</b></span>
              <select name="seats">
                <option value="">Выберите места</option>
                {seatCounts.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>
            <label>
              <span>Количество владельцев <b data-confidence-for="owners_count">вручную</b></span>
              <select name="owners_count" required>
                <option value="">Выберите количество</option>
                <option value="1">1 владелец</option>
                <option value="2">2 владельца</option>
                <option value="3">3 владельца</option>
                <option value="4">4 владельца</option>
                <option value="5">5 и больше</option>
              </select>
            </label>
            <label>
              <span>Дата первой регистрации <b data-confidence-for="first_registration">нужно подтвердить</b></span>
              <input type="month" name="first_registration" required />
            </label>
            <label>
              <span>Состояние автомобиля <b data-confidence-for="vehicle_condition">нужно подтвердить</b></span>
              <select name="vehicle_condition" required>
                <option value="">Выберите состояние</option>
                {carConditions.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>
            <fieldset class="tuv-choice-field full-field" data-ai-field="has_valid_tuv">
              <legend>TÜV / HU действует? <b data-confidence-for="has_valid_tuv">нужно подтвердить</b></legend>
              <div class="segmented-choice">
                <label><input type="radio" name="has_valid_tuv" value="true" required /> Да</label>
                <label><input type="radio" name="has_valid_tuv" value="false" required /> Нет</label>
              </div>
            </fieldset>
            <label data-tuv-until-field>
              <span>TÜV / HU действует до <b data-confidence-for="tuv_valid_until">вручную</b></span>
              <input type="month" name="tuv_valid_until" />
            </label>
            <label>
              <span>Тип продавца</span>
              <select name="seller_type" required>
                <option value="">Выберите тип продавца</option>
                {sellerTypes.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>
            <label>
              <span>Имя продавца</span>
              <input type="text" name="seller_name" placeholder="Ваше имя" required />
            </label>
            <label>
              <span>Телефон продавца</span>
              <input type="tel" name="seller_phone" placeholder="+49 ..." />
            </label>
            <label>
              <span>Email продавца</span>
              <input type="email" name="seller_email" placeholder="name@example.com" />
            </label>
            <p class="form-field-hint full-field">Укажите хотя бы один способ связи: телефон или email.</p>
            <label>
              <span>VIN, если есть</span>
              <input type="text" name="vin" placeholder="Необязательно" />
            </label>
            <label class="full-field">
              <span>Описание</span>
              <textarea name="description" rows="5" placeholder="AI предложит текст, вы можете отредактировать его перед модерацией."></textarea>
            </label>
          </div>
          <div class="ai-review-actions">
            <button class="button button-dark" type="button" id="ai-confirm-data">Сохранить черновик</button>
            <div class="ai-action-panel" id="ai-description-action-panel" hidden>
              <label class="ai-description-mode">
                <span>Тип описания</span>
                <select id="ai-description-mode">
                  <option value="sales">Продающее описание</option>
                  <option value="short">Короткое описание</option>
                  <option value="technical">Честное техническое описание</option>
                  <option value="de">Перевести на немецкий</option>
                  <option value="kleinanzeigen">Текст для Kleinanzeigen</option>
                  <option value="whatsapp">Текст для WhatsApp</option>
                </select>
              </label>
              <button class="button button-light" type="button" id="ai-generate-description">Помочь с описанием</button>
            </div>
            <button class="button button-light" type="button" id="ai-quality-score" hidden>Проверить качество объявления</button>
            <button class="button button-dark" type="button" id="ai-submit-moderation" hidden>Отправить на модерацию</button>
          </div>
        </form>

        <section class="ai-description-preview" id="ai-description-preview" hidden aria-labelledby="ai-description-preview-title">
          <div>
            <h3 id="ai-description-preview-title">AI предложил описание</h3>
            <p id="ai-description-preview-text"></p>
          </div>
          <div class="ai-description-preview-actions">
            <button class="button button-dark button-small" type="button" id="ai-description-insert">Вставить в описание</button>
            <button class="button button-light button-small" type="button" id="ai-description-replace">Заменить текущее</button>
            <button class="button button-light button-small" type="button" id="ai-description-copy">Скопировать</button>
            <button class="button button-light button-small" type="button" id="ai-description-shorten">Сделать короче</button>
            <button class="button button-light button-small" type="button" id="ai-description-translate">Перевести на немецкий</button>
          </div>
          <span class="ai-description-preview-status" id="ai-description-preview-status" aria-live="polite"></span>
        </section>

        <section class="ai-suggestions" id="ai-suggestions" hidden aria-labelledby="ai-suggestions-title">
          <div class="section-heading">
            <span class="section-step">+</span>
            <div>
              <h2 id="ai-suggestions-title">AI предлагает улучшения</h2>
              <p id="ai-suggestions-note">Можно вставить подсказки в черновик или скопировать их.</p>
            </div>
          </div>
          <div class="ai-suggestion-list" id="ai-suggestion-list"></div>
        </section>

        <section class="ai-next-actions" id="ai-next-best-actions" hidden aria-labelledby="ai-next-best-actions-title">
          <div class="section-heading">
            <span class="section-step">→</span>
            <div>
              <h2 id="ai-next-best-actions-title">Что улучшить дальше</h2>
              <p>Подсказки повышают полноту данных и доверие покупателей.</p>
            </div>
          </div>
          <div class="ai-next-actions-grid" data-ai-next-actions></div>
        </section>
      </section>

      <form class="listing-form listing-form-enhanced is-quiz" id="new-listing-form" data-api-url={xanoApiUrl} novalidate data-mode-panel="manual" hidden>
        <div class="listing-quiz-progress" aria-label="Шаги добавления объявления">
          <button class="quiz-progress-step is-active" type="button" data-quiz-jump="0">
            <span>1</span>
            Автомобиль
          </button>
          <button class="quiz-progress-step" type="button" data-quiz-jump="1">
            <span>2</span>
            Характеристики
          </button>
          <button class="quiz-progress-step" type="button" data-quiz-jump="2">
            <span>3</span>
            Продавец
          </button>
          <button class="quiz-progress-step" type="button" data-quiz-jump="3">
            <span>4</span>
            Фото
          </button>
        </div>
        <div class="listing-workspace">
          <div class="listing-main-column">
        <fieldset class="form-section form-section-highlight" data-quiz-step="0">
          <div class="section-heading">
            <span class="section-step">1</span>
            <div>
              <h2>Автомобиль</h2>
              <p>Сначала выберите марку. После этого появятся только модели этой марки.</p>
            </div>
          </div>
          <div class="form-grid">
            <label>
              <span>Тип транспортного средства</span>
              <select name="vehicleType" required>
                <option value="">Выберите тип транспорта</option>
                {vehicleTypes.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>

            <label>
              <span>Марка автомобиля</span>
              <select name="brand" required data-brand-select>
                <option value="">Выберите марку</option>
                {carBrands.map((brand) => <option value={brand}>{brand}</option>)}
              </select>
            </label>

            <label>
              <span>Модель автомобиля</span>
              <select name="model" required data-model-select disabled>
                <option value="">Сначала выберите марку</option>
              </select>
            </label>

            <label>
              <span>Год выпуска</span>
              <select name="year" required>
                <option value="">Выберите год</option>
                {years.map((year) => <option value={year}>{year}</option>)}
              </select>
            </label>

            <label>
              <span>Цена</span>
              <input type="number" name="price" min="0" step="1" placeholder="25000" required />
            </label>

            <label>
              <span>Пробег</span>
              <input type="number" name="mileage" min="0" step="1" placeholder="85000" required />
            </label>

            <label>
              <span>Город / местоположение</span>
              <input type="text" name="location" placeholder="Берлин" required />
            </label>
            <label>
              <span>Страна</span>
              <input type="text" name="country" value="Германия" required />
            </label>
            <label>
              <span>Валюта</span>
              <select name="currency" required>
                <option value="EUR">EUR</option>
              </select>
            </label>
          </div>
        </fieldset>

        <fieldset class="form-section" data-quiz-step="1">
          <div class="section-heading">
            <span class="section-step">2</span>
            <div>
              <h2>Характеристики</h2>
              <p>Эти параметры помогают покупателю быстро понять, подходит ли автомобиль.</p>
            </div>
          </div>
          <div class="form-grid">
            <label>
              <span>Тип кузова</span>
              <select name="bodyType" required>
                <option value="">Выберите тип кузова</option>
                {bodyTypes.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>

            <label>
              <span>Вид топлива</span>
              <select name="fuelType" required data-fuel-select>
                <option value="">Выберите топливо</option>
                {fuelTypes.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>

            <label>
              <span>Объем двигателя</span>
              <select name="engineVolume" data-engine-volume-select disabled>
                <option value="">Сначала выберите топливо</option>
              </select>
            </label>

            <label>
              <span>Коробка передач</span>
              <select name="transmission" required>
                <option value="">Выберите коробку</option>
                {transmissions.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>

            <label>
              <span>Привод</span>
              <select name="drivetrain" required>
                <option value="">Выберите привод</option>
                {drivetrains.map((item) => <option value={item}>{item}</option>)}
              </select>
            </label>

            <label>
              <span>Количество дверей</span>
              <select name="doors" required>
                <option value="">Выберите двери</option>
