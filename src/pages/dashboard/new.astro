            if (response.status === 404) {
              setScoreCard(aiListingScore, local.score);
              setScoreCard(aiPhotoScore, local.photo_score);
              setTrustScore(local.trust_score);
              renderList(aiWarnings, local.warnings, "Критичных предупреждений нет.");
              renderList(aiRecommendations, local.recommendations, "Черновик выглядит хорошо.");
              renderNextBestActions(local.next_best_actions);
              currentAiScores = {
