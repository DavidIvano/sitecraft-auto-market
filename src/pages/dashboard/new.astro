            "title", "brand", "model", "year", "mileage", "price", "currency", "city", "country",
            "vehicle_type", "body_type", "fuel_type", "transmission", "drivetrain", "doors", "seats", "color",
            "owners_count", "first_registration", "vehicle_condition", "seller_type", "seller_name", "has_valid_tuv",
          ]);
          const missingFields = new Set(
            (analysis.missing_fields || []).map((field: unknown) => String(field || "").replace("make", "brand")),
          );

          Array.from(aiReviewForm.querySelectorAll(".form-grid > label, .form-grid > [data-ai-field]")).forEach((fieldContainer) => {
            const control = fieldContainer.querySelector("input, select, textarea");

            if (!(control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement)) {
              return;
            }

            const name = control.name;
            const hasValue = control.type === "radio"
              ? Boolean(aiReviewForm.querySelector(`input[name="${name}"]:checked`))
              : String(control.value || "").trim().length > 0;
            const shouldShow = requiredFields.has(name) || missingFields.has(name) || hasValue;
            if (fieldContainer instanceof HTMLElement) fieldContainer.hidden = !shouldShow;
          });
        }

        function setAiActionStep(step: "review" | "confirmed") {
          if (aiConfirmButton instanceof HTMLButtonElement) {
            aiConfirmButton.hidden = step !== "review";
          }
          if (aiDescriptionActionPanel instanceof HTMLElement) {
            aiDescriptionActionPanel.hidden = step !== "confirmed";
          }
          if (aiQualityScoreButton instanceof HTMLButtonElement) {
            aiQualityScoreButton.hidden = step !== "confirmed";
          }
          if (aiSubmitModerationButton instanceof HTMLButtonElement) {
            aiSubmitModerationButton.hidden = step !== "confirmed";
          }
        }

        function getAiReviewData() {
          if (!(aiReviewForm instanceof HTMLFormElement)) {
            return {} as Record<string, string>;
          }

          const data = Object.fromEntries(
            Array.from(new FormData(aiReviewForm).entries()).map(([key, value]) => [key, String(value).trim()]),
          ) as Record<string, string>;

          return data;
        }

        function setConfidenceBadge(field: string, value: unknown) {
          const badge = document.querySelector(`[data-confidence-for="${confidenceBadgeName(field)}"]`);
          const confidence = normalizeConfidence(value);

          if (!(badge instanceof HTMLElement)) {
            return;
          }

          if (!confidence) {
            badge.textContent = "Нужно подтвердить";
            badge.dataset.level = "low";
            return;
          }

          badge.dataset.level = confidence >= 80 ? "high" : confidence >= 55 ? "medium" : "low";
          badge.textContent = confidence >= 80 ? `AI уверен: ${confidence}%` : confidence >= 55 ? `Проверьте: ${confidence}%` : "Нужно подтвердить";
        }

        function asRecord(value: unknown) {
          return value && typeof value === "object" && !Array.isArray(value) ? (value as Record<string, any>) : {};
        }

        function normalizeConfidenceMap(raw: Record<string, any>) {
          const source = asRecord(raw.field_confidence || raw.fieldConfidence || raw.confidence || {});
          const result: Record<string, number> = {};

          Object.entries(source).forEach(([field, value]) => {
            result[normalizeFieldName(field)] = normalizeConfidence(value);
          });

          return result;
        }

        function normalizeAutoFillMap(raw: Record<string, any>, confidence: Record<string, number>) {
          const source = asRecord(raw.auto_fill_allowed || raw.autoFillAllowed || {});
          const result: Record<string, boolean> = {};

          Object.entries(source).forEach(([field, value]) => {
            result[normalizeFieldName(field)] = value === true || value === "true" || value === 1;
          });

          Object.entries(confidence).forEach(([field, value]) => {
            if (!(field in result)) {
              result[field] = value >= 85 && !sensitiveConfirmationFields.has(field);
            }
          });

          return result;
        }

        function getUnifiedAiFields(raw: Record<string, any>) {
          const normalized = asRecord(raw.normalized_fields || raw.normalizedFields);
          const detected = asRecord(raw.detected_fields || raw.detectedFields || raw.fields);
          const draft = asRecord(raw.draft);
          const car = asRecord(raw.car || raw.listing);
          const source = Object.keys(normalized).length ? normalized : { ...car, ...draft, ...detected };

          return {
            title: firstValue(source.title, raw.suggested_title, raw.suggestedTitle),
            brand: firstValue(source.brand, source.make, source.car_make),
            model: firstValue(source.model, source.car_model),
            year: firstValue(source.year),
            color: firstValue(source.color),
            body_type: firstValue(source.body_type, source.bodyType),
            vehicle_type: firstValue(source.vehicle_type, source.vehicleType),
            fuel_type: firstValue(source.fuel_type, source.fuelType),
            transmission: firstValue(source.transmission),
            drivetrain: firstValue(source.drivetrain, source.drive_type),
            doors: firstValue(source.doors),
            seats: firstValue(source.seats),
            engine_volume: firstValue(source.engine_volume, source.engineVolume),
            owners_count: firstValue(source.owners_count, source.owner_count),
            first_registration: firstValue(source.first_registration, source.first_registration_date, source.registration_date),
            vehicle_condition: firstValue(source.vehicle_condition, source.condition),
            seller_type: firstValue(source.seller_type),
            seller_name: firstValue(source.seller_name),
            seller_phone: firstValue(source.seller_phone),
            seller_email: firstValue(source.seller_email),
            has_valid_tuv: source.has_valid_tuv,
            tuv_valid_until: firstValue(source.tuv_valid_until),
            mileage: firstValue(source.mileage),
            price: firstValue(source.price),
            currency: firstValue(source.currency),
            city: firstValue(source.city, source.location),
            country: firstValue(source.country),
            vin: firstValue(source.vin),
            description: firstValue(source.description, raw.suggested_description, raw.suggestedDescription),
          };
        }

        function normalizeMissingFields(raw: Record<string, any>, fields: Record<string, unknown>) {
          const source = Array.isArray(raw.missing_fields)
            ? raw.missing_fields
            : Array.isArray(raw.missingFields)
              ? raw.missingFields
              : [];
          const missing = source.map(normalizeFieldName).filter(Boolean);

          if (missing.length) {
            return Array.from(new Set(missing));
          }

          const requiredFields = [
            "title", "brand", "model", "year", "mileage", "price", "currency", "city", "country",
            "vehicle_type", "body_type", "fuel_type", "transmission", "drivetrain", "doors", "seats", "color",
            "owners_count", "first_registration", "vehicle_condition", "seller_type", "seller_name", "has_valid_tuv",
          ];
          return requiredFields.filter((field) => !firstValue(fields[field]));
        }

        function normalizeInsertSuggestions(raw: Record<string, any>, fields: Record<string, any>) {
          const source = Array.isArray(raw.insert_suggestions)
            ? raw.insert_suggestions
            : Array.isArray(raw.insertSuggestions)
              ? raw.insertSuggestions
              : [];
          const suggestions = source
            .map((item) => asRecord(item))
            .map((item) => ({
              type: String(item.type || "text"),
              label: firstValue(item.label, item.title, "Вставить подсказку"),
              target: firstValue(item.target, item.field, "description"),
              text: firstValue(item.text, item.value, item.content),
            }))
            .filter((item) => item.text);

          if (suggestions.length) {
            return { suggestions, isFallback: false };
          }

          const title = [fields.brand, fields.model, fields.year].filter(Boolean).join(" ");
          const fallbackSuggestions = [
            {
              type: "description_block",
              label: "Вставить про состояние кузова",
              target: "description",
              text: `Кузов ${title || "автомобиля"} выглядит аккуратно. Перед покупкой рекомендуем проверить лакокрасочное покрытие и историю обслуживания.`,
            },
            {
              type: "description_block",
              label: "Вставить про салон",
              target: "description",
              text: "Салон стоит отдельно проверить при осмотре: состояние сидений, панели приборов, электроники и следы активной эксплуатации.",
            },
            {
              type: "description_block",
              label: "Сделать описание для немецкого покупателя",
              target: "description",
              text: `${title || "Автомобиль"} подготовлен к просмотру. Данные объявления следует подтвердить по документам, сервисной истории и состоянию автомобиля при личном осмотре.`,
            },
          ];

          if (String(fields.fuel_type || "").toLowerCase().includes("диз")) {
            fallbackSuggestions.splice(2, 0, {
              type: "description_block",
              label: "Вставить про экономичный дизель",
              target: "description",
              text: "Дизельный двигатель хорошо подходит для дальних поездок и экономичной эксплуатации при регулярном обслуживании.",
            });
          }

          return { suggestions: fallbackSuggestions, isFallback: true };
        }

        function normalizeAiAnalysis(raw: Record<string, any>) {
          const incomingFields = getUnifiedAiFields(raw);
          const normalized = normalizeAiDraftFields(incomingFields, { currentYear: aiCurrentYear });
          const confidence = normalizeConfidenceMap(raw);
          const autoFillAllowed = normalizeAutoFillMap(raw, confidence);
          const identity = extractAiDraftIdentity(raw);
          const detectedVin = firstValue(incomingFields.vin);
          const warnings = Array.isArray(raw.warnings) ? [...raw.warnings] : [];
          const fields = {
            ...normalized.fields,
            country: firstValue(incomingFields.country) || "Германия",
            currency: firstValue(incomingFields.currency) || "EUR",
            seller_name: firstValue(incomingFields.seller_name, authUser?.name),
            seller_email: firstValue(incomingFields.seller_email, authUser?.email),
            seller_phone: firstValue(incomingFields.seller_phone),
            vin: normalizeOptionalVin(detectedVin),
          };

          if (detectedVin && !isValidVin(detectedVin)) {
            warnings.push("AI увидел похожий на VIN текст, но это не полноценный VIN. Поле VIN очищено, при необходимости заполните его вручную.");
          }

          const suggestions = normalizeInsertSuggestions(raw, fields);

          return {
            detected_fields: {
              ...fields,
              make: fields.brand || "",
            },
            confidence,
            auto_fill_allowed: autoFillAllowed,
            field_sources: asRecord(raw.field_sources || raw.fieldSources || {}),
            missing_fields: normalizeMissingFields(raw, fields),
            warnings: [...warnings, ...normalized.warnings],
            recommendations: Array.isArray(raw.recommendations) ? raw.recommendations : [],
            suggested_title: firstValue(fields.title, raw.suggested_title, raw.suggestedTitle, [fields.brand, fields.model, fields.year].filter(Boolean).join(" ")),
            suggested_description: firstValue(fields.description, raw.suggested_description, raw.suggestedDescription),
            photo_quality_score: parseOptionalAiScore(raw.photo_quality_score, raw.photoQualityScore, raw.photo_score),
            listing_quality_score: parseOptionalAiScore(raw.listing_quality_score, raw.listingQualityScore, raw.listing_score, raw.score),
            trust_score: parseOptionalAiScore(raw.trust_score, raw.trustScore),
            draft_id: identity.draftId,
            listing_id: identity.listingId,
            insert_suggestions: suggestions.suggestions,
            suggestions_are_fallback: suggestions.isFallback,
          };
        }

        function renderAiFillOverview(analysis: Record<string, any>) {
          if (aiFillOverview instanceof HTMLElement) {
            aiFillOverview.hidden = false;
          }

          const fields = analysis.detected_fields || {};
          const confidence = analysis.confidence || {};
          const autoFillAllowed = analysis.auto_fill_allowed || {};
          const missingFields = new Set((analysis.missing_fields || []).map(normalizeFieldName));
          const filled: string[] = [];
          const needsConfirm: string[] = [];

          Object.keys(fields).forEach((field) => {
            const normalizedField = normalizeFieldName(field);

            if (!firstValue(fields[field]) || normalizedField === "make" || normalizedField === "country") {
              return;
            }

            const score = normalizeConfidence(confidence[normalizedField] ?? confidence[confidenceBadgeName(normalizedField)]);
            const canAutoFill = autoFillAllowed[normalizedField] !== false;

            if (canAutoFill && score >= 85 && !sensitiveConfirmationFields.has(normalizedField)) {
              filled.push(normalizedField);
            } else {
              needsConfirm.push(normalizedField);
            }
          });

          renderFieldList(aiAutofilledFields, filled, "Пока нет уверенно заполненных полей.");
          renderFieldList(aiConfirmFields, needsConfirm, "Пока нечего подтверждать.");
          renderFieldList(aiManualFields, Array.from(missingFields), "Обязательные поля заполнены.");
        }

        function getSuggestionText(card: HTMLElement) {
          return card.dataset.suggestionText || "";
        }

        function appendToDescription(text: string) {
          const control = getAiReviewControl("description");

          if (!(control instanceof HTMLTextAreaElement)) {
            return;
          }

          const current = control.value.trim();
          control.value = current ? `${current}\n\n${text}` : text;
          control.dispatchEvent(new Event("input", { bubbles: true }));
        }

        function replaceDescription(text: string) {
          const control = getAiReviewControl("description");

          if (!(control instanceof HTMLTextAreaElement)) {
            return;
          }

          control.value = text;
          control.dispatchEvent(new Event("input", { bubbles: true }));
        }

        function recordAcceptedAiSuggestion(type: string, label: string, target: string, text: string) {
          acceptedAiSuggestions.push({
            type,
            label,
            target,
            text,
            accepted_at: new Date().toISOString(),
          });
          markAiDraftDirty();
        }

        function getScoreLabel(score: unknown) {
          const value = Number(score || 0);

          if (value >= 90) return "Отлично";
          if (value >= 70) return "Хорошо";
          if (value >= 40) return "Нужно улучшить";
          return "Слабое";
        }

        function setScoreCard(element: Element | null, value: unknown) {
          if (element instanceof HTMLElement) {
            const score = parseOptionalAiScore(value);
            element.textContent = score === null ? "—" : `${score}/100`;
          }
        }

        function setTrustScore(value: unknown) {
          const score = parseOptionalAiScore(value);

          setScoreCard(aiTrustScore, score);
          if (aiTrustLabel instanceof HTMLElement) {
            aiTrustLabel.textContent = score === null
              ? "Оценка появится после проверки качества объявления."
              : `${getScoreLabel(score)}. AI проверяет полноту данных, а не техническое состояние автомобиля.`;
          }
        }

        function showDescriptionPreview(text: string, mode: string) {
          currentAiDescriptionPreview = text;

          if (aiDescriptionPreview instanceof HTMLElement) {
            aiDescriptionPreview.hidden = false;
          }
          if (aiDescriptionPreviewText instanceof HTMLElement) {
            aiDescriptionPreviewText.textContent = text;
          }
          if (aiDescriptionPreviewStatus instanceof HTMLElement) {
            aiDescriptionPreviewStatus.textContent = `Режим: ${getDescriptionModeLabel(mode)}`;
          }
        }

        function getDescriptionMode() {
          return aiDescriptionMode instanceof HTMLSelectElement ? aiDescriptionMode.value : "sales";
        }

        function getDescriptionModeLabel(mode: string) {
          const labels: Record<string, string> = {
            sales: "Продающее описание",
            short: "Короткое описание",
            technical: "Честное техническое описание",
            de: "На немецком",
            kleinanzeigen: "Kleinanzeigen",
            whatsapp: "WhatsApp",
          };

          return labels[mode] || labels.sales;
        }

        function getDescriptionControlValue() {
          const control = getAiReviewControl("description");
          return control ? String(control.value || "").trim() : "";
        }

        function renderAiSuggestions(analysis: Record<string, any>) {
          if (!(aiSuggestions instanceof HTMLElement) || !(aiSuggestionList instanceof HTMLElement)) {
            return;
          }

          const suggestions = Array.isArray(analysis.insert_suggestions) ? analysis.insert_suggestions : [];
          aiSuggestions.hidden = suggestions.length === 0;

          if (aiSuggestionsNote instanceof HTMLElement) {
            aiSuggestionsNote.textContent = analysis.suggestions_are_fallback
              ? "Базовые подсказки по заполненным данным."
              : "Можно вставить подсказки в черновик или скопировать их.";
          }

          aiSuggestionList.innerHTML = suggestions
            .map((suggestion: Record<string, any>, index: number) => {
              const label = firstValue(suggestion.label, "Вставить подсказку");
              const target = firstValue(suggestion.target, "description");
              const text = firstValue(suggestion.text);
              const preview = text.length > 160 ? `${text.slice(0, 160)}...` : text;

              return `
                <article class="ai-suggestion-card" data-suggestion-index="${index}" data-suggestion-target="${escapeHtml(target)}" data-suggestion-text="${escapeHtml(text)}">
                  <div>
                    <h3>${escapeHtml(label)}</h3>
                    <p>${escapeHtml(preview)}</p>
                    <small>${escapeHtml(target === "description" ? "Описание" : target === "title" ? "Название" : "Скопировать")}</small>
                  </div>
                  <div class="ai-suggestion-actions">
                    <button class="button button-dark button-small" type="button" data-suggestion-insert="${index}">Вставить</button>
                    <button class="button button-light button-small" type="button" data-suggestion-copy="${index}">Скопировать</button>
                    <button class="button button-light button-small" type="button" data-suggestion-hide="${index}">Скрыть</button>
                  </div>
                  <span class="ai-suggestion-status" aria-live="polite"></span>
                </article>
              `;
            })
            .join("");
        }

        function renderAiDraftPreview(raw: Record<string, any>) {
          const analysis = normalizeAiAnalysis(raw);
          const fields = analysis.detected_fields;

          currentAiAnalysis = analysis;
          currentAiDraftId = analysis.draft_id || currentAiDraftId;
          currentAiListingId = analysis.listing_id || currentAiListingId;

          if (currentAiDraftId) {
            const url = new URL(window.location.href);
            url.searchParams.set("draft_id", String(currentAiDraftId));
            window.history.replaceState({}, "", `${url.pathname}${url.search}`);
          }

          if (aiDraftPreview instanceof HTMLElement) {
            aiDraftPreview.hidden = false;
            aiDraftPreview.scrollIntoView({ behavior: "smooth", block: "start" });
          }

          const fieldWarnings = [
            setAiReviewField("title", analysis.suggested_title || [fields.brand, fields.model, fields.year].filter(Boolean).join(" ")),
            setAiReviewField("brand", fields.brand),
            setAiReviewField("model", fields.model),
            setAiReviewField("year", fields.year),
            setAiReviewField("mileage", fields.mileage),
            setAiReviewField("price", fields.price),
            setAiReviewField("city", fields.city),
            setAiReviewField("country", fields.country || "Германия"),
            setAiReviewField("vehicle_type", fields.vehicle_type),
            setAiReviewField("body_type", fields.body_type),
            setAiReviewField("color", fields.color),
            setAiReviewField("fuel_type", fields.fuel_type),
            setAiReviewField("engine_volume", fields.engine_volume),
            setAiReviewField("transmission", fields.transmission),
            setAiReviewField("drivetrain", fields.drivetrain),
            setAiReviewField("doors", fields.doors),
            setAiReviewField("seats", fields.seats),
            setAiReviewField("owners_count", fields.owners_count),
            setAiReviewField("first_registration", fields.first_registration),
            setAiReviewField("vehicle_condition", fields.vehicle_condition),
            setAiReviewField("has_valid_tuv", fields.has_valid_tuv),
            setAiReviewField("tuv_valid_until", fields.tuv_valid_until),
            setAiReviewField("seller_type", fields.seller_type),
            setAiReviewField("seller_name", fields.seller_name),
            setAiReviewField("seller_phone", fields.seller_phone),
            setAiReviewField("seller_email", fields.seller_email),
            setAiReviewField("vin", fields.vin),
            setAiReviewField("description", analysis.suggested_description),
          ].filter(Boolean);
          markAiDraftDirty();
          syncAiReviewVisibility(analysis);
          setAiActionStep("review");
          renderAiFillOverview(analysis);
          renderAiSuggestions(analysis);

          Object.entries(analysis.confidence || {}).forEach(([field, value]) => setConfidenceBadge(field, value));
          confidenceFields.forEach((field) => {
            const normalizedField = normalizeFieldName(field);

            if (!(normalizedField in (analysis.confidence || {})) && !(field in (analysis.confidence || {}))) {
              setConfidenceBadge(field, 0);
            }
          });

          const localScore = calculateListingQualityScore(getAiReviewData(), analysis);
          const listingScore = parseOptionalAiScore(analysis.listing_quality_score);
          const photoScore = parseOptionalAiScore(analysis.photo_quality_score);
          const trustScore = parseOptionalAiScore(analysis.trust_score);

          setScoreCard(aiListingScore, listingScore);
          setScoreCard(aiPhotoScore, photoScore);
          setTrustScore(trustScore);
          currentAiScores = {
            ...(listingScore === null ? {} : { listing_quality_score: listingScore }),
            ...(photoScore === null ? {} : { photo_quality_score: photoScore }),
            ...(trustScore === null ? {} : { trust_score: trustScore }),
            next_best_actions: localScore.next_best_actions,
          };
          if (aiReviewStatus instanceof HTMLElement) {
            aiReviewStatus.textContent = analysis.missing_fields.length ? "Нужно подтвердить" : "Готов к проверке";
          }

          renderFieldList(aiMissingFields, analysis.missing_fields, "Обязательные поля заполнены.");
          renderList(aiWarnings, [...analysis.warnings, ...fieldWarnings, ...localScore.warnings], "Критичных предупреждений нет.");
          renderList(aiRecommendations, [...analysis.recommendations, ...localScore.recommendations], "Черновик выглядит хорошо.");
          renderNextBestActions(localScore.next_best_actions);
        }

        function calculateListingQualityScore(data: Record<string, string>, analysis: Record<string, any> | null = null) {
          let score = 0;
          const warnings: string[] = [];
          const recommendations: string[] = [];

          if (selectedAiPhotos.length || selectedPhotos.length) score += 15;
          if ((selectedAiPhotos.length || selectedPhotos.length) >= 3) score += 10;
          ["year", "mileage", "price", "city", "fuel_type", "transmission"].forEach((field) => {
            if (data[field]) score += 8;
          });
          if (data.description && data.description.length >= 80) score += 14;
          if (data.body_type) score += 5;
          if (data.color) score += 4;
          if (data.brand && data.model) score += 10;

          const validation = validateListingData(data, { allowExtremePrice: true });
          warnings.push(...validation.errors);

          if (!data.description || data.description.length < 80) {
            recommendations.push("Добавьте описание: состояние, обслуживание, комплектацию и причину продажи.");
          }
          if ((selectedAiPhotos.length || selectedPhotos.length) < 3) {
            recommendations.push("Добавьте фото салона, приборной панели и кузова с разных сторон.");
          }
          if (analysis?.missing_fields?.length) {
            recommendations.push("Подтвердите поля, которые AI отметил как неизвестные.");
          }

          return {
            score: Math.max(0, Math.min(100, score - warnings.length * 6)),
            photo_score: Math.min(100, (selectedAiPhotos.length || selectedPhotos.length || currentAiUploadedImages.length) * 18 + ((selectedAiPhotos.length || selectedPhotos.length || currentAiUploadedImages.length) >= 3 ? 25 : 0)),
            trust_score: Math.max(0, Math.min(100, score - warnings.length * 8 + (data.description?.length >= 80 ? 8 : 0))),
            warnings,
            recommendations,
            next_best_actions: buildLocalNextBestActions(data),
          };
        }

        function buildLocalNextBestActions(data: Record<string, string>) {
          const actions: Array<Record<string, string>> = [];
          const photoCount = currentAiUploadedImages.length || selectedAiPhotos.length || selectedPhotos.length;

          if (photoCount < 3) {
            actions.push({
              label: "Добавьте фото салона",
              impact: "+12",
              action: "upload_more_photos",
              explanation: "Фото салона и приборной панели повышают доверие покупателей.",
            });
          }
          if (!data.mileage) {
            actions.push({ label: "Укажите пробег", impact: "+10", action: "fill_mileage", field: "mileage" });
          }
          if (!data.price) {
            actions.push({ label: "Укажите цену", impact: "+10", action: "fill_price", field: "price" });
          }
          if (!data.city) {
            actions.push({ label: "Укажите город", impact: "+8", action: "fill_city", field: "city" });
          }
          if (!data.description || data.description.length < 80) {
            actions.push({
              label: "Расширьте описание",
              impact: "+8",
              action: "fill_description",
              field: "description",
