---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthShell from "../components/auth/AuthShell.astro";

const xanoApiUrl = import.meta.env.PUBLIC_XANO_API_URL;
const xanoAuthApiUrl = import.meta.env.PUBLIC_XANO_AUTH_API_URL ?? xanoApiUrl;
const placeholderApiUrl = "https://your-xano-api-url.com/api:YOUR_GROUP";
const googleStartPath = import.meta.env.PUBLIC_XANO_GOOGLE_AUTH_START_PATH ?? "/oauth/google/init";
---

<BaseLayout title="Вход" variant="auth" noindex>
  <AuthShell
    infoEyebrow="Кабинет продавца"
    infoTitle="Управляйте объявлениями в одном месте"
    infoText="Публикация, AI-черновики, продвижение и статусы модерации собраны в спокойном рабочем кабинете."
    benefits={["Создание объявления по 1–8 фото.", "История покупок и AI-кредиты.", "Редактирование и удаление своих объявлений."]}
    formEyebrow="Авторизация"
    formTitle="Войти"
  >
      <div class="auth-panel" data-api-url={xanoApiUrl} data-placeholder-url={placeholderApiUrl}>
        <button
          class="button button-light full-width"
          id="google-login"
          type="button"
          data-api-url={xanoApiUrl}
          data-auth-api-url={xanoAuthApiUrl}
          data-placeholder-url={placeholderApiUrl}
          data-start-path={googleStartPath}
        >
          <img class="google-auth-icon" src="/google-g.svg" alt="" width="18" height="18" />
          <span>Продолжить с Google</span>
        </button>
        <p class="form-message" id="login-message" hidden></p>

        <div class="auth-divider"><span>или email</span></div>

        <form class="form-panel" id="password-login-form">
          <div class="full-field">
            <label for="login-email">Email</label>
            <input id="login-email" type="email" name="email" autocomplete="email" required />
          </div>

          <div class="full-field">
            <label for="login-password">Пароль</label>
            <span class="password-field">
              <input id="login-password" type="password" name="password" autocomplete="current-password" required />
              <button class="password-toggle" type="button" aria-label="Показать пароль" aria-pressed="false" data-password-toggle><i data-lucide="eye" aria-hidden="true"></i></button>
            </span>
          </div>

          <button class="button button-primary full-width" id="password-login-submit" type="submit">Войти по email</button>
          <p class="auth-form-note">
            Нет аккаунта? <a href="/register">Зарегистрироваться</a>
          </p>
          <p class="form-message" id="password-login-message" role="status" aria-live="polite" hidden></p>
        </form>
      </div>
  </AuthShell>

  <script>
    import {
      AUTH_DEBUG_KEY,
      consumeNext,
      normalizeInternalReturnTo,
      rememberNext,
      setAuthToken,
      setAuthUser,
    } from "../lib/authClient";
    import { getFriendlyErrorMessage } from "../lib/errorMessages";
    import { installPasswordToggles, setAuthButtonBusy } from "../lib/authUi";

    const button = document.querySelector("#google-login");
    const message = document.querySelector("#login-message");
    const passwordForm = document.querySelector("#password-login-form");
    const passwordMessage = document.querySelector("#password-login-message");
    const passwordSubmit = document.querySelector<HTMLButtonElement>("#password-login-submit");

    installPasswordToggles();

    const getToken = (payload: unknown) => {
      if (!payload || typeof payload !== "object") {
        return null;
      }

      const record = payload as Record<string, unknown>;
      const token = record.authToken ?? record.auth_token ?? record.token ?? record.jwt;

      return typeof token === "string" ? token : null;
    };

    const getUser = (payload: unknown) => {
      if (!payload || typeof payload !== "object") {
        return null;
      }

      const record = payload as Record<string, unknown>;
      return record.user ?? record.me ?? record.authUser ?? null;
    };

    const getAuthUrl = (payload: unknown) => {
      if (typeof payload === "string") {
        return payload;
      }

      if (payload && typeof payload === "object") {
        const record = payload as Record<string, unknown>;
        const value = record.authUrl ?? record.auth_url ?? record.url ?? record.redirect_url;

        if (typeof value === "string") {
          return value;
        }
      }

      return null;
    };

    button?.addEventListener("click", async () => {
      if (!(button instanceof HTMLButtonElement) || !(message instanceof HTMLElement)) {
        return;
      }

      const apiUrl = button.dataset.apiUrl;
      const authApiUrl = button.dataset.authApiUrl || apiUrl;
      const placeholderUrl = button.dataset.placeholderUrl;
      const startPath = button.dataset.startPath || "/oauth/google/init";

      if (!authApiUrl || authApiUrl === placeholderUrl) {
        message.hidden = false;
        message.textContent = "Вход временно недоступен. Попробуйте позже.";
        return;
      }

      const redirectUri = `${window.location.origin}/auth/google/callback`;
      const authStartUrl = new URL(`${authApiUrl}${startPath}`);
      authStartUrl.searchParams.set("redirect_uri", redirectUri);
      const currentParams = new URLSearchParams(window.location.search);
      const debugMode = currentParams.get("debug") === "1";

      message.hidden = false;
      message.textContent = "Открываю Google...";
      setAuthButtonBusy(button, true, "Открываю Google...");

      try {
        const response = await fetch(authStartUrl.toString());

        if (!response.ok) {
          throw new Error("google auth failed");
        }

        const contentType = response.headers.get("content-type") || "";
        const payload = contentType.includes("application/json")
          ? await response.json()
          : await response.text();
        const authUrl = getAuthUrl(payload);

        if (!authUrl) {
          throw new Error("google auth url missing");
        }

        const next = currentParams.get("returnTo") || currentParams.get("next");

        if (next) {
          rememberNext(next);
        }

        if (debugMode) {
          window.localStorage.setItem(AUTH_DEBUG_KEY, "1");
        }

        window.location.href = authUrl;
      } catch (error) {
        console.error(error);
        setAuthButtonBusy(button, false, "Открываю Google...");
        message.hidden = false;
        message.textContent = getFriendlyErrorMessage(error, "Не удалось начать вход через Google. Попробуйте ещё раз.");
      }
    });

    passwordForm?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!(passwordForm instanceof HTMLFormElement) || !(passwordMessage instanceof HTMLElement)) {
        return;
      }
      passwordMessage.hidden = false;

      const panel = passwordForm.closest(".auth-panel");
      const apiUrl = panel instanceof HTMLElement ? panel.dataset.apiUrl : "";
      const placeholderUrl = panel instanceof HTMLElement ? panel.dataset.placeholderUrl : "";

      if (!apiUrl || apiUrl === placeholderUrl) {
        passwordMessage.textContent = "Вход временно недоступен. Попробуйте позже.";
        return;
      }

      const formData = new FormData(passwordForm);
      const payload = {
        email: String(formData.get("email") || "").trim().toLowerCase(),
        password: String(formData.get("password") || ""),
      };

      try {
        passwordMessage.textContent = "Проверяю пароль...";
        setAuthButtonBusy(passwordSubmit, true, "Выполняю вход...");

        const response = await fetch(`${apiUrl}/auth/login`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        });
        const contentType = response.headers.get("content-type") || "";
        const result = contentType.includes("application/json")
          ? await response.json()
          : await response.text();

        if (!response.ok) {
          const details =
            result && typeof result === "object"
              ? ((result as Record<string, unknown>).message ?? (result as Record<string, unknown>).code)
              : result;

          throw new Error(typeof details === "string" && details ? details : "Неверный email или пароль.");
        }

        const token = getToken(result);
        const user = getUser(result);

        if (!token) {
          throw new Error("auth token missing");
        }

        setAuthToken(token);

        if (user) {
          setAuthUser(user);
        }

        const params = new URLSearchParams(window.location.search);
        const next = normalizeInternalReturnTo(params.get("returnTo") || params.get("next") || consumeNext("/dashboard/"));
        passwordMessage.textContent = "Вход выполнен. Открываю кабинет...";
        window.location.href = next;
      } catch (error) {
        passwordMessage.textContent =
          getFriendlyErrorMessage(error, "Не удалось войти по email. Проверьте данные и попробуйте снова.");
      } finally {
        setAuthButtonBusy(passwordSubmit, false, "Выполняю вход...");
      }
    });
  </script>
</BaseLayout>
