---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Оплата отменена" description="Оплата отменена" variant="public" noindex>
  <section class="section page-hero">
    <div class="container payment-result">
      <p class="eyebrow">Оплата</p>
      <h1>Оплата отменена</h1>
      <p class="lead">Покупка не была завершена. Можно вернуться к тарифам и выбрать услугу позже.</p>
      <div class="payment-actions">
        <a class="button button-dark" href="/pricing">Вернуться к тарифам</a>
        <a class="button button-light" href="/dashboard/billing">Кабинет оплат</a>
      </div>
    </div>
  </section>
</BaseLayout>
