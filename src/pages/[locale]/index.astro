---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CarCard from "../../components/CarCard.astro";
import { normalizeLocale } from "../../i18n/locale";
import { getPublicPageMessages, getRouteAlternates } from "../../i18n/publicRoutes";
import { isPublicLocaleRouteEnabled } from "../../i18n/release4";
import { isStrictSeoReleaseLocale } from "../../i18n/releaseStage3";
import { I18N_PREVIEW_NOINDEX, RELEASE4_FLAGS } from "../../lib/config";
import { isPublicListing } from "../../lib/listingStatus";
import { setPublicCacheHeaders, setUnavailableHeaders } from "../../lib/publicCache";
import { getApprovedCars, getLocalizedApprovedCars } from "../../lib/xano";
import type { CarListing } from "../../lib/types";
import { getHomepagePromotedCars } from "../../lib/promotions/model";
import { getMessages } from "../../i18n/messages";
import { getDefaultLocalizedPath } from "../../i18n/routes";

export const prerender = false;

const locale = normalizeLocale(Astro.params.locale, { activeOnly: true });
if (!locale || !isPublicLocaleRouteEnabled(locale, RELEASE4_FLAGS)) {
  Astro.response.status = 404;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/404");
}

const messages = getPublicPageMessages(locale);
const homeMessages = getMessages(locale);
let cars: CarListing[] = [];
const strictSeoRelease = isStrictSeoReleaseLocale(locale);
try {
  cars = strictSeoRelease
    ? await getLocalizedApprovedCars(locale)
    : (await getApprovedCars(locale, { requireConfigured: true })).filter(isPublicListing);
} catch {
  Astro.response.status = 503;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/service-unavailable");
}
const homepagePromotedCars = getHomepagePromotedCars(cars);
const homepagePromotedIds = new Set(homepagePromotedCars.map((car) => car.id));
const regularCars = cars.filter((car) => !homepagePromotedIds.has(car.id));
const canonicalPath = `/${locale}/`;
const alternateLocales = getRouteAlternates("/");
const pageNoindex = !strictSeoRelease;
Astro.response.headers.set("X-SiteCraft-Query-Count", "1");
setPublicCacheHeaders(Astro.response.headers, "page", pageNoindex);

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: messages.homeTitle,
  description: messages.homeDescription,
  inLanguage: locale,
};
---

<BaseLayout
  variant="public"
  locale={locale}
  title={messages.homeTitle}
  description={messages.homeDescription}
  canonicalPath={canonicalPath}
  noindex={pageNoindex || I18N_PREVIEW_NOINDEX}
  jsonLd={pageSchema}
  alternateLocales={alternateLocales}
  xDefaultPath={getDefaultLocalizedPath("/")}
>
  <section class="section page-hero">
    <div class="container">
      <p class="eyebrow">SiteCraft Auto Market</p>
      <h1>{messages.homeHeading}</h1>
      <p class="lead">{messages.homeLead}</p>
      <div class="hero-cta-row">
        <a class="button button-accent" href={`/${locale}/cars/`}><i data-lucide="search" aria-hidden="true"></i><span>{messages.browseCars}</span></a>
        <a class="button button-light" href="/dashboard/new"><i data-lucide="plus" aria-hidden="true"></i><span>{messages.sellCar}</span></a>
      </div>
    </div>
  </section>

  {homepagePromotedCars.length > 0 && (
    <section class="section homepage-promotions" aria-labelledby="localized-homepage-promotions-title">
      <div class="container">
        <div class="section-heading row-heading homepage-promotions-heading">
          <div>
            <p class="eyebrow homepage-promotions-eyebrow"><i data-lucide="crown" aria-hidden="true"></i><span>{homeMessages.tabPremium}</span></p>
            <h2 id="localized-homepage-promotions-title">{homeMessages.premiumCars}</h2>
            <p class="section-subtitle">{homeMessages.premiumDisclosure}</p>
          </div>
          <a class="button button-light" href={`/${locale}/cars/`}>{homeMessages.viewCatalog}</a>
        </div>
        <div class="cards-grid public-car-grid" data-homepage-promotions-grid>
          {homepagePromotedCars.map((car, index) => <CarCard car={car} priority={index === 0} source="localized_home_premium" locale={locale} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section catalog-results-section" aria-labelledby="localized-home-cars">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">SiteCraft Auto Market</p>
          <h2 id="localized-home-cars">{messages.catalogTitle}</h2>
          <p class="section-subtitle">{messages.catalogLead}</p>
        </div>
        <a class="button button-light" href={`/${locale}/cars/`}>{messages.browseCars}</a>
      </div>
      {regularCars.length > 0 ? (
        <div class="cards-grid catalog-grid">
          {regularCars.map((car, index) => <CarCard car={car} priority={homepagePromotedCars.length === 0 && index === 0} source="localized_home" locale={locale} />)}
        </div>
      ) : (
        <div class="empty-state" role="status"><h2>{messages.emptyTitle}</h2><p>{messages.emptyText}</p></div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{messages.reliabilityEyebrow}</p>
          <h2>{messages.reliabilityHeading}</h2>
          <p class="section-subtitle">{messages.reliabilityText}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
