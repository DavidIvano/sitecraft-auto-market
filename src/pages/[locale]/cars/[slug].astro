---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CarCard from "../../../components/CarCard.astro";
import { formatCurrency, formatDate, formatMileage } from "../../../i18n/format";
import { normalizeLocale } from "../../../i18n/locale";
import { toPublicListingForLocale } from "../../../i18n/publicListing";
import { getPublicPageMessages, getRouteAlternates } from "../../../i18n/publicRoutes";
import { isPublicLocaleRouteEnabled } from "../../../i18n/release4";
import { getVehicleTaxonomyLabel } from "../../../domain/vehicleTaxonomy";
import { normalizeBackendValue } from "../../../i18n/backendValues";
import { I18N_PREVIEW_NOINDEX, RELEASE4_FLAGS, SITE_URL } from "../../../lib/config";
import { isValidPublicCarSlug } from "../../../lib/publicCar";
import { setPublicCacheHeaders, setUnavailableHeaders } from "../../../lib/publicCache";
import { buildLocalizedVehicleSeo } from "../../../lib/seo/vehicleSeo";
import { evaluateListingSeoQuality } from "../../../lib/seo/listingQuality.ts";
import { getLocalizedCarBySlug, getLocalizedRelatedCars } from "../../../lib/xano";
import { getCarDetailImagePresentations } from "../../../lib/imageUrls";
import { buildListingSeoTaxonomyLinks, getTaxonomyGroupLabel } from "../../../lib/seo/taxonomies.ts";
import type { CarListing } from "../../../lib/types.ts";

export const prerender = false;

const locale = normalizeLocale(Astro.params.locale, { activeOnly: true });
if (!locale || !isPublicLocaleRouteEnabled(locale, RELEASE4_FLAGS)) {
  Astro.response.status = 404;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/404");
}

let slug = typeof Astro.params.slug === "string" ? Astro.params.slug.trim() : "";
try {
  slug = decodeURIComponent(slug).trim();
} catch {
  slug = "";
}
if (!isValidPublicCarSlug(slug)) {
  Astro.response.status = 404;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/404");
}

const requestStarted = performance.now();
let sourceListing = null;
try {
  sourceListing = await getLocalizedCarBySlug(slug, locale);
} catch {
  Astro.response.status = 503;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/service-unavailable");
}
const car = sourceListing ? toPublicListingForLocale(sourceListing, locale) : null;
if (!car) {
  Astro.response.status = 404;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/404");
}

const queryDuration = Math.max(0, performance.now() - requestStarted).toFixed(1);
Astro.response.headers.set("Server-Timing", `locale-read;dur=${queryDuration};desc="single listing query"`);
Astro.response.headers.set("X-SiteCraft-Query-Count", "1");
setPublicCacheHeaders(Astro.response.headers, "detail", I18N_PREVIEW_NOINDEX);

const messages = getPublicPageMessages(locale);
const seo = buildLocalizedVehicleSeo(car, locale, SITE_URL);
const seoQuality = evaluateListingSeoQuality(car);
let relatedCars: CarListing[] = [];
try {
  relatedCars = await getLocalizedRelatedCars(sourceListing!, locale);
} catch {
  // Related inventory is helpful but must never make the canonical detail URL
  // unavailable. The primary listing already passed the strict locale read.
  relatedCars = [];
}
const specs = [
  [messages.price, formatCurrency(car.price, car.currency, locale)],
  [messages.mileage, formatMileage(car.mileage, locale)],
  [messages.firstRegistration, car.year ? String(car.year) : ""],
  [messages.fuel, getVehicleTaxonomyLabel("fuel_type", normalizeBackendValue("fuel_type", car.fuel_type), locale) || car.fuel_type],
  [messages.transmission, getVehicleTaxonomyLabel("transmission", normalizeBackendValue("transmission", car.transmission), locale) || car.transmission],
  [messages.bodyType, getVehicleTaxonomyLabel("body_type", normalizeBackendValue("body_type", car.body_type), locale) || car.body_type],
  [messages.location, car.city],
  [messages.updated, formatDate(car.translation_updated_at || car.updated_at, locale)],
].filter(([, value]) => Boolean(value));
const readyLocales = car.available_locales.includes(locale) ? car.available_locales : [locale];
const taxonomyLinks = buildListingSeoTaxonomyLinks(car, locale);
const mainImage = getCarDetailImagePresentations(car)[0] || {
  src: car.image_urls[0] || "/deal-finder-placeholder.svg",
  srcset: "",
  sizes: "100vw",
  width: 1200,
  height: 800,
};
---

<BaseLayout
  variant="public"
  locale={locale}
  title={seo.title}
  description={seo.description}
  canonicalPath={`/${locale}/cars/${car.slug}/`}
  image={seo.imageUrl}
  noindex={I18N_PREVIEW_NOINDEX || !seoQuality.eligible}
  ogType="product"
  jsonLd={[seo.vehicle, seo.offer, seo.breadcrumb]}
  breadcrumbs={seo.breadcrumbs}
  alternateLocales={getRouteAlternates(`/cars/${car.slug}/`, readyLocales)}
  xDefaultPath={`/cars/${car.slug}/`}
>
  <section class="section car-detail-section">
    <div class="container detail-container">
      <article class="detail-grid car-detail-grid">
        <div class="gallery car-slider">
          <div class="gallery-stage">
            <img src={mainImage.src} srcset={mainImage.srcset || undefined} sizes={mainImage.sizes} alt={seo.imageAlt} width={mainImage.width} height={mainImage.height} fetchpriority="high" decoding="async" />
          </div>
        </div>
        <div class="detail-panel compact-detail-panel">
          <span class="status-badge status-approved">{messages.verifiedListing}</span>
          <h1>{seo.heading}</h1>
          <p class="detail-price">{formatCurrency(car.price, car.currency, locale)}</p>
          <nav class="vehicle-context-links" aria-label={messages.similarVehicles}>
            {taxonomyLinks.map((link) => (
              <a href={link.href}><span>{getTaxonomyGroupLabel(link.type, locale)}</span><strong>{link.label}</strong></a>
            ))}
          </nav>
        </div>
      </article>
    </div>
  </section>

  <section class="section detail-properties-section" aria-labelledby="vehicle-data">
    <div class="container">
      <div class="detail-properties-panel">
        <div class="section-heading"><div><p class="eyebrow">{messages.vehicleData}</p><h2 id="vehicle-data">{messages.technicalDetails}</h2></div></div>
        <dl class="detail-property-grid">
          {specs.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="section detail-description-section" aria-labelledby="vehicle-description">
    <div class="container">
      <div class="detail-description-panel">
        <div class="section-heading"><div><p class="eyebrow">{messages.description}</p><h2 id="vehicle-description">{messages.aboutVehicle}</h2></div></div>
        <p class="detail-description">{car.description}</p>
      </div>
    </div>
  </section>

  {relatedCars.length > 0 && (
    <section class="section related-cars-section" aria-labelledby="localized-related-cars">
      <div class="container">
        <div class="section-heading compact-section-heading">
          <div>
            <p class="eyebrow">{messages.catalogTitle}</p>
            <h2 id="localized-related-cars">{messages.similarVehicles}</h2>
          </div>
        </div>
        <div class="cards-grid public-car-grid localized-related-cars-grid">
          {relatedCars.map((relatedCar) => <CarCard car={relatedCar} source="localized_related_cars" locale={locale} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
