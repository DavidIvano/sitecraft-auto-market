---
import type { CarListing } from "../../../../../lib/types";
import LocalizedTaxonomyCatalog from "../../../../../components/catalog/LocalizedTaxonomyCatalog.astro";
import { normalizeLocale } from "../../../../../i18n/locale";
import { getPublicPageMessages, getRouteAlternates } from "../../../../../i18n/publicRoutes";
import { isPublicLocaleRouteEnabled } from "../../../../../i18n/release4";
import { RELEASE4_FLAGS } from "../../../../../lib/config";
import { setPublicCacheHeaders, setUnavailableHeaders } from "../../../../../lib/publicCache";
import { getApprovedCars } from "../../../../../lib/xano";
import { isPublicListing } from "../../../../../lib/listingStatus";

export const prerender = false;

const locale = normalizeLocale(Astro.params.locale, { activeOnly: true });
let brand = "";
let model = "";
try {
  brand = decodeURIComponent(Astro.params.brand || "").trim();
  model = decodeURIComponent(Astro.params.model || "").trim();
} catch {
  brand = "";
  model = "";
}
if (!locale || !brand || !model || brand.length > 80 || model.length > 80 || !isPublicLocaleRouteEnabled(locale, RELEASE4_FLAGS)) {
  Astro.response.status = 404;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/404");
}

let listings: CarListing[] = [];
try { listings = await getApprovedCars(locale, { requireConfigured: true }); }
catch {
  Astro.response.status = 503;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/service-unavailable");
}
const cars = listings.filter(isPublicListing).filter((car) => (
  car.brand.toLocaleLowerCase() === brand.toLocaleLowerCase()
  && car.model.toLocaleLowerCase() === model.toLocaleLowerCase()
));
if (cars.length === 0) {
  Astro.response.status = 404;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/404");
}
const messages = getPublicPageMessages(locale);
const encodedBrand = encodeURIComponent(brand);
const encodedModel = encodeURIComponent(model);
const canonicalPath = `/${locale}/cars/brand/${encodedBrand}/${encodedModel}/`;
const title = `${brand} ${model}`;
const description = `${messages.catalogDescription} ${brand} ${model}.`;
Astro.response.headers.set("X-SiteCraft-Query-Count", "1");
setPublicCacheHeaders(Astro.response.headers, "catalog", true);
---

<LocalizedTaxonomyCatalog
  locale={locale}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  cars={cars}
  messages={messages}
  noindex={true}
  alternateLocales={getRouteAlternates(`/cars/brand/${encodedBrand}/${encodedModel}/`)}
/>
