---
import type { CarListing } from "../../../../lib/types";
import LocalizedTaxonomyCatalog from "../../../../components/catalog/LocalizedTaxonomyCatalog.astro";
import { normalizeLocale } from "../../../../i18n/locale";
import { projectCatalogForLocale } from "../../../../i18n/publicListing";
import { getPublicPageMessages, getRouteAlternates } from "../../../../i18n/publicRoutes";
import { isPublicLocaleRouteEnabled } from "../../../../i18n/release4";
import { I18N_PREVIEW_NOINDEX, RELEASE4_FLAGS } from "../../../../lib/config";
import { setPublicCacheHeaders, setUnavailableHeaders } from "../../../../lib/publicCache";
import { getLocalizedApprovedCars } from "../../../../lib/xano";

export const prerender = false;

const locale = normalizeLocale(Astro.params.locale, { activeOnly: true });
let brand = "";
try { brand = decodeURIComponent(Astro.params.brand || "").trim(); } catch { brand = ""; }
if (!locale || !brand || brand.length > 80 || !isPublicLocaleRouteEnabled(locale, RELEASE4_FLAGS)) {
  Astro.response.status = 404;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/404");
}

let listings: CarListing[] = [];
try { listings = await getLocalizedApprovedCars(locale); }
catch {
  Astro.response.status = 503;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/service-unavailable");
}
const cars = projectCatalogForLocale(listings, locale).filter((car) => car.brand.toLocaleLowerCase() === brand.toLocaleLowerCase());
if (cars.length === 0) {
  Astro.response.status = 404;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/404");
}
const messages = getPublicPageMessages(locale);
const encodedBrand = encodeURIComponent(brand);
const canonicalPath = `/${locale}/cars/brand/${encodedBrand}/`;
const title = `${brand} ${messages.vehicles}`;
const description = `${messages.catalogDescription} ${brand}.`;
Astro.response.headers.set("X-SiteCraft-Query-Count", "1");
setPublicCacheHeaders(Astro.response.headers, "catalog", I18N_PREVIEW_NOINDEX);
---

<LocalizedTaxonomyCatalog
  locale={locale}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  cars={cars}
  messages={messages}
  noindex={I18N_PREVIEW_NOINDEX}
  alternateLocales={getRouteAlternates(`/cars/brand/${encodedBrand}/`)}
/>
