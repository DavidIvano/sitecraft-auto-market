---
import LocalizedTaxonomyCatalog from "../../../../components/catalog/LocalizedTaxonomyCatalog.astro";
import { normalizeLocale } from "../../../../i18n/locale.ts";
import { getPublicPageMessages } from "../../../../i18n/publicRoutes.ts";
import { isPublicLocaleRouteEnabled } from "../../../../i18n/release4.ts";
import { RELEASE4_FLAGS } from "../../../../lib/config.ts";
import { setPublicCacheHeaders, setUnavailableHeaders } from "../../../../lib/publicCache.ts";
import { loadLocalizedSeoTaxonomyCatalog, resolveSeoTaxonomyPage } from "../../../../lib/seo/taxonomyRoute.ts";

export const prerender = false;

const locale = normalizeLocale(Astro.params.locale, { activeOnly: true });
if (!locale || !isPublicLocaleRouteEnabled(locale, RELEASE4_FLAGS)) {
  Astro.response.status = 404;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/404");
}

let catalog;
try {
  catalog = await loadLocalizedSeoTaxonomyCatalog(locale);
} catch {
  Astro.response.status = 503;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/service-unavailable");
}
const resolution = resolveSeoTaxonomyPage({ locale, type: "brand", slug: Astro.params.brand, url: Astro.url, catalog });
if (resolution.status === "redirect") return Astro.redirect(resolution.location, 301);
if (resolution.status === "not_found") {
  Astro.response.status = 404;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/404");
}
Astro.response.headers.set("X-SiteCraft-Query-Count", "1");
setPublicCacheHeaders(Astro.response.headers, "catalog", resolution.noindex, "noindex, follow");
const messages = getPublicPageMessages(locale);
---

<LocalizedTaxonomyCatalog
  locale={locale}
  title={resolution.title}
  heading={resolution.heading}
  description={resolution.description}
  canonicalPath={resolution.canonicalPath}
  cars={resolution.cars}
  total={resolution.total}
  page={resolution.page}
  totalPages={resolution.totalPages}
  messages={messages}
  noindex={resolution.noindex}
  breadcrumbs={resolution.breadcrumbs}
  relatedGroups={resolution.relatedGroups}
  previousPath={resolution.previousPath}
  nextPath={resolution.nextPath}
  alternateLocales={resolution.alternateLocales}
/>
