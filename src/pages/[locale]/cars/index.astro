---
import type { CarListing } from "../../../lib/types";
import CarCard from "../../../components/CarCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { normalizeLocale } from "../../../i18n/locale";
import { getPublicPageMessages, getRouteAlternates } from "../../../i18n/publicRoutes";
import { isPublicLocaleRouteEnabled } from "../../../i18n/release4";
import { isStrictSeoReleaseLocale } from "../../../i18n/releaseStage3";
import { I18N_PREVIEW_NOINDEX, RELEASE4_FLAGS, SITE_URL } from "../../../lib/config";
import { isPublicListing } from "../../../lib/listingStatus";
import { setPublicCacheHeaders, setUnavailableHeaders } from "../../../lib/publicCache";
import { getApprovedCars, getLocalizedApprovedCars } from "../../../lib/xano";

export const prerender = false;

const locale = normalizeLocale(Astro.params.locale, { activeOnly: true });
if (!locale || !isPublicLocaleRouteEnabled(locale, RELEASE4_FLAGS)) {
  Astro.response.status = 404;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/404");
}

const requestStarted = performance.now();
let sourceListings: CarListing[] = [];
const strictSeoRelease = isStrictSeoReleaseLocale(locale);
try {
  sourceListings = strictSeoRelease
    ? await getLocalizedApprovedCars(locale)
    : await getApprovedCars(locale, { requireConfigured: true });
} catch {
  Astro.response.status = 503;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/service-unavailable");
}
const cars = sourceListings.filter(isPublicListing);
const messages = getPublicPageMessages(locale);
const queryDuration = Math.max(0, performance.now() - requestStarted).toFixed(1);
Astro.response.headers.set("Server-Timing", `locale-read;dur=${queryDuration};desc="bounded catalog query"`);
Astro.response.headers.set("X-SiteCraft-Query-Count", "1");
// Until every listing has a reviewed locale payload, this inclusive catalog is
// user-facing but not indexed. Strict translation-ready detail URLs and the
// sitemap continue to use the localized Xano endpoint.
const catalogNoindex = !strictSeoRelease;
setPublicCacheHeaders(Astro.response.headers, "catalog", catalogNoindex);

const siteUrl = SITE_URL || "https://automarket.sitecraft.agency";
const canonicalPath = `/${locale}/cars/`;
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: messages.catalogTitle,
  description: messages.catalogDescription,
  inLanguage: locale,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: cars.map((car, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/${locale}/cars/${car.slug}/`, siteUrl).toString(),
      name: car.title,
    })),
  },
};
---

<BaseLayout
  variant="public"
  locale={locale}
  title={messages.catalogTitle}
  description={messages.catalogDescription}
  canonicalPath={canonicalPath}
  noindex={catalogNoindex || I18N_PREVIEW_NOINDEX}
  jsonLd={collectionSchema}
  breadcrumbs={[{ href: `/${locale}/`, label: messages.homeTitle }, { label: messages.catalogTitle }]}
  alternateLocales={getRouteAlternates("/cars/")}
  xDefaultPath="/cars/"
>
  <section class="section page-hero catalog-hero">
    <div class="container">
      <p class="eyebrow">SiteCraft Auto Market</p>
      <h1>{messages.catalogTitle}</h1>
      <p class="lead">{messages.catalogLead}</p>
    </div>
  </section>

  <section class="section catalog-results-section">
    <div class="container">
      <div class="catalog-results-toolbar">
        <div><span>{messages.results}</span><strong>{cars.length} {messages.vehicles}</strong></div>
      </div>
      {cars.length > 0 ? (
        <div class="cards-grid catalog-grid">
          {cars.map((car, index) => <CarCard car={car} priority={index < 4} source="localized_catalog" locale={locale} />)}
        </div>
      ) : (
        <div class="empty-state" role="status">
          <h2>{messages.emptyTitle}</h2>
          <p>{messages.emptyText}</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
