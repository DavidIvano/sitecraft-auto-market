---
import CarCard from "../../../components/CarCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { normalizeLocale } from "../../../i18n/locale";
import { getPublicPageMessages } from "../../../i18n/publicRoutes";
import { isPublicLocaleRouteEnabled } from "../../../i18n/release4";
import { RELEASE4_FLAGS, SITE_URL } from "../../../lib/config";
import { setPublicCacheHeaders, setPublicNoStoreHeaders, setUnavailableHeaders } from "../../../lib/publicCache";
import SeoTaxonomyLinks from "../../../components/catalog/SeoTaxonomyLinks.astro";
import { TAXONOMY_PAGE_SIZE } from "../../../lib/seo/taxonomies.ts";
import { loadLocalizedCatalogPage } from "../../../lib/seo/catalogRoute.ts";
import { getDefaultLocalizedPath } from "../../../i18n/routes";

export const prerender = false;

const locale = normalizeLocale(Astro.params.locale, { activeOnly: true });
if (!locale || !isPublicLocaleRouteEnabled(locale, RELEASE4_FLAGS)) {
  Astro.response.status = 404;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/404");
}

const requestStarted = performance.now();
let resolution;
try {
  resolution = await loadLocalizedCatalogPage({ locale, url: Astro.url });
} catch {
  Astro.response.status = 503;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/service-unavailable");
}
if (resolution.status === "redirect") return Astro.redirect(resolution.location, 301);
if (resolution.status === "not_found") {
  Astro.response.status = 404;
  setUnavailableHeaders(Astro.response.headers);
  return Astro.rewrite("/404");
}
const cars = resolution.cars;
const messages = getPublicPageMessages(locale);
const queryDuration = Math.max(0, performance.now() - requestStarted).toFixed(1);
Astro.response.headers.set("Server-Timing", `locale-read;dur=${queryDuration};desc="bounded catalog query"`);
Astro.response.headers.set("X-SiteCraft-Query-Count", "1");
Astro.response.headers.set("X-SiteCraft-Catalog-Source", resolution.dataSource);
if (resolution.dataSource === "compatibility_catalog") {
  setPublicNoStoreHeaders(Astro.response.headers, resolution.noindex, "noindex, follow");
} else {
  setPublicCacheHeaders(Astro.response.headers, "catalog", resolution.noindex, "noindex, follow");
}

const siteUrl = SITE_URL || "https://automarket.sitecraft.agency";
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: resolution.title,
  description: resolution.description,
  inLanguage: locale,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: resolution.total,
    itemListElement: cars.map((car, index) => ({
      "@type": "ListItem",
      position: ((resolution.page - 1) * TAXONOMY_PAGE_SIZE) + index + 1,
      url: new URL(`/${locale}/cars/${car.slug}/`, siteUrl).toString(),
      name: car.title,
    })),
  },
};
---

<BaseLayout
  variant="public"
  locale={locale}
  title={resolution.title}
  description={resolution.description}
  canonicalPath={resolution.canonicalPath}
  noindex={resolution.noindex}
  robots={resolution.noindex ? "noindex, follow" : undefined}
  jsonLd={collectionSchema}
  breadcrumbs={resolution.breadcrumbs}
  alternateLocales={resolution.alternateLocales}
  xDefaultPath={resolution.page === 1 && !resolution.noindex ? getDefaultLocalizedPath("/cars/") : undefined}
>
  <section class="section page-hero catalog-hero">
    <div class="container">
      <p class="eyebrow">SiteCraft Auto Market</p>
      <h1>{resolution.heading}</h1>
      <p class="lead">{resolution.page === 1 ? messages.catalogLead : resolution.description}</p>
    </div>
  </section>

  <section class="section catalog-results-section">
    <div class="container">
      <div class="catalog-results-toolbar">
        <div><span>{messages.results}</span><strong>{resolution.total} {messages.vehicles}</strong></div>
      </div>
      {cars.length > 0 ? (
        <div class="cards-grid catalog-grid">
          {cars.map((car, index) => <CarCard car={car} priority={index === 0} source="localized_catalog" locale={locale} />)}
        </div>
      ) : (
        <div class="empty-state" role="status">
          <h2>{messages.emptyTitle}</h2>
          <p>{messages.emptyText}</p>
        </div>
      )}
      {resolution.totalPages > 1 && (
        <nav class="taxonomy-pagination" aria-label={`${messages.results} ${resolution.page}/${resolution.totalPages}`}>
          {resolution.previousPath ? <a href={resolution.previousPath} aria-label={`${messages.results} ${resolution.page - 1}`}>←</a> : <span aria-hidden="true">←</span>}
          <span aria-current="page">{resolution.page} / {resolution.totalPages}</span>
          {resolution.nextPath ? <a href={resolution.nextPath} aria-label={`${messages.results} ${resolution.page + 1}`}>→</a> : <span aria-hidden="true">→</span>}
        </nav>
      )}
    </div>
  </section>
  <SeoTaxonomyLinks groups={resolution.relatedGroups} heading={messages.similarVehicles} locale={locale} />
</BaseLayout>
