---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthShell from "../components/auth/AuthShell.astro";

const xanoApiUrl = import.meta.env.PUBLIC_XANO_API_URL;
const placeholderApiUrl = "https://your-xano-api-url.com/api:YOUR_GROUP";
---

<BaseLayout title="Регистрация" variant="auth" noindex>
  <AuthShell
    infoEyebrow="Старт продавца"
    infoTitle="Создайте кабинет для публикации авто"
    infoText="После регистрации можно добавить фото, получить AI-черновик и отправить объявление на модерацию."
    benefits={["1–8 фото на объявление.", "AI-поля только после анализа.", "Продвижение и биллинг в кабинете."]}
    formEyebrow="Регистрация"
    formTitle="Создать аккаунт"
  >
      <div class="auth-panel" data-api-url={xanoApiUrl} data-placeholder-url={placeholderApiUrl}>
        <a class="button button-light full-width" href="/login"><img class="google-auth-icon" src="/google-g.svg" alt="" width="18" height="18" /><span>Продолжить с Google</span></a>
        <div class="auth-divider"><span>или email</span></div>
        <form class="form-panel" id="register-form">
          <div class="full-field">
            <label for="register-name">Имя</label>
            <input id="register-name" type="text" name="name" autocomplete="name" required />
          </div>

          <div class="full-field">
            <label for="register-email">Email</label>
            <input id="register-email" type="email" name="email" autocomplete="email" required />
          </div>

          <div class="full-field">
            <label for="register-password">Пароль</label>
            <span class="password-field">
              <input id="register-password" type="password" name="password" autocomplete="new-password" minlength="8" required />
              <button class="password-toggle" type="button" aria-label="Показать пароль" aria-pressed="false" data-password-toggle><i data-lucide="eye" aria-hidden="true"></i></button>
            </span>
          </div>

          <div class="full-field">
            <label for="register-password-confirm">Повторите пароль</label>
            <span class="password-field">
              <input id="register-password-confirm" type="password" name="passwordConfirm" autocomplete="new-password" minlength="8" required />
              <button class="password-toggle" type="button" aria-label="Показать пароль" aria-pressed="false" data-password-toggle><i data-lucide="eye" aria-hidden="true"></i></button>
            </span>
          </div>

          <button class="button button-primary full-width" id="register-submit" type="submit">Создать аккаунт</button>
          <p class="auth-form-note">
            Уже есть аккаунт? <a href="/login">Войти</a>
          </p>
          <p class="form-message" id="register-message" role="status" aria-live="polite" hidden></p>
          <a class="button button-light full-width" id="register-google-link" href="/login?next=/dashboard" hidden>
            Войти через Google
          </a>
        </form>
      </div>
  </AuthShell>

  <script>
    import { consumeNext, setAuthToken, setAuthUser } from "../lib/authClient";
    import { getFriendlyErrorMessage } from "../lib/errorMessages";
    import { getRegistrationErrorCode, getRegistrationErrorMessage } from "../lib/registrationErrors";
    import { installPasswordToggles, setAuthButtonBusy } from "../lib/authUi";

    const form = document.querySelector("#register-form");
    const message = document.querySelector("#register-message");
    const submit = document.querySelector<HTMLButtonElement>("#register-submit");
    const googleLink = document.querySelector<HTMLAnchorElement>("#register-google-link");

    installPasswordToggles();

    const getToken = (payload: unknown) => {
      if (!payload || typeof payload !== "object") {
        return null;
      }

      const record = payload as Record<string, unknown>;
      const token = record.authToken ?? record.auth_token ?? record.token ?? record.jwt;

      return typeof token === "string" ? token : null;
    };

    const getUser = (payload: unknown) => {
      if (!payload || typeof payload !== "object") {
        return null;
      }

      const record = payload as Record<string, unknown>;
      return record.user ?? record.me ?? record.authUser ?? null;
    };

    const getFriendlyRegisterError = (error: unknown) => {
      const value = String(error || "");

      if (value.toLowerCase().includes("duplicate")) {
        return "Этот email уже зарегистрирован. Нажмите «Войти» и используйте этот email или Google-вход.";
      }

      if (value.toLowerCase().includes("password")) {
        return "Пароль должен быть не короче 8 символов и содержать буквы и цифры.";
      }

      return getFriendlyErrorMessage(value, "Не удалось создать аккаунт. Проверьте данные и попробуйте снова.");
    };

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!(form instanceof HTMLFormElement) || !(message instanceof HTMLElement)) {
        return;
      }
      message.hidden = false;

      const panel = form.closest(".auth-panel");
      const apiUrl = panel instanceof HTMLElement ? panel.dataset.apiUrl : "";
      const placeholderUrl = panel instanceof HTMLElement ? panel.dataset.placeholderUrl : "";

      if (!apiUrl || apiUrl === placeholderUrl) {
        message.textContent = "Регистрация временно недоступна. Попробуйте позже.";
        return;
      }

      const formData = new FormData(form);
      const password = String(formData.get("password") || "");
      const passwordConfirm = String(formData.get("passwordConfirm") || "");

      if (password !== passwordConfirm) {
        message.textContent = "Пароли не совпадают.";
        return;
      }

      const payload = {
        name: String(formData.get("name") || "").trim(),
        email: String(formData.get("email") || "").trim().toLowerCase(),
        password,
      };

      try {
        message.textContent = "Создаю аккаунт...";
        if (googleLink) googleLink.hidden = true;
        setAuthButtonBusy(submit, true, "Создаю аккаунт...");

        const response = await fetch(`${apiUrl}/auth/register`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        });
        const contentType = response.headers.get("content-type") || "";
        const result = contentType.includes("application/json")
          ? await response.json()
          : await response.text();

        if (!response.ok) {
          const registrationMessage = getRegistrationErrorMessage(result);
          const registrationCode = getRegistrationErrorCode(result);

          if (registrationMessage) {
            message.textContent = registrationMessage;
            if (googleLink) googleLink.hidden = registrationCode !== "ACCOUNT_LINK_REQUIRED";
            return;
          }

          const details =
            result && typeof result === "object"
              ? ((result as Record<string, unknown>).message ?? (result as Record<string, unknown>).code)
              : result;

          throw new Error(typeof details === "string" && details ? details : "Не удалось создать аккаунт.");
        }

        const token = getToken(result);
        const user = getUser(result);

        if (!token) {
          throw new Error("auth token missing");
        }

        setAuthToken(token);

        if (user) {
          setAuthUser(user);
        }

        const next = new URLSearchParams(window.location.search).get("next") || consumeNext("/dashboard");
        message.textContent = "Аккаунт создан. Открываю кабинет...";
        window.location.href = next;
      } catch (error) {
        message.textContent = getFriendlyRegisterError(error instanceof Error ? error.message : error);
      } finally {
        setAuthButtonBusy(submit, false, "Создаю аккаунт...");
      }
    });
  </script>
</BaseLayout>
