---
import BaseLayout from "../layouts/BaseLayout.astro";
import CarCard from "../components/CarCard.astro";
import LoadingState from "../components/states/LoadingState.astro";
import { carBrands, popularCarBrands } from "../data/carOptions";
import { getBrandLogoSvg } from "../lib/brandLogos";
import { getApprovedCars } from "../lib/xano";
import { isPublicListing } from "../lib/listingStatus";
import type { CarListing } from "../lib/types";
import { GERMAN_PUBLIC_ROUTES_ENABLED } from "../lib/config";
import { LOCALE_COOKIE, resolveRequestLocale } from "../i18n/locales";
import { getBackendValueOptions } from "../i18n/backendValues";
import { getMessages } from "../i18n/messages";

const xanoApiUrl = import.meta.env.PUBLIC_XANO_API_URL;
const locale = resolveRequestLocale(Astro.url, Astro.cookies.get(LOCALE_COOKIE)?.value);
const messages = getMessages(locale);
const fuelOptions = getBackendValueOptions("fuel_type", locale);
const transmissionOptions = getBackendValueOptions("transmission", locale);
const bodyOptions = getBackendValueOptions("body_type", locale);
const vehicleOptions = getBackendValueOptions("vehicle_type", locale);
let latestCars: CarListing[] = [];
try {
  latestCars = (await getApprovedCars(locale)).filter(isPublicListing).slice(0, 8);
} catch {
  latestCars = [];
}
---

<BaseLayout
  title={messages.homeTitle}
  variant="public"
  locale={locale}
  alternateLocales={GERMAN_PUBLIC_ROUTES_ENABLED ? [
    { locale: "ru", path: "/", label: "Русский" },
    { locale: "de", path: "/de/", label: "Deutsch" },
  ] : []}
>
  <section class="market-hero">
    <div class="market-hero-media" aria-hidden="true">
      <img id="home-hero-image" alt="" hidden />
    </div>
    <div class="container market-hero-inner">
      <div class="market-hero-copy">
        <p class="eyebrow">SiteCraft Auto Market</p>
        <h1>{messages.homeHeroTitle}</h1>
        <p class="lead">{messages.homeHeroLead}</p>
        <div class="hero-cta-row">
          <a class="button button-accent" href="/dashboard/new"><i data-lucide="plus" aria-hidden="true"></i><span>{messages.homeCreateFromPhoto}</span></a>
          <a class="button button-light" href="/cars#ai-buyer-search-title"><i data-lucide="search" aria-hidden="true"></i><span>{messages.homeFindWithAi}</span></a>
        </div>
        <p class="ai-microcopy">{messages.homeAiDisclaimer}</p>
      </div>

      <div
        class="home-search-panel"
        id="home-search-panel"
        data-api-url={xanoApiUrl}
        data-locale={locale}
        data-messages={JSON.stringify(messages)}
        data-body-options={JSON.stringify(bodyOptions)}
        data-vehicle-options={JSON.stringify(vehicleOptions)}
      >
        <div class="search-tabs" aria-label={messages.categoryVehicle}>
          <button class="search-tab is-active" type="button">{messages.tabCars}</button>
          <button class="search-tab" type="button">{messages.tabElectric}</button>
          <button class="search-tab" type="button">{messages.tabPremium}</button>
        </div>
        <form class="market-search" id="home-search-form">
          <label class="search-field search-field-brand">
            {messages.fieldBrand}
            <select name="brand">
              <option value="">{messages.anyValue}</option>
              {carBrands.map((brand) => <option value={brand}>{brand}</option>)}
            </select>
          </label>
          <label class="search-field search-field-model">
            {messages.fieldModel}
            <input name="model" type="search" placeholder={messages.modelExample} />
          </label>
          <label class="search-field search-field-price-max">
            {messages.fieldPriceTo}
            <input name="price_max" type="number" min="0" step="100" placeholder="40000" />
          </label>
          <label class="search-field search-field-year">
            {messages.fieldYearFrom}
            <input name="year" type="number" min="1950" max="2030" placeholder="2018" />
          </label>
          <details class="home-extra-filters">
            <summary><span>Больше фильтров</span><i data-lucide="chevron-down" aria-hidden="true"></i></summary>
            <div class="home-extra-filters-grid">
              <label class="search-field search-field-price-min">{messages.fieldPriceFrom}<input name="price_min" type="number" min="0" step="100" placeholder="5000" /></label>
              <label class="search-field search-field-mileage">{messages.fieldMileageTo}<input name="mileage" type="number" min="0" step="1000" placeholder="150000" /></label>
              <label class="search-field search-field-fuel">{messages.fieldFuel}<select name="fuel"><option value="">{messages.anyValue}</option>{fuelOptions.map((fuel) => <option value={fuel.value}>{fuel.label}</option>)}</select></label>
              <label class="search-field search-field-transmission">{messages.fieldTransmission}<select name="transmission"><option value="">{messages.anyValue}</option>{transmissionOptions.map((transmission) => <option value={transmission.value}>{transmission.label}</option>)}</select></label>
              <label class="search-field search-field-city">{messages.fieldCity}<input name="city" type="search" placeholder={messages.cityExample} /></label>
            </div>
          </details>
          <div class="search-actions">
            <button class="button button-accent" id="home-search-button" type="submit">
              {messages.viewListings}
            </button>
            <button class="button button-ghost" id="home-reset-button" type="button">{messages.reset}</button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <section class="section home-ai-features">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">AI marketplace</p>
          <h2>{messages.aiHelps}</h2>
        </div>
      </div>
      <div class="ai-feature-grid">
        <article class="ai-feature-card">
          <span>01</span>
          <h3>{messages.aiDraftTitle}</h3>
          <p>{messages.aiDraftText}</p>
        </article>
        <article class="ai-feature-card">
          <span>02</span>
          <h3>{messages.aiImproveTitle}</h3>
          <p>{messages.aiImproveText}</p>
        </article>
        <article class="ai-feature-card">
          <span>03</span>
          <h3>{messages.aiBuyerTitle}</h3>
          <p>{messages.aiBuyerText}</p>
        </article>
        <article class="ai-feature-card">
          <span>04</span>
          <h3>{messages.aiModeratorTitle}</h3>
          <p>{messages.aiModeratorText}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section home-categories">
    <div class="container">
      <div class="section-heading row-heading">
        <div>
          <h2>{messages.carCategories}</h2>
        </div>
        <div class="slider-controls" aria-label={messages.categoryControls}>
          <button class="slider-button" id="category-prev" type="button" aria-label={messages.previousCategories}><i data-lucide="chevron-left" aria-hidden="true"></i></button>
          <button class="slider-button" id="category-next" type="button" aria-label={messages.nextCategories}><i data-lucide="chevron-right" aria-hidden="true"></i></button>
        </div>
      </div>
      <div class="category-carousel" aria-label={messages.carCategoriesLabel}>
        <div class="category-track" id="home-category-track">
          <div class="category-loading">{messages.categoriesLoading}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section home-brand-section">
    <div class="container">
      <div class="section-heading row-heading">
        <div>
          <h2>{messages.quickBrand}</h2>
        </div>
        <div class="slider-controls" aria-label={messages.brandControls}>
          <button class="slider-button" id="brand-prev" type="button" aria-label={messages.previousBrands}><i data-lucide="chevron-left" aria-hidden="true"></i></button>
          <button class="slider-button" id="brand-next" type="button" aria-label={messages.nextBrands}><i data-lucide="chevron-right" aria-hidden="true"></i></button>
        </div>
      </div>
      <div class="brand-carousel" aria-label={messages.popularBrands}>
        <div class="brand-track" id="home-brand-track">
          {popularCarBrands.map((brand) => (
            <a class="brand-chip-card" href={`/cars?brand=${encodeURIComponent(brand)}`}>
              <span class="brand-logo-wrap" set:html={getBrandLogoSvg(brand)} />
              <span class="brand-chip-copy">
                <strong>{brand}</strong>
                <span class="brand-chip-count">{messages.view}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>{messages.freshCars}</h2>
        </div>
      </div>
      <div
        class="cards-grid public-car-grid"
        id="home-live-cars-grid"
        hidden={latestCars.length === 0}
      >
        {latestCars.map((car, index) => <CarCard car={car} priority={index < 4} source="homepage_latest" />)}
      </div>
      <div id="home-loading-state" hidden={latestCars.length > 0}><LoadingState title={messages.loadingCars} text={messages.loadingCarsText} /></div>
      <p class="form-message" id="home-live-cars-message"></p>
      <div class="center-action">
        <a class="button button-light" href="/cars">{messages.allCars}</a>
      </div>
    </div>
  </section>

  <section class="section homepage-promotions" id="homepage-promotions" hidden aria-labelledby="homepage-promotions-title">
    <div class="container">
      <div class="section-heading row-heading">
        <div>
          <p class="eyebrow">{messages.tabPremium}</p>
          <h2 id="homepage-promotions-title">{messages.premiumCars}</h2>
          <p class="section-subtitle">{messages.premiumDisclosure}</p>
        </div>
        <a class="button button-light" href="/cars">{messages.viewCatalog}</a>
      </div>
      <div class="cards-grid public-car-grid" data-homepage-promotions-grid></div>
    </div>
  </section>

  <script>
    import { getBrandLogoSvg } from "../lib/brandLogos";
    import { isPublicListing } from "../lib/listingStatus";
    import { renderPublicCarCardMarkup } from "../lib/publicCarCard";
    import { normalizePublicCarList } from "../lib/publicCar";
    import { applyListingTranslations } from "../lib/listingTranslation";
    import { installPublicCarCardInteractions, refreshPublicCarCardIcons } from "../lib/publicCarCardsClient";
    import { fetchWithRetry } from "../lib/http/fetchWithRetry";
    import { getHomepagePromotedCars, sortCarsByActivePromotion } from "../lib/promotions/model";
    import type { CarListing } from "../lib/types";
    import { normalizeBackendValue } from "../i18n/backendValues";
    import { resolveLocale } from "../i18n/locales";

    const liveGrid = document.querySelector("#home-live-cars-grid");
    const loadingState = document.querySelector("#home-loading-state");
    const message = document.querySelector("#home-live-cars-message");
    const searchPanel = document.querySelector("#home-search-panel");
    const searchForm = document.querySelector("#home-search-form");
    const resetButton = document.querySelector("#home-reset-button");
    const searchButton = document.querySelector("#home-search-button");
    const heroImage = document.querySelector("#home-hero-image");
    const categoryTrack = document.querySelector("#home-category-track");
    const categoryPrev = document.querySelector("#category-prev");
    const categoryNext = document.querySelector("#category-next");
    const brandTrack = document.querySelector("#home-brand-track");
    const brandPrev = document.querySelector("#brand-prev");
    const brandNext = document.querySelector("#brand-next");
    const homepagePromotions = document.querySelector("#homepage-promotions");
    const homepagePromotionsGrid = document.querySelector("[data-homepage-promotions-grid]");
    const locale = resolveLocale(searchPanel instanceof HTMLElement ? searchPanel.dataset.locale : "ru");
    const parseData = <T,>(value: string | undefined, fallback: T): T => {
      try {
        return value ? JSON.parse(value) as T : fallback;
      } catch {
        return fallback;
      }
    };
    const messages = parseData<Record<string, string>>(
      searchPanel instanceof HTMLElement ? searchPanel.dataset.messages : undefined,
      {},
    );
    const bodyTypeOptions = parseData<Array<{ value: string; label: string }>>(
      searchPanel instanceof HTMLElement ? searchPanel.dataset.bodyOptions : undefined,
      [],
    );
    const vehicleTypeOptions = parseData<Array<{ value: string; label: string }>>(
      searchPanel instanceof HTMLElement ? searchPanel.dataset.vehicleOptions : undefined,
      [],
    );
    const text = (key: string, values: Record<string, string | number> = {}) =>
      Object.entries(values).reduce(
        (result, [name, value]) => result.replaceAll(`{${name}}`, String(value)),
        messages[key] || key,
      );
    const popularBrandOptions = ["Audi", "BMW", "Mercedes-Benz", "Volkswagen", "Toyota", "Ford", "Hyundai", "Kia", "Skoda", "Mazda", "Opel", "Tesla"];
    let allCars: Array<Record<string, unknown>> = [];

    const formatPrice = (price: unknown, currency: string) =>
      new Intl.NumberFormat(locale, {
        style: "currency",
        currency: currency || "EUR",
        maximumFractionDigits: 0,
      }).format(Number(price || 0));

    const escapeHtml = (value: unknown) =>
      String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    const toDate = (value: unknown) => {
      if (!value) {
        return null;
      }

      const stringValue = String(value);
      const date = typeof value === "number" || /^\d+$/.test(stringValue)
        ? new Date(Number(value))
        : new Date(stringValue);

      return Number.isNaN(date.getTime()) ? null : date;
    };

    const parseStringArray = (value: unknown): string[] => {
      if (Array.isArray(value)) {
        return value.filter((item): item is string => typeof item === "string" && item.length > 0);
      }

      if (typeof value === "string" && value.trim()) {
        try {
          return parseStringArray(JSON.parse(value));
        } catch {
          return value.startsWith("http") ? [value] : [];
        }
      }

      return [];
    };

    const getImageMetadataVariantUrl = (value: unknown, variants: string[] = []) => {
      if (!value || typeof value !== "object") {
        return "";
      }

      const metadata = value as Record<string, unknown>;
      const variantUrls = variants.map((variant) => {
        const variantGroup = metadata.variants;
        if (!variantGroup || typeof variantGroup !== "object") {
          return "";
        }

        const variantValue = (variantGroup as Record<string, unknown>)[variant];
        return variantValue && typeof variantValue === "object"
          ? (variantValue as Record<string, unknown>).url
          : "";
      });
      const optimized = metadata.optimized;
      const optimizedUrl = optimized && typeof optimized === "object"
        ? (optimized as Record<string, unknown>).url
        : "";
      const url = [...variantUrls, optimizedUrl, metadata.url, metadata.public_url, metadata.image_url, metadata.src, metadata.path]
        .find((candidate) => typeof candidate === "string" && candidate.length > 0);

      return typeof url === "string" && url.startsWith("http") ? url : "";
    };

    const getCarCoverImageUrl = (car?: Record<string, unknown>) => {
      if (!car) {
        return "";
      }

      const images = Array.isArray(car.images) ? car.images : [];
      const imageFromRows = images
        .map((image: { image_url?: string; image?: { url?: string }; image_metadata?: unknown }) =>
          getImageMetadataVariantUrl(image.image_metadata, ["card", "thumb", "detail"]) || image.image_url || image.image?.url
        )
        .find(Boolean);

      return String(car.cover_image_url || car.main_image_url || parseStringArray(car.image_urls)[0] || imageFromRows || "");
    };

    const newestFirst = (cars: Array<Record<string, unknown>>) =>
      [...cars].sort((left, right) => {
        const leftTime = toDate(left.created_at)?.getTime() ?? 0;
        const rightTime = toDate(right.created_at)?.getTime() ?? 0;
        return rightTime - leftTime;
      });

    const renderCarCard = (car: Record<string, unknown>, index = 0) =>
      renderPublicCarCardMarkup(car as CarListing, { priority: index < 4, locale });

    const getFieldFromDescription = (car: Record<string, unknown>, label: string) => {
      const expression = new RegExp(`^${label}:\\\\s*(.+)$`, "im");
      const match = String(car.description || "").match(expression);
      return match?.[1]?.trim() || "";
    };

    const getCarBodyType = (car: Record<string, unknown>) =>
      normalizeBackendValue("body_type", car.body_type || getFieldFromDescription(car, "Кузов") || "");

    const getCarVehicleType = (car: Record<string, unknown>) => {
      const explicit = normalizeBackendValue("vehicle_type", car.vehicle_type || getFieldFromDescription(car, "Тип транспорта") || "");

      if (explicit && explicit !== "не указан") {
        return explicit;
      }

      if (normalizeBackendValue("fuel_type", car.fuel_type) === "electric") {
        return "electric_vehicle";
      }

      if (["van", "pickup"].includes(getCarBodyType(car))) {
        return "commercial_vehicle";
      }

      return "passenger_car";
    };

    const categoryDefinitions = [
      ...vehicleTypeOptions.map((option) => ({
        title: option.label,
        text: text("categoryVehicleText"),
        href: `/cars?vehicle_type=${encodeURIComponent(option.value)}`,
        match: (car: Record<string, unknown>) => getCarVehicleType(car) === option.value,
      })),
      ...bodyTypeOptions.map((option) => ({
        title: option.label,
        text: text("categoryBodyText", { value: option.label.toLocaleLowerCase(locale) }),
        href: `/cars?body_type=${encodeURIComponent(option.value)}`,
        match: (car: Record<string, unknown>) => getCarBodyType(car) === option.value,
      })),
    ];

    const pickCategoryCar = (
      cars: Array<Record<string, unknown>>,
      match: (car: Record<string, unknown>) => boolean,
    ) => cars.find((car) => match(car) && Boolean(getCarCoverImageUrl(car))) || cars.find((car) => match(car)) || cars[0];

    const renderCategories = (cars: Array<Record<string, unknown>>) => {
      if (!(categoryTrack instanceof HTMLElement)) {
        return;
      }

      if (cars.length === 0) {
        categoryTrack.innerHTML = `<div class="category-loading">${escapeHtml(text("categoriesEmpty"))}</div>`;
        return;
      }

      categoryTrack.innerHTML = categoryDefinitions
        .map((category) => {
          const car = pickCategoryCar(cars, category.match);
          const imageUrl = getCarCoverImageUrl(car);
          const slug = category.href || (car?.slug ? `/cars/${encodeURIComponent(String(car.slug))}` : "/cars");
          const meta = car
            ? `${escapeHtml(car.brand)} ${escapeHtml(car.model)} · ${formatPrice(car.price, String(car.currency || "EUR"))}`
            : text("viewListings");

          return `
            <a class="category-slide" href="${slug}" aria-label="${escapeHtml(category.title)}">
              ${
                imageUrl
                  ? `<img src="${escapeHtml(imageUrl)}" alt="" loading="lazy" />`
                  : `<div class="category-slide-empty">${escapeHtml(text("photoMissing"))}</div>`
              }
              <div class="category-slide-body">
                <h3>${escapeHtml(category.title)}</h3>
                <p>${escapeHtml(category.text)}</p>
                <span>${meta}</span>
              </div>
            </a>
          `;
        })
        .join("");
    };

    const scrollCategories = (direction: number) => {
      if (!(categoryTrack instanceof HTMLElement)) {
        return;
      }

      categoryTrack.scrollBy({
        left: direction * Math.max(260, categoryTrack.clientWidth * 0.8),
        behavior: "smooth",
      });
    };

    categoryPrev?.addEventListener("click", () => scrollCategories(-1));
    categoryNext?.addEventListener("click", () => scrollCategories(1));

    const renderBrands = (cars: Array<Record<string, unknown>>) => {
      if (!(brandTrack instanceof HTMLElement)) {
        return;
      }

      brandTrack.innerHTML = popularBrandOptions
        .map((brand) => {
          const count = cars.filter((car) => String(car.brand || "").toLowerCase() === brand.toLowerCase()).length;

          return `
            <a class="brand-chip-card" href="/cars?brand=${encodeURIComponent(brand)}" aria-label="${escapeHtml(text("showBrand", { value: brand }))}">
              <span class="brand-logo-wrap">${getBrandLogoSvg(brand)}</span>
              <span class="brand-chip-copy">
                <strong>${escapeHtml(brand)}</strong>
                <span class="brand-chip-count">${escapeHtml(text("listingsCount", { count }))}</span>
              </span>
            </a>
          `;
        })
        .join("");
    };

    const scrollBrands = (direction: number) => {
      if (!(brandTrack instanceof HTMLElement)) {
        return;
      }

      brandTrack.scrollBy({
        left: direction * Math.max(220, brandTrack.clientWidth * 0.8),
        behavior: "smooth",
      });
    };

    brandPrev?.addEventListener("click", () => scrollBrands(-1));
    brandNext?.addEventListener("click", () => scrollBrands(1));

    const applyHeroImage = (cars: Array<Record<string, unknown>>) => {
      const firstCarWithImage = cars.find((car) => Boolean(getCarCoverImageUrl(car)));
      const imageUrl = getCarCoverImageUrl(firstCarWithImage);

      if (heroImage instanceof HTMLImageElement && imageUrl) {
        heroImage.src = imageUrl;
        heroImage.hidden = false;
      }
    };

    const matchesFilters = (car: Record<string, unknown>, formData: FormData) => {
      const brand = String(formData.get("brand") || "").toLowerCase();
      const model = String(formData.get("model") || "").toLowerCase();
      const fuel = String(formData.get("fuel") || "").toLowerCase();
      const transmission = String(formData.get("transmission") || "").toLowerCase();
      const city = String(formData.get("city") || "").toLowerCase();
      const minPrice = Number(formData.get("price_min") || 0);
      const maxPrice = Number(formData.get("price_max") || formData.get("price") || 0);
      const minYear = Number(formData.get("year") || 0);
      const maxMileage = Number(formData.get("mileage") || 0);

      return (
        (!brand || String(car.brand || "").toLowerCase() === brand) &&
        (!model || String(car.model || "").toLowerCase().includes(model)) &&
        (!fuel || normalizeBackendValue("fuel_type", car.fuel_type) === fuel) &&
        (!transmission || normalizeBackendValue("transmission", car.transmission) === transmission) &&
        (!city || String(car.city || "").toLowerCase().includes(city)) &&
        (!minPrice || Number(car.price || 0) >= minPrice) &&
        (!maxPrice || Number(car.price || 0) <= maxPrice) &&
        (!minYear || Number(car.year || 0) >= minYear) &&
        (!maxMileage || Number(car.mileage || 0) <= maxMileage)
      );
    };

    const applyHomeFilters = () => {
      if (!(searchForm instanceof HTMLFormElement)) {
        return;
      }

      const formData = new FormData(searchForm);
      const hasActiveFilter = Array.from(formData.values()).some((value) => String(value || "").trim() !== "");
      const filteredCars = hasActiveFilter
        ? allCars.filter((car) => matchesFilters(car, formData))
        : allCars;

      renderCars(filteredCars, hasActiveFilter);

      if (searchButton instanceof HTMLButtonElement) {
        searchButton.textContent = hasActiveFilter ? text("showFiltered", { count: filteredCars.length }) : text("viewListings");
      }
    };

    const renderCars = (cars: Array<Record<string, unknown>>, filtered = false) => {
      if (!(liveGrid instanceof HTMLElement) || !(message instanceof HTMLElement)) {
        return;
      }

      const orderedCars = sortCarsByActivePromotion(cars as CarListing[]) as Array<Record<string, unknown>>;
      liveGrid.innerHTML = orderedCars.slice(0, filtered ? 12 : 6).map(renderCarCard).join("");
      liveGrid.hidden = orderedCars.length === 0;
      refreshPublicCarCardIcons(liveGrid);

      if (homepagePromotions instanceof HTMLElement && homepagePromotionsGrid instanceof HTMLElement) {
        const promoted = getHomepagePromotedCars(cars as CarListing[]);
        homepagePromotions.hidden = promoted.length === 0;
        homepagePromotionsGrid.innerHTML = promoted.map((car, index) => renderPublicCarCardMarkup(car, { priority: index < 2, locale })).join("");
        refreshPublicCarCardIcons(homepagePromotionsGrid);
      }

      if (loadingState instanceof HTMLElement) {
        loadingState.hidden = true;
      }

      if (orderedCars.length === 0) {
        message.textContent = filtered
          ? text("noFilteredCars")
          : text("noCars");
        return;
      }

      message.textContent = filtered
        ? text("foundCars", { count: orderedCars.length })
        : text("newestCars");
    };

    if (searchPanel instanceof HTMLElement && message instanceof HTMLElement) {
      const apiUrl = searchPanel.dataset.apiUrl;
      if (apiUrl) {
        const loadFreshCars = () => fetchWithRetry(`${apiUrl}/cars?lang=${encodeURIComponent(locale)}`, {}, { dedupeKey: `home-fresh-cars:${locale}` })
          .then((response) => {
            if (!response.ok) {
              throw new Error("latest cars load failed");
            }

            return response.json();
          })
          .then((cars) => {
            if (!Array.isArray(cars) || cars.length === 0) {
              if (loadingState instanceof HTMLElement) {
                loadingState.hidden = true;
              }
              message.textContent = text("noCars");
              return;
            }

            allCars = newestFirst(applyListingTranslations(normalizePublicCarList(cars), locale).filter(isPublicListing));
            applyHeroImage(allCars);
            renderCategories(allCars);
            renderBrands(allCars);
            renderCars(allCars);
          })
          .catch(() => {
            if (loadingState instanceof HTMLElement) {
              loadingState.hidden = true;
            }
            message.textContent = liveGrid instanceof HTMLElement && liveGrid.children.length > 0
              ? text("loadCarsFailed")
              : text("loadCarsFailed");
          });
        void loadFreshCars();
        window.addEventListener("online", () => {
          if (message.textContent.includes("Не удалось")) void loadFreshCars();
        });
      } else {
        if (loadingState instanceof HTMLElement) {
          loadingState.hidden = true;
        }
        message.textContent = text("serviceUnavailable");
      }
    }

    searchForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      applyHomeFilters();
    });

    installPublicCarCardInteractions();

    searchForm?.addEventListener("change", applyHomeFilters);
    searchForm?.addEventListener("input", () => {
      window.clearTimeout(Number(searchForm instanceof HTMLElement ? searchForm.dataset.filterTimer : 0));
      const timer = window.setTimeout(applyHomeFilters, 180);
      if (searchForm instanceof HTMLElement) {
        searchForm.dataset.filterTimer = String(timer);
      }
    });

    resetButton?.addEventListener("click", () => {
      if (searchForm instanceof HTMLFormElement) {
        searchForm.reset();
      }

      if (searchButton instanceof HTMLButtonElement) {
        searchButton.textContent = text("viewListings");
      }

      renderCars(allCars);
    });
  </script>
</BaseLayout>
