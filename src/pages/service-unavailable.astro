---
import BaseLayout from "../layouts/BaseLayout.astro";
import ErrorState from "../components/states/ErrorState.astro";

export const prerender = false;

Astro.response.status = 503;
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Retry-After", "300");
---

<BaseLayout
  variant="public"
  title="Сервис временно недоступен"
  description="Не удалось загрузить объявление из источника данных."
  noindex
>
  <section class="section system-state-section">
    <div class="container system-state-container">
      <ErrorState title="Сервис временно недоступен" text="Объявление не потеряно. Попробуйте открыть страницу ещё раз через несколько минут." href="/cars" action="Перейти к автомобилям">
        <button class="button button-primary" type="button" onclick="window.location.reload()">Повторить</button>
      </ErrorState>
    </div>
  </section>
</BaseLayout>
