---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { formatCurrency, formatDate, formatMileage } from "../../../i18n/format";
import { toGermanPublicListing } from "../../../i18n/publicListing";
import { getVehicleTaxonomyLabel } from "../../../domain/vehicleTaxonomy";
import { GERMAN_PUBLIC_ROUTES_ENABLED, I18N_PREVIEW_NOINDEX, SITE_URL } from "../../../lib/config";
import { isValidPublicCarSlug } from "../../../lib/publicCar";
import { buildGermanVehicleSeo } from "../../../lib/seo/germanVehicleSeo";
import { getCarBySlug } from "../../../lib/xano";

export const prerender = false;

if (!GERMAN_PUBLIC_ROUTES_ENABLED) {
  Astro.response.status = 404;
  Astro.response.headers.set("Cache-Control", "no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
  return Astro.rewrite("/404");
}

let slug = typeof Astro.params.slug === "string" ? Astro.params.slug.trim() : "";
try {
  slug = decodeURIComponent(slug).trim();
} catch {
  slug = "";
}
if (!isValidPublicCarSlug(slug)) {
  Astro.response.status = 404;
  Astro.response.headers.set("Cache-Control", "no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
  return Astro.rewrite("/404");
}

const requestStarted = performance.now();
let sourceListing = null;
try {
  sourceListing = await getCarBySlug(slug, "de");
} catch {
  Astro.response.status = 503;
  Astro.response.headers.set("Cache-Control", "no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
  return Astro.rewrite("/service-unavailable");
}
const car = sourceListing ? toGermanPublicListing(sourceListing) : null;
if (!car) {
  Astro.response.status = 404;
  Astro.response.headers.set("Cache-Control", "no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
  return Astro.rewrite("/404");
}

const queryDuration = Math.max(0, performance.now() - requestStarted).toFixed(1);
Astro.response.headers.set("Server-Timing", `locale-read;dur=${queryDuration};desc=\"single listing query\"`);
Astro.response.headers.set("X-SiteCraft-Query-Count", "1");
Astro.response.headers.set("Cache-Control", I18N_PREVIEW_NOINDEX ? "no-store" : "public, max-age=0, s-maxage=300, stale-while-revalidate=3600");
Astro.response.headers.set("X-Robots-Tag", I18N_PREVIEW_NOINDEX ? "noindex, nofollow" : "index, follow");

const seo = buildGermanVehicleSeo(car, SITE_URL);
const specs = [
  ["Preis", formatCurrency(car.price, car.currency, "de")],
  ["Kilometerstand", formatMileage(car.mileage, "de")],
  ["Erstzulassung", car.year ? String(car.year) : ""],
  ["Kraftstoff", getVehicleTaxonomyLabel("fuel_type", car.fuel_type, "de") || car.fuel_type],
  ["Getriebe", getVehicleTaxonomyLabel("transmission", car.transmission, "de") || car.transmission],
  ["Karosserie", getVehicleTaxonomyLabel("body_type", car.body_type, "de") || car.body_type],
  ["Ort", car.city],
  ["Aktualisiert", formatDate(car.updated_at, "de")],
].filter(([, value]) => Boolean(value));
---

<BaseLayout
  variant="public"
  locale="de"
  title={seo.title}
  description={seo.description}
  canonicalPath={`/de/cars/${car.slug}/`}
  image={seo.imageUrl}
  noindex={I18N_PREVIEW_NOINDEX}
  ogType="product"
  jsonLd={[seo.vehicle, seo.offer, seo.breadcrumb]}
  breadcrumbs={[
    { href: "/de/", label: "Startseite" },
    { href: "/de/cars/", label: "Fahrzeuge" },
    { label: seo.heading },
  ]}
  alternateLocales={[
    { locale: "ru", path: `/cars/${car.slug}/`, label: "Русская версия" },
    { locale: "de", path: `/de/cars/${car.slug}/`, label: "Deutsch" },
  ]}
>
  <section class="section car-detail-section">
    <div class="container detail-container">
      <article class="detail-grid car-detail-grid">
        <div class="gallery car-slider">
          <div class="gallery-stage">
            <img src={car.image_urls[0] || "/deal-finder-placeholder.svg"} alt={seo.imageAlt} width="1200" height="800" fetchpriority="high" decoding="async" />
          </div>
        </div>
        <div class="detail-panel compact-detail-panel">
          <span class="status-badge status-approved">Geprüfte Anzeige</span>
          <h1>{seo.heading}</h1>
          <p class="detail-price">{formatCurrency(car.price, car.currency, "de")}</p>
          <p>{car.city || "Ort nicht angegeben"}</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section detail-properties-section" aria-labelledby="vehicle-data">
    <div class="container">
      <div class="detail-properties-panel">
        <div class="section-heading"><div><p class="eyebrow">Fahrzeugdaten</p><h2 id="vehicle-data">Technische Angaben</h2></div></div>
        <dl class="detail-property-grid">
          {specs.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="section detail-description-section" aria-labelledby="vehicle-description">
    <div class="container">
      <div class="detail-description-panel">
        <div class="section-heading"><div><p class="eyebrow">Beschreibung</p><h2 id="vehicle-description">Über dieses Fahrzeug</h2></div></div>
        <p class="detail-description">{car.description}</p>
      </div>
    </div>
  </section>
</BaseLayout>
