---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { formatCurrency, formatMileage } from "../../../i18n/format";
import { projectGermanCatalog } from "../../../i18n/publicListing";
import { getVehicleTaxonomyLabel } from "../../../domain/vehicleTaxonomy";
import { GERMAN_PUBLIC_ROUTES_ENABLED, I18N_PREVIEW_NOINDEX, SITE_URL } from "../../../lib/config";
import { getApprovedCars } from "../../../lib/xano";

export const prerender = false;

if (!GERMAN_PUBLIC_ROUTES_ENABLED) {
  Astro.response.status = 404;
  Astro.response.headers.set("Cache-Control", "no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
  return Astro.rewrite("/404");
}

const requestStarted = performance.now();
let sourceListings = [];
try {
  sourceListings = await getApprovedCars("de", { requireConfigured: true });
} catch {
  Astro.response.status = 503;
  Astro.response.headers.set("Cache-Control", "no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
  return Astro.rewrite("/service-unavailable");
}
const cars = projectGermanCatalog(sourceListings);
const queryDuration = Math.max(0, performance.now() - requestStarted).toFixed(1);
Astro.response.headers.set("Server-Timing", `locale-read;dur=${queryDuration};desc=\"bounded catalog query\"`);
Astro.response.headers.set("X-SiteCraft-Query-Count", "1");
Astro.response.headers.set("Cache-Control", I18N_PREVIEW_NOINDEX ? "no-store" : "public, max-age=0, s-maxage=120, stale-while-revalidate=600");
Astro.response.headers.set("X-Robots-Tag", I18N_PREVIEW_NOINDEX ? "noindex, nofollow" : "index, follow");

const siteUrl = SITE_URL || "https://automarket.sitecraft.agency";
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Fahrzeuge",
  description: "Geprüfte Fahrzeuganzeigen mit aktuellen deutschen Inhalten.",
  inLanguage: "de",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: cars.map((car, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/de/cars/${car.slug}/`, siteUrl).toString(),
      name: car.title,
    })),
  },
};
---

<BaseLayout
  variant="public"
  locale="de"
  title="Fahrzeuge"
  description="Geprüfte Fahrzeuganzeigen mit aktuellen deutschen Inhalten."
  canonicalPath="/de/cars/"
  noindex={I18N_PREVIEW_NOINDEX}
  jsonLd={collectionSchema}
  breadcrumbs={[{ href: "/de/", label: "Startseite" }, { label: "Fahrzeuge" }]}
  alternateLocales={[
    { locale: "ru", path: "/cars/", label: "Русская версия" },
    { locale: "de", path: "/de/cars/", label: "Deutsch" },
  ]}
>
  <section class="section page-hero catalog-hero">
    <div class="container">
      <p class="eyebrow">Fahrzeugkatalog</p>
      <h1>Fahrzeuge</h1>
      <p class="lead">Nur Anzeigen mit freigegebenem und aktuellem deutschen Inhalt werden angezeigt.</p>
    </div>
  </section>

  <section class="section catalog-results-section">
    <div class="container">
      <div class="catalog-results-toolbar">
        <div><span>Ergebnisse</span><strong>{cars.length} Fahrzeuge</strong></div>
      </div>
      {cars.length > 0 ? (
        <div class="cards-grid catalog-grid">
          {cars.map((car, index) => (
            <article class="car-card">
              <a class="car-card-media" href={`/de/cars/${car.slug}/`} aria-label={`${car.title} ansehen`}>
                <img src={car.image_urls[0] || "/deal-finder-placeholder.svg"} alt={car.title} loading={index < 4 ? "eager" : "lazy"} decoding="async" />
              </a>
              <div class="car-card-body">
                <h2><a href={`/de/cars/${car.slug}/`}>{car.title}</a></h2>
                <p class="car-card-price">{formatCurrency(car.price, car.currency, "de")}</p>
                <ul class="car-card-specs" aria-label="Fahrzeugdaten">
                  <li>{car.year || "–"}</li>
                  <li>{formatMileage(car.mileage, "de") || "–"}</li>
                  <li>{getVehicleTaxonomyLabel("fuel_type", car.fuel_type, "de") || car.fuel_type || "–"}</li>
                  <li>{car.city || "Ort nicht angegeben"}</li>
                </ul>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state" role="status">
          <h2>Derzeit keine deutschen Anzeigen verfügbar</h2>
          <p>Es wird kein russischer Inhalt als deutsche Übersetzung ausgegeben.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
