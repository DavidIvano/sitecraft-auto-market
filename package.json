{
  "name": "sitecraft-auto-market",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dev": "astro dev",
    "build": "astro build && node scripts/prepare-cloudflare-pages.mjs",
    "build:astro": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:upload": "node --experimental-strip-types --test tests/upload-listing-images.test.ts",
