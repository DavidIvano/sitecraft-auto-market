    "deal-finder:analyze": "node scripts/deal-finder-analyze-listings.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.4",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.112.0"
