{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SiteCraft bounded localized SEO taxonomy page",
  "type": "object",
  "required": ["facet", "items", "pagination", "related_groups"],
  "additionalProperties": false,
  "properties": {
    "facet": {
      "type": "object",
      "required": ["type", "slug", "label", "total", "ready_locales"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["brand", "model", "city", "region", "fuel", "body", "price"] },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100 },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "parent_slug": { "type": ["string", "null"], "maxLength": 100 },
        "parent_label": { "type": ["string", "null"], "maxLength": 120 },
        "region_slug": { "type": ["string", "null"], "maxLength": 100 },
        "region_label": { "type": ["string", "null"], "maxLength": 120 },
        "code": { "type": ["string", "null"], "maxLength": 100 },
        "total": { "type": "integer", "minimum": 1 },
        "lastmod": { "type": ["string", "null"], "format": "date-time" },
        "ready_locales": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 35,
          "items": { "type": "string", "maxLength": 35 }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/publicCard" }
    },
    "pagination": {
      "type": "object",
      "required": ["page", "limit", "total", "total_pages"],
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 24 },
        "total": { "type": "integer", "minimum": 1 },
        "total_pages": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "related_groups": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["type", "items"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["brand", "model", "city", "region", "fuel", "body", "price"] },
          "items": {
            "type": "array",
            "maxItems": 8,
            "items": { "$ref": "#/$defs/facetSummary" }
          }
        }
      }
    }
  },
  "$defs": {
    "facetSummary": {
      "type": "object",
      "required": ["type", "slug", "label", "count"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["brand", "model", "city", "region", "fuel", "body", "price"] },
        "slug": { "type": "string", "maxLength": 100 },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "parent_slug": { "type": ["string", "null"], "maxLength": 100 },
        "region_slug": { "type": ["string", "null"], "maxLength": 100 },
        "code": { "type": ["string", "null"], "maxLength": 100 },
        "count": { "type": "integer", "minimum": 1 },
        "ready_locales": { "type": "array", "maxItems": 35, "items": { "type": "string", "maxLength": 35 } },
        "lastmod": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "publicCard": {
      "type": "object",
      "required": ["id", "slug", "title", "brand", "model", "year", "price", "currency", "status"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 120 },
        "title": { "type": "string", "minLength": 1 },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "year": { "type": "integer" },
        "price": { "type": "number", "minimum": 0 },
        "currency": { "type": "string" },
        "status": { "enum": ["approved", "published", "sold"] }
      }
    }
  }
}
