{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SiteCraft Programmatic SEO Stage 3 public contracts",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "catalog": { "$ref": "#/$defs/catalog" },
    "manifest": { "$ref": "#/$defs/manifest" },
    "listingShard": { "$ref": "#/$defs/listingShard" }
  },
  "$defs": {
    "pagination24": {
      "type": "object",
      "required": ["page", "limit", "total", "total_pages"],
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 24 },
        "total": { "type": "integer", "minimum": 0 },
        "total_pages": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "publicCard": {
      "type": "object",
      "required": ["id", "slug", "title", "brand", "model", "year", "price", "currency", "status"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 120 },
        "title": { "type": "string", "minLength": 1 },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "year": { "type": "integer" },
        "price": { "type": "number", "minimum": 0 },
        "currency": { "type": "string" },
        "status": { "enum": ["approved", "published", "sold"] }
      }
    },
    "catalog": {
      "type": "object",
      "required": ["items", "pagination", "ready_locales", "related_groups"],
      "additionalProperties": false,
      "properties": {
        "items": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/publicCard" } },
        "pagination": { "$ref": "#/$defs/pagination24" },
        "ready_locales": { "type": "array", "uniqueItems": true, "maxItems": 35, "items": { "type": "string", "maxLength": 35 } },
        "related_groups": { "type": "array", "maxItems": 7 }
      }
    },
    "manifestLocale": {
      "type": "object",
      "required": ["locale", "generation", "listing_total", "shard_size", "shard_count", "lastmod"],
      "additionalProperties": false,
      "properties": {
        "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
        "generation": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" },
        "listing_total": { "type": "integer", "minimum": 0 },
        "shard_size": { "const": 10000 },
        "shard_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "lastmod": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "manifest": {
      "type": "object",
      "required": ["generated_at", "locales"],
      "additionalProperties": false,
      "properties": {
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "locales": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/manifestLocale" } }
      }
    },
    "listingShard": {
      "type": "object",
      "required": ["locale", "generation", "items", "pagination"],
      "additionalProperties": false,
      "properties": {
        "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
        "generation": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" },
        "items": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "required": ["slug", "lastmod"],
            "additionalProperties": false,
            "properties": {
              "slug": { "type": "string", "minLength": 1, "maxLength": 120 },
              "lastmod": { "type": ["string", "null"], "format": "date-time" }
            }
          }
        },
        "pagination": {
          "type": "object",
          "required": ["page", "limit", "total", "total_pages"],
          "additionalProperties": false,
          "properties": {
            "page": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "limit": { "const": 10000 },
            "total": { "type": "integer", "minimum": 0 },
            "total_pages": { "type": "integer", "minimum": 1, "maximum": 10000 }
          }
        }
      }
    }
  }
}
