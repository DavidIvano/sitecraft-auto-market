PUBLIC_XANO_API_URL=https://your-xano-api-url.com/api:YOUR_GROUP
# Production uses only the bounded authoritative SEO contracts.
PUBLIC_SEO_TAXONOMY_API_ENABLED=true
# Removed from the production path: a failed bounded read must fail closed.
PUBLIC_SEO_TAXONOMY_COMPATIBILITY_FALLBACK_ENABLED=false
PUBLIC_SEO_CATALOG_API_ENABLED=true
PUBLIC_SEO_CATALOG_COMPATIBILITY_FALLBACK_ENABLED=false
PUBLIC_SEO_SITEMAP_SHARDS_ENABLED=true
PUBLIC_SEO_SITEMAP_COMPATIBILITY_FALLBACK_ENABLED=false
PUBLIC_XANO_AUTH_API_URL=https://your-xano-api-url.com/api:YOUR_AUTH_GROUP
PUBLIC_SITE_URL=https://automarket.sitecraft.agency
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://automarket.sitecraft.agency/
# Server-only JSON credential. Add its client_email as a read-only user of the
# Search Console property before enabling API metrics. Never commit the value.
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=
PUBLIC_XANO_GOOGLE_AUTH_START_PATH=/oauth/google/init
PUBLIC_XANO_GOOGLE_AUTH_CONTINUE_PATH=/oauth/google/continue
PUBLIC_IMAGE_UPLOAD_URL=/api/upload-listing-images
PUBLIC_USE_AI_LISTING_ENDPOINTS=true

# Safety switch for the old Xano endpoint POST /ai/generate-listing.
# Keep this false unless that endpoint creates only an editable draft and never sends
# a listing to moderation automatically.
PUBLIC_ALLOW_LEGACY_AI_GENERATE=false

# Closed internal Deal Finder module. Keep disabled until Xano tables/endpoints and
# role access have been configured.
PUBLIC_DEAL_FINDER_ENABLED=true
PUBLIC_DEAL_FINDER_USE_MOCK_DATA=false
PUBLIC_DEAL_FINDER_WORKSPACE_API_ENABLED=false
DEAL_FINDER_INTERNAL_SECRET=
DEAL_FINDER_IMAGE_MODE=external
DEAL_FINDER_MIN_SCORE=70
DEAL_FINDER_HOT_SCORE=80
DEAL_FINDER_TEST_ENDPOINT_ENABLED=false
DEAL_FINDER_SYNC_ENABLED=false
DEAL_FINDER_MANUAL_SYNC_ENABLED=false
DEAL_FINDER_MANUAL_AI_ENABLED=false
DEAL_FINDER_SYNC_INTERVAL_MINUTES=60
DEAL_FINDER_MAX_SEARCHES_PER_RUN=1
DEAL_FINDER_MAX_SEARCH_RESULTS_PER_RUN=100
DEAL_FINDER_MAX_DETAILS_PER_RUN=4
DEAL_FINDER_MAX_AI_ANALYSES_PER_SYNC=0
DEAL_FINDER_OPENAI_MODEL=gpt-5.6-luna
DEAL_FINDER_MAX_AI_ANALYSES_PER_RUN=1
DEAL_FINDER_AI_ENABLED=true
DEAL_FINDER_AI_DRY_RUN=false
DEAL_FINDER_AI_TIMEOUT_MS=30000
DEAL_FINDER_HTTP_TIMEOUT_MS=15000
DEAL_FINDER_DRY_RUN=true
PUBLIC_DEAL_FINDER_STAGE3_API_ENABLED=true

# Multilingual rollout kill switches. Public locales are selected in
# src/i18n/config.ts; do not add one environment variable per language.
I18N_ENABLED=false
I18N_API_READ_ENABLED=false
I18N_ADMIN_TEST_LOCALE_AWARE_READ_ENABLED=false
I18N_DUAL_WRITE_ENABLED=false
I18N_PUBLIC_ROUTES_ENABLED=false
I18N_AI_TRANSLATION_ENABLED=false

# Worker-only incoming trigger credential. Never expose as PUBLIC_ and never reuse
# XANO_DEAL_FINDER_INGEST_SECRET for this purpose.
DEAL_FINDER_WORKER_TRIGGER_SECRET=

# Xano Environment Variables, not frontend variables:
# OPENAI_API_KEY=
# OPENAI_BEARER_TOKEN=Bearer sk-...
# OPENAI_DEFAULT_MODEL=gpt-5.6-luna
# OPENAI_LISTING_MODEL=gpt-5.6-luna
# OPENAI_SEARCH_MODEL=gpt-5.6-luna
# OPENAI_MODERATION_MODEL=gpt-5.6-luna
# OPENAI_DEAL_FINDER_MODEL=gpt-5.6-luna
# OPENAI_TRANSLATION_MODEL=gpt-5.6-luna
# AI_MAX_PHOTOS=4
# AI_MAX_PHOTO_BYTES=8388608
# AI_MIN_CONFIDENCE=0.72

# Cloudflare Pages server-only upload configuration.
XANO_API_URL=https://your-xano-api-url.com/api:YOUR_GROUP
R2_PUBLIC_BASE_URL=https://sitecraft-auto-market.pages.dev/api/r2-images
ALLOWED_UPLOAD_ORIGINS=https://sitecraft-auto-market.pages.dev,https://automarket.sitecraft.agency,http://localhost:4321,http://127.0.0.1:4321,http://localhost:4322,http://127.0.0.1:4322
ENVIRONMENT=development

# R2_BUCKET is a Cloudflare binding (configured in wrangler.toml / Pages), not an env value.
# The bucket name is deployment metadata only and is not consumed by runtime code.
# R2_BUCKET_NAME=car-images

# Optional only if you choose S3-compatible R2 access outside Pages Functions.
# Do not expose these as PUBLIC_* variables.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
